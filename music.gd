	# ⑤ 特殊时刻：乐句**取代**旋律，但低音床必须还在（与 ㉚ 的排除口径互补）。
	var n_cue44 := 0
	for e44c in _schedule_step(k44p, ax44, "capture"):
		if str(e44c["kind"]) == "bass":
			n_cue44 += 1
	if n_cue44 != 1:
		bad46.append("cue 乐句把低音床吃掉了（应仍 1 个，实 %d）" % n_cue44)
	# ⑥ 分族：低音不吃韵、不与 `note` 撞缓存键；`note` 那一档是阳性对照。
	# ★ 必须拿**真实调度产出的那个低音事件**（kind + midi）来量，不能写死 "bass"
	#   字面量：否则有人把 `_schedule_step()` 的 kind 改回 "note" 时，这一面会静默
	#   恒真（量的对象与被改的对象分家了）。① 那时也会红，但红的理由是「少了一个
	#   bass」而不是「低音被加韵了」⇒ 指错地方（同 ㉞ 的教训）。
	var ev_bass44: Dictionary = {}
	for e44z in _schedule_step(k44p, ax44):
		if str(e44z["kind"]) == "bass":
			ev_bass44 = e44z
			break
	if ev_bass44.is_empty():
		bad46.append("分族面没有真实低音事件可量（分母 0）")
	var m44 := int(ev_bass44.get("midi", 62))
	var kd44 := str(ev_bass44.get("kind", "bass"))
	var m44c := 62   # 阳性对照固定音：62 在 yun_ratio=1 下一定落在上滑形态里
	yun_enabled = true
	yun_ratio = 1.0
	yun_slide = 1.0
	yun_vibrato = 1.0
	var vb44 := voice_pcm(m44, kd44, 0.0)
	var ib44 := instr_pcm(m44, kd44, "")
	var vn44 := voice_pcm(m44c, "note", 0.0)
	var inn44 := instr_pcm(m44c, "note", "")
	yun_enabled = y_keep44
	yun_ratio = yr_keep44
	yun_slide = ys_keep44
	yun_vibrato = yv_keep44
	var same_b44 := vb44.size() == ib44.size() and vb44.size() > 0
	if same_b44:
		for i44v in vb44.size():
			if vb44[i44v] != ib44[i44v]:
				same_b44 = false
				break
	var diff_n44 := 0
	if vn44.size() != inn44.size():
		diff_n44 = 1
	else:
		for i44w in mini(vn44.size(), 4096):
			if vn44[i44w] != inn44[i44w]:
				diff_n44 += 1
	if not same_b44:
		bad46.append("bass 被「韵」改了波形（低音不该带滑音/揉弦）")
	if diff_n44 <= 0:
		bad46.append("阳性对照失效：note 没被韵改动 ⇒ 上一条是恒真式")
	if _wav_key(m44, kd44, 0.0, "") == _wav_key(m44, "note", 0.0, ""):
		bad46.append("低音与 note 撞缓存键")
	# ⑦ 低音「浑厚悠长」（11-05 第六轮）：独立时长/亮度 + 两旋钮都有牙 + 都进指纹。
	#   ★★ 与第五轮 `dyn_*` 恰好相反：这两个量改的是**波形本身**（KS 的时长与激励亮度），
	#     不进 `_timbre_fp()` 就是「运行期拧旋钮没反应」的静默缺陷（§33）。两面阴性对照。
	var bsec_keep44 := bass_seconds
	var bbri_keep44 := bass_bright
	# ★★ 11-05 第六轮修（A/B 基线档逼出来的）：这两个是**旋钮**，合法区间允许拨回
	#   旋律口径（`--basssec=2.9 --bassbright=0.62` 正是本轮 A/B 的 0 档）。把
	#   「更长/更暗」写成绝对约束 ⇒ 拧到合法值就红 ⇒ 旋钮被判据锁死，是噪声（§136/§33）。
	#   ⇒ 与 ㊲ 同口径：**显式拨到设计基准**再验设计意图，量完还原，并打印进来时档位；
	#     后面的「旋钮接上/指纹」两面仍在**真实档位**上量，不跟着设计档走。
	bass_seconds = 3.40
	bass_bright = 0.45
	var sec_bass44 := _seconds_for_kind("bass")
	var sec_note44 := _seconds_for_kind("note")
	var bri_bass44 := _bright_for_kind("bass")
	var bri_note44 := _bright_for_kind("note")
	if sec_bass44 <= sec_note44:
		bad46.append("设计档低音余音不长于旋律（浑厚悠长没做到）")
	if bri_bass44 >= bri_note44:
		bad46.append("设计档低音不比旋律暗")
	bass_seconds = bsec_keep44
	bass_bright = bbri_keep44
	var pcm_bass44 := voice_pcm(m44, kd44, 0.0)
	bass_seconds = 6.0
	var pcm_long44 := voice_pcm(m44, kd44, 0.0)
	bass_seconds = bsec_keep44
	if pcm_long44.size() <= pcm_bass44.size():
		bad46.append("bass_seconds 没接上（采样数没变长）")
	bass_bright = 0.05
	var pcm_dark44 := voice_pcm(m44, kd44, 0.0)
	bass_bright = bbri_keep44
	var diff_b44 := 0
	if pcm_dark44.size() != pcm_bass44.size():
		diff_b44 = 1
	else:
		for i44x in mini(pcm_bass44.size(), 4096):
			if pcm_dark44[i44x] != pcm_bass44[i44x]:
