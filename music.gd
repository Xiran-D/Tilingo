	var fp44 := _timbre_fp()
	bass_seconds = 6.0
	var fp_s44 := _timbre_fp()
	bass_seconds = bsec_keep44
	bass_bright = 0.05
	var fp_b44 := _timbre_fp()
	bass_bright = bbri_keep44
	if fp_s44 == fp44 or fp_b44 == fp44:
		bad46.append("bass_seconds/bass_bright 没进 _timbre_fp（运行期拧旋钮不失效缓存）")
	# ★★ 必须还原总闸：本判据内部为了 A/B 把它强制打开过，`--bass=0` 那一档进来时
	#   是关的。不还原 ⇒ 自检跑完 `bass_enabled` 静默变成 true（§8 状态一处写一处读）。
	#   与 ㊲ 同一口径：判据验的是「如果开了对不对」，所以显式打印进来时的档位。
	bass_enabled = be_keep44
	checks.append(["㊻ 古筝·低音勾托｜4 小节每小节恰好 1 个 `bass` 且关闸后非低音事件逐字不变｜音高 = 本小节 arp 首音 + 12×bass_octave(两档 hue × 4 小节，根音须不唯一)｜octave/step/gain 三旋钮各自有牙｜cue 取代后低音仍在｜bass 不吃「韵」、不与 note 撞缓存键(带 note 阳性对照)｜余音长于旋律且更暗、两旋钮各自有牙且都进 `_timbre_fp()`",
		bad46.is_empty(),
		"进来时 bass=%s · 开/关低音 %d/%d 个 · 非低音事件逐字相同=%s · 根音 %d 种 / %d 个配对 · octave %d→%d（期望 %+d）· step 旧位 %d 新位 %d · gain %.3f→%.3f · cue 步低音 %d · bass 不加韵=%s / note 阳性对照 %d 个采样不同 · 进来时 basssec=%.2f/bright=%.2f · 设计档余音 %.2fs / %.2fs · 亮度 %.2f / %.2f · 旋钮：长度 %d→%d 采样、暗档 %d 个采样不同、指纹 %s/%s · %s" % [
			str(be_keep44), on_n44, off_n44, str(str(on_other44) == str(off_other44)),
			uniq44.size(), n_pair44, m44_def, m44_new, oct_delta44,
			n_old44, n_new44, g44_old, g44_new, n_cue44,
			str(same_b44), diff_n44,
			bsec_keep44, bbri_keep44, sec_bass44, sec_note44, bri_bass44, bri_note44,
			pcm_bass44.size(), pcm_long44.size(), diff_b44,
			str(fp_s44 != fp44), str(fp_b44 != fp44),
			"全部通过" if bad46.is_empty() else str(bad46)]])

	# ㊼ 古筝·乐句呼吸（2026-11-05 第五轮）。
	#   ★ 为什么单独一条：这一层只给事件**加一个字段**，不改波形、不改事件条数 ⇒
	#     所有按 kind/midi/at 的历史判据都看不见它。§127：判据要量真实入口 + 可观测
	#     结果、正负成对；§106：有效分母 0 须报红。
	#   ★ 六个面：① 关档逐字退化（且滤掉 vel 后事件集必须与关档相同 ⇒ 力度层不许
	#     偷偷改「发什么音」）② 上行/下行两面都有分母、幅度不越界 ③ 力度**方向**
	#     与句内位移同号（读 `_recent_melody_first()` 这个真源对拍，不重实现逻辑）
	#     ④ `dyn_slope` 归零/拉满两头有牙 ⑤ `dyn_lookback` 不是死参数
	#     ⑥ `_event_gain()` 乘上 vel 且无 vel 时退化，离线渲染 RMS 开/关真的不同。
	var de_keep47 := dyn_enabled
	var ds_keep47 := dyn_slope
	var dl_keep47 := dyn_lookback
	var bad47: Array[String] = []
	var ax47 := axes_from_tension(0.6)
	var spb47 := _steps_per_bar()
	var n47_steps := 6 * spb47
	var gs47 := maxf(_fnum(ax47.get("gain_scale", 1.0), 1.0), 0.0)
	# ① 关档 vs 开档
	dyn_enabled = false
	var off47: Array[String] = []
	for k47a in range(0, n47_steps):
		for e47a in _schedule_step(k47a, ax47):
			if e47a.has("vel"):
				bad47.append("关档仍带 vel")
			off47.append(str(e47a))
	dyn_enabled = true
	var on47: Array[String] = []
	var vels47: Array[float] = []
	var pairs47: Array = []          # [midi, vel, k]，只收旋律主音
	for k47b in range(0, n47_steps):
		for e47b in _schedule_step(k47b, ax47):
			if e47b.has("vel"):
				vels47.append(float(e47b["vel"]))
				# ★ 装饰音 (orn) 的 midi 不代表本句旋律走向 ⇒ 方向对拍只看主音
				if str(e47b["kind"]) == "note" and float(e47b["gain"]) > 0.30 * gs47:
					pairs47.append([int(e47b["midi"]), float(e47b["vel"]), k47b])
			var cp47: Dictionary = e47b.duplicate()
			cp47.erase("vel")
			on47.append(str(cp47))
	if str(on47) != str(off47):
		bad47.append("力度层改动了事件本身（不只加 vel 字段）")
	# ② 双向分母 + 幅度界
	var n_up47 := 0
	var n_dn47 := 0
	var vmax47 := 0.0
	var vmin47 := 9.9
	for v47 in vels47:
		if v47 > 1.0 + 1e-6:
			n_up47 += 1
		elif v47 < 1.0 - 1e-6:
			n_dn47 += 1
		vmax47 = maxf(vmax47, v47)
		vmin47 = minf(vmin47, v47)
	if vels47.size() < 8:
		bad47.append("带 vel 的事件只有 %d 个（分母 0）" % vels47.size())
	if n_up47 == 0 or n_dn47 == 0:
		bad47.append("只有单向力度（上行 %d / 下行 %d）" % [n_up47, n_dn47])
	if vmax47 > 1.0 + ds_keep47 + 1e-6 or vmin47 < 1.0 - ds_keep47 - 1e-6:
		bad47.append("力度越界 %.3f~%.3f" % [vmin47, vmax47])
	# ③ 方向对拍（有效分母：开头几步没有句首，跳过是允许的，但至少要量到几条）
	var dir_n47 := 0
	var dir_bad47 := 0
	for p47 in pairs47:
		var first47 := _recent_melody_first(int(p47[2]), ax47, gs47, clampi(dl_keep47, 1, 6))
		if first47 < 0:
			continue
		dir_n47 += 1
		var d47 := int(p47[0]) - first47
		var vv47 := float(p47[1])
		if d47 > 0 and vv47 < 1.0 - 1e-6:
			dir_bad47 += 1
		elif d47 < 0 and vv47 > 1.0 + 1e-6:
			dir_bad47 += 1
		elif d47 == 0 and absf(vv47 - 1.0) > 1e-6:
			dir_bad47 += 1
	if dir_n47 < 4:
		bad47.append("方向对拍只有 %d 个有效样本（分母 0）" % dir_n47)
	if dir_bad47 > 0:
		bad47.append("力度方向与句内位移相反 %d 处" % dir_bad47)
	# ④ dyn_slope 两头有牙
	dyn_slope = 0.0
	var flat47 := true
	for k47c in range(0, n47_steps):
		for e47c in _schedule_step(k47c, ax47):
			if e47c.has("vel") and absf(float(e47c["vel"]) - 1.0) > 1e-6:
				flat47 = false
	dyn_slope = 0.6
	var wide47 := 0.0
	for k47d in range(0, n47_steps):
		for e47d in _schedule_step(k47d, ax47):
			if e47d.has("vel"):
				wide47 = maxf(wide47, absf(float(e47d["vel"]) - 1.0))
	dyn_slope = ds_keep47
	var base47 := maxf(vmax47 - 1.0, 1.0 - vmin47)
	if not flat47:
		bad47.append("dyn_slope=0 时力度仍不恒定")
	if not (wide47 > base47 + 1e-6):
		bad47.append("dyn_slope 拉满没让幅度变大（%.3f→%.3f）" % [base47, wide47])
	# ⑤ dyn_lookback 不是死参数
	dyn_lookback = 1 if dl_keep47 != 1 else 6
	var alt47: Array[String] = []
	for k47e in range(0, n47_steps):
		for e47e in _schedule_step(k47e, ax47):
			if e47e.has("vel"):
				alt47.append("%.6f" % float(e47e["vel"]))
	dyn_lookback = dl_keep47
	var cur47: Array[String] = []
	for v47b in vels47:
		cur47.append("%.6f" % v47b)
	if str(alt47) == str(cur47):
		bad47.append("dyn_lookback 拧不动（窗口是死参数）")
	# ⑥ 最终增益单一真源 + 离线渲染真的读了 vel
	if absf(_event_gain({"gain": 0.46, "vel": 1.2}) - 0.46 * 1.2) > 1e-6:
		bad47.append("_event_gain 没把 vel 乘进去")
	if absf(_event_gain({"gain": 0.46}) - 0.46) > 1e-6:
		bad47.append("无 vel 时 _event_gain 没退化")
	var pcm_on47 := render_offline(2.0, 0.6, {})
	dyn_enabled = false
	var pcm_off47 := render_offline(2.0, 0.6, {})
	dyn_enabled = true
	var r_on47 := _rms(pcm_on47, 0.0, 2.0)
	var r_off47 := _rms(pcm_off47, 0.0, 2.0)
	if r_on47 <= 0.0 or r_off47 <= 0.0 or absf(r_on47 - r_off47) < 1e-5:
		bad47.append("离线渲染没读到 vel（开/关 RMS %.5f / %.5f）" % [r_on47, r_off47])
	dyn_enabled = de_keep47
	dyn_slope = ds_keep47
	dyn_lookback = dl_keep47
	checks.append(["㊼ 古筝·乐句呼吸｜关档事件逐字退化且滤掉 vel 后与关档相同=力度层不许改发什么音｜上行/下行两面都有分母·幅度不越界｜力度方向与句内位移同号｜dyn_slope 归零/拉满两头有牙｜dyn_lookback 不是死参数｜`_event_gain()` 单一真源 + 离线渲染 RMS 开/关真的不同",
		bad47.is_empty(),
		"进来时 dyn=%s · 带 vel 事件 %d 个 · 上行 %d / 下行 %d · 力度 %.3f~%.3f · 方向对拍 %d 条（反向 %d）· slope 幅度 %.3f→%.3f · lookback 改窗 vel 序列变化=%s · 离线 RMS 开/关 %.5f / %.5f · %s" % [
			str(de_keep47), vels47.size(), n_up47, n_dn47, vmin47, vmax47,
			dir_n47, dir_bad47, base47, wide47, str(str(alt47) != str(cur47)),
			r_on47, r_off47, "全部通过" if bad47.is_empty() else str(bad47)]])

	# ㊽ 古筝·弦区音色（2026-11-05 第七轮）。
	#   ★ 为什么单独一条：㉞ 只守「69 逐位等于 pluck_pcm」，韵/低音/力度各管各的；
	#     「其它音高按弦区变亮变暗」没有任何老判据覆盖 ⇒ 方向反了、忘了进指纹、
	#     把 bass 一起改了，全都静默通过。
	#   ★ 读真源 `_bright_for_kind()` / `_zone_u()` / `_timbre_fp()`，不重实现折算（§70）。
	#   ★ 「低暗高亮」是**设计档**关系，不是任意合法档的绝对约束（§136）：
	#     `--zonebright=0` 是合法 A/B 0 档，写死会把旋钮锁死 ⇒ 显式拨设计基准验、量完还原。
	var bad48: Array[String] = []
	var ze_keep48 := zone_enabled
	var zsp_keep48 := zone_span
	var zbr_keep48 := zone_bright
	var zls_keep48 := zone_low_soft
	var zd_keep48 := zone_decay
	var yun_keep48 := yun_enabled
	var ins_keep48 := instrument_id
	instrument_id = "guzheng"
	yun_enabled = false          # 同 ㉞：量的是激励亮度，不是按滑重采样
	zone_enabled = true
	zone_span = 24.0
	zone_bright = 0.40
	zone_low_soft = 0.60
	## ★ 11-05 第九轮：本条只管**亮度轴**。量时把余音轴钉在关档，
	##   否则「采样数不变」这条旧契约会被 ㊾ 的新功能推翻、红得指错地方（同 ㉞ 钉乐器）。
	##   余音轴由 ㊾ 单独验；量完还原，每一档仍真在量亮度。
	zone_decay = 0.0
	var b48_base := _bright_for_kind("note", -1)
	var b48_lo := _bright_for_kind("note", 45)
	var b48_mid := _bright_for_kind("note", 69)
	var b48_hi := _bright_for_kind("note", 93)
	# ① 中性点严格不改亮度（㉞ / 单音锚 61043c95 的结构保证）
	if not is_equal_approx(b48_mid, b48_base):
		bad48.append("中性点 69 亮度改了（%.4f vs %.4f）" % [b48_mid, b48_base])
	# ② 设计档方向 + ③ u 必须有正负分母（否则整条是空真）
	if not (b48_lo < b48_mid and b48_mid < b48_hi):
		bad48.append("设计档没做到低暗高亮（%.3f/%.3f/%.3f）" % [b48_lo, b48_mid, b48_hi])
	if _zone_u(45) >= 0.0 or _zone_u(93) <= 0.0 or not is_equal_approx(_zone_u(69), 0.0):
		bad48.append("跨度/中性点没接上（u45=%.2f u69=%.2f u93=%.2f）"
			% [_zone_u(45), _zone_u(69), _zone_u(93)])
	# ④ 波形真变但不改采样数（T60 不许碰），中性点逐位相同
	var raw48_lo := pluck_pcm(midi_to_freq(45), note_seconds, b48_base)
	var zon48_lo := voice_pcm(45, "note", 0.0)
	var raw48_hi := pluck_pcm(midi_to_freq(93), note_seconds, b48_base)
	var zon48_hi := voice_pcm(93, "note", 0.0)
	var raw48_mid := pluck_pcm(midi_to_freq(69), note_seconds, b48_base)
	var zon48_mid := voice_pcm(69, "note", 0.0)
	var dif48_lo := false
	var dif48_hi := false
	var same48_mid := raw48_mid.size() == zon48_mid.size() and raw48_mid.size() > 0
	if raw48_lo.size() != zon48_lo.size() or raw48_hi.size() != zon48_hi.size():
		bad48.append("弦区折算改了采样数（不该碰 T60）")
	for i48a in mini(raw48_lo.size(), zon48_lo.size()):
		if raw48_lo[i48a] != zon48_lo[i48a]:
			dif48_lo = true
			break
	for i48b in mini(raw48_hi.size(), zon48_hi.size()):
		if raw48_hi[i48b] != zon48_hi[i48b]:
			dif48_hi = true
			break
	if same48_mid:
		for i48c in raw48_mid.size():
			if raw48_mid[i48c] != zon48_mid[i48c]:
				same48_mid = false
				break
	if not (dif48_lo and dif48_hi):
		bad48.append("两端波形没变（低=%s 高=%s）" % [str(dif48_lo), str(dif48_hi)])
	if not same48_mid:
		bad48.append("中性点波形不是逐位不变（㉞ 会假红）")
	# ⑤ 只作用 note：其它音族传 midi 也必须逐位退回旧口径
	for kd48 in ["bass", "arp", "tick", "orn", "pad"]:
		if not is_equal_approx(_bright_for_kind(kd48, 45), _bright_for_kind(kd48, -1)):
