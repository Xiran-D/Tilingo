			"全部通过" if bad50.is_empty() else str(bad50)]])

	sample_rate = sr_keep
	_wav_cache.clear()
	return checks


## 判据用仪表：把能量的「谐波上 / 谐波之间」两份分开，返回后者占比。
##
## ★ 为什么用 Goertzel 逐点探而不是 FFT：GDScript 里没有现成 FFT，而这里只需要一个
##   **比值**，不需要完整谱。探 100~4000Hz、40Hz 一格。
## ★ 为什么格距取 40Hz：要同时满足两件事 —— 比谐波间距细得多（220Hz 基频时），
##   又不至于被揉弦频偏糊掉（±0.5% ⇒ 第 12 谐波 ±13Hz）。取 10Hz 反而会把
##   抖动的谐波能量漏进"之间"那一份 ⇒ 假红。
func _an_interharm_ratio(pcm: PackedFloat32Array, sr: int, f0: float) -> float:
	if pcm.size() < 2048 or f0 < 40.0 or sr < 8000:
		return -1.0
	var n := mini(pcm.size(), 8192)
	var st := int(float(pcm.size() - n) * 0.5)
	var on_e := 0.0
	var off_e := 0.0
	var f := 100.0
	while f < 4000.0:
		var w := TAU * f / float(sr)
		var c := 2.0 * cos(w)
		var s1 := 0.0
		var s2 := 0.0
		for i in n:
			var s0 := pcm[st + i] + c * s1 - s2
			s2 = s1
			s1 = s0
		var pw := maxf(s1 * s1 + s2 * s2 - c * s1 * s2, 0.0)
		var hm := f / f0
		if absf(hm - round(hm)) * f0 < 0.2 * f0:
			on_e += pw
		else:
			off_e += pw
		f += 40.0
	return off_e / maxf(on_e, 1.0e-12)
