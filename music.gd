	#      **钟永远不响**，而调度、日志、事件表全都对
	#   ⑤ 空/非法钟 id ⇒ 该段**不出声**，且**不许退回主乐器**（退回就是"钟变成古筝"，
	#      听感上像"设置没生效"）
	var ins_keep43 := instrument_id
	var be_keep43 := cue_bell_enabled
	var bi_keep43 := cue_bell_instrument
	var bg_keep43 := cue_bell_gain
	var ss_keep43 := stagger_scale
	var bad43: Array[String] = []
