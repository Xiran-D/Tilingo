	# ㊳ 乐器验收件（只在显式请求时才是判据）：`--musicinstrdump=<目录>`。
	# ★ 会红的理由与 ⑭ / ㉟ 同一条：这九个 wav 是"九件民族乐器到底像不像"唯一的可听证据源，
	#   悄悄写失败会让「没验」看起来和「验过了」一模一样。
	# ★★ 分母是 `INSTR_IDS.size()`（不是写死 9）：加乐器自动进分母，不会出现
	#   "加了第十件但判据只验前九件"这种静默漏检。有效性也判：每件都得非静音（RMS > 0.001）——
	#   一个写成功的**空** wav 和不写一样没用。
	# ★★ 2026-10-29 加了**音准**这一面（三个孤立音的音分偏差，界 50 音分）：三个 STK 移植族
	#   的延迟长度是按"环路总长 = sr/f"反解的，写错一个分母就是整件乐器差八度，
	#   而"差八度"听感上像"音色亮"，不会让人想到去查音准 ⇒ 必须有数盯着。
	var ins_dir := _arg_value("--musicinstrdump=")
	if ins_dir != "":
		var demo_i := render_instrument_demo(ins_dir, 2.6)
		var bad_i: Array[String] = []
		var ms_max := 0
		var cents_max := 0.0
		var ms_txt := ""
		for id in INSTR_IDS:
			var sid := String(id)
			var d: Dictionary = demo_i.get(sid, {})
			var ok_i: bool = bool(d.get("wrote", false)) and int(d.get("size", 0)) > 0 \
				and float(d.get("rms", 0.0)) > 0.001 and absf(float(d.get("cents", 0.0))) <= 50.0
			if not ok_i:
				bad_i.append("%s(写%s/RMS%.4f/音准%.0f¢)" % [sid,
					str(d.get("wrote", false)), float(d.get("rms", 0.0)),
					float(d.get("cents", 0.0))])
			ms_max = maxi(ms_max, int(d.get("ms", 0)))
			cents_max = maxf(cents_max, absf(float(d.get("cents", 0.0))))
			ms_txt += "%s:%dms " % [sid, int(d.get("ms", 0))]
		checks.append(["㊳ 乐器验收件｜%d 件民族乐器各落一段 wav · 都非静音 · 音准偏差 ≤ 50 音分"
				% INSTR_IDS.size(),
			bad_i.is_empty(),
			"%s · 落盘 %d 件 · 坏件 %s · 最差音准 %.0f 音分 · 单件最慢 %d ms｜%s" % [
				ins_dir, demo_i.size(), str(bad_i), cents_max, ms_max, ms_txt]])
	else:
		print("[Music] 未请求 --musicinstrdump=<目录>（跳过乐器验收件）")

	# ⑮ 拨弦**无直流**（编号是追加序号，位置在末尾只是为了不动前面已对好的编号）。
	# ★ 这是会红的：修之前 880Hz 音的尾段 |直流|/RMS = 0.9998 —— 尾巴就是一整根直流台阶，
	#   听感是"闷响"，根本没有音高。根因是环形延迟线的 k=0 模态（见 pluck_pcm）。
	# ★★ 必须**同时**量一个高音。直流模态相对基频的增益优势**随音高上升而变大**
	#    ——环路低通在基频处的损失是 cos(pi/trip)，trip = nn+0.5 越小损失越大。
	#    实测（只扣激励均值、**不加**环路直流阻塞时）：
	#      440Hz 音的尾段 |直流|/RMS = 0.078（**绿**，看不出问题）
	#      880Hz 音的尾段 |直流|/RMS = 0.9988（红）
	#    ⇒ 只量 440Hz 会让这条判据**恰好落在看不见缺陷的那一档**
	#      （阴性对照 K5"去掉直流阻塞"当场 0 条红线才发现）。
	var dc_head := _dc_ratio(pcm_long, 0.0, 0.25)
	var dc_tail := _dc_ratio(pcm_long, 0.75, 1.0)
	var dc_hi := _dc_ratio(pluck_pcm(880.0, 1.2, brightness), 0.75, 1.0)
	checks.append(["⑮ 拨弦无直流｜440Hz 首/尾段与 880Hz 尾段的 |直流|/RMS 都必须 < 0.25",
		dc_head < 0.25 and dc_tail < 0.25 and dc_hi < 0.25,
		"440首 %.4f · 440尾 %.4f · 880尾 %.4f" % [dc_head, dc_tail, dc_hi]])

	# ⑯ 余音**衰减速率**（"damp 漏 trip"那把刀的闸门）。口径是**比值**，不是估 T60 数字：
	#   [0.50,0.70] 窗与 [0.10,0.30] 窗的**去直流** RMS 之比 ≤ 0.25
	#   （1.2s 的渲染件里两窗相隔 0.48s ⇒ 至少降 12dB ⇒ 余音 ≤ 请求的 2 倍），且 ≥ 1e-4（不是瞬死）。
	# ★ 为什么放弃"估一个 T60 数字"：
	#   · 锁"实测基频那个分音"对**高音**不成立 —— 880Hz 的基频分音在尾段掉到 16bit 量化
	#     地板以下（实测幅度 2.24e-05 → 0.0）；
	#   · 用"整带"估 T60 又被**高次谐波**带偏（拨弦音高次谐波本来就衰减更快，那是物理，
	#     不是缺陷）⇒ 修好之后 880Hz 读 0.41×，落在任何"合理"区间之外。
	#   比值口径两边都能咬：实测**修前** 146.8Hz→0.97、440Hz→0.81（红），
	#   **修后** 0.034 / 0.025 / 0.0011（三音全过，最小余量 7 倍）。
	# ★ 诚实记一笔：880Hz 那格对这把刀不敏感（修前 0.052，本来就"绿"）—— 高音的能量
	#   集中在高次谐波上，而它们衰减本来就快，会掩盖 damp 的错。所以必须**三个音一起**判，
	#   真正的闸门是低音与中音那两格（这一条是靠 `all` 才咬住的）。
	var t_ratio: Array[float] = []
	var t_txt := ""
	for f_test in [146.83, 440.0, 880.0]:
		var pcm_t := pluck_pcm(f_test, 1.2, brightness)
		var r_head := _rms_ac(pcm_t, 0.10, 0.30)
		var r_tail := _rms_ac(pcm_t, 0.50, 0.70)
		var ratio := r_tail / maxf(r_head, 1e-12)
		t_ratio.append(ratio)
		t_txt += ("%.1fHz→%.4f " % [f_test, ratio])
	var t_ok := true
	for r in t_ratio:
		if r > 0.25 or r < 0.0001:
			t_ok = false
	checks.append(["⑯ 余音衰减速率｜0.48s 内去直流 RMS 比 ≤ 0.25 · 余音≤请求2倍 · 且 ≥ 1e-4 非瞬死"
			+ "，三个音都要",
		t_ok, "尾部/首部 RMS 比 %s" % t_txt])

	# ===== 局势档的测试夹具（⑰ 与 ⑲~㉒ 共用）=====
	# ★ 只喂**音乐真的会读**的字段（其余基础字段给一组"不触发任何项"的中性值）；
	#   `an_player_diff` / `an_ai_diff` 是**两侧各一份**的镜像值：音乐只读玩家那一份，
	#   镜像值只是为了让快照不自相矛盾（视角纪律：生产端才是"各写一条显式分支"的地方）。
	var mk_sit := func(crisis: float, pdiff: float, live: int, unsettled: int, dead: int) -> Dictionary:
		return {
			"black_prisoners": 0, "white_prisoners": 0, "board_size": 20, "tiles_total": 160,
			"passes": 0, "game_over": false, "current_player": 1, "has_situation": true,
			"an_crisis": crisis, "an_player_crisis": crisis, "an_ai_crisis": crisis,
			"an_player_diff": pdiff, "an_ai_diff": -pdiff,
			"an_live_blocks": live, "an_unsettled_blocks": unsettled, "an_dead_blocks": dead,
			"an_player_live_blocks": live, "an_player_unsettled_blocks": unsettled,
			"an_player_dead_blocks": dead,
		}

	# ⑰ 环路反解**契约**（缺陷 C 的闸门）：对**游戏真正会用到的每一个 (音高, 时长)** 组合，
	#    反解出来的 `a` 必须让解析周期**精确命中**目标 `D = sr/f`。
	# ★ 为什么这条有牙齿（不是同义反复）：两个"钳位"出口 —— `τ(a=1) > D`（延迟**不够**）
	#   与 `τ(a=0) < D`（延迟**过头**）—— 都会返回一个 `τ ≠ D` 的解，而且**不报任何错**。
	#   真发作过一次：`_ring_len()` 只按三抽头的群延迟 1 取 N，而 `avg2` 的群延迟是 0.5
	#   ⇒ 440Hz 上 `τ(1) = 50.388 > D = 50.114` ⇒ `a` 被钳在 1、音高落在 **−9.5 音分**
	#   （既不是旧值也不是修好的值）。`|τ − D|` 这一条当场就会红。
	# ★★ 2026-10-07：枚举范围扩到**局势档**，而且**四个轴各自推到极值**（外加一组"全拉满"）——
	#   音高轴会把旋律推到 ±`pitch_span_deg` 个音阶度数（= ± 一个八度）⇒ 造出改造前
	#   **根本不存在**的音：最低 33（A1 55Hz）/ 最高 93（A6 1760Hz，要"色彩满 + 音高 +5"
	#   同时出现）。不枚举它们，"环路反解在新的极值音高上还准不准"就是没人看的地方。
	# ★ 顺带把"样本够宽"这件事本身做成会红的判据（下面断言覆盖到的音高区间）：
	#   否则把 `pitch_span_deg` 调成 0、枚举缩回老样子，这条判据照样全绿。
	var used: Dictionary = {}
	var ax_set: Array[Dictionary] = []
	for band in [0.0, 0.45, 0.9]:
		ax_set.append(axes_from_tension(float(band)))
	ax_set.append(axes_from_state(mk_sit.call(0.0, 0.0, 12, 0, 0)))     # 形已定（色彩 0）
	ax_set.append(axes_from_state(mk_sit.call(1.0, 0.0, 0, 12, 0)))     # 全未定形（色彩中档）
	ax_set.append(axes_from_state(mk_sit.call(1.0, 0.0, 0, 0, 6)))      # 全死（色彩满 + 响度满）
	ax_set.append(axes_from_state(mk_sit.call(0.0, 100.0, 12, 0, 0)))   # 音高 +5 度
	ax_set.append(axes_from_state(mk_sit.call(0.0, -100.0, 12, 0, 0)))  # 音高 −5 度
	ax_set.append(axes_from_state(mk_sit.call(1.0, 100.0, 0, 0, 12)))   # 色彩满 + 音高 +5（最高音）
	# ★★ 极值音高**不是**"多枚举几个轴"就能稳定拿到的：它还要 rng 同时抽到
	#   "音阶步进的最大档"（1/7）与"最高八度"（1/2）—— 实测 12 小节的窗口只覆盖到
	#   35~89，**A1(33)/A6(93) 两个真正的新音高一个都没进样本**（第一版这条判据就是
	#   因为按"理论极值"定界而红：判据与数据自相矛盾，铁律 17 ⇒ 先怀疑判据）。
	#   修法 = 把节奏轴推到"每步都发 + 满密度"（`_schedule_step` 的取样概率拉满）
	#   **并把窗口加宽到 64 小节**：固定种子 ⇒ 结果仍然完全确定，但真的落进极值档。
	var ax_hi: Dictionary = axes_from_state(mk_sit.call(1.0, 100.0, 0, 0, 12))
	ax_hi["tempo"] = 1.0
	ax_hi["stride"] = 1
	ax_set.append(ax_hi)
	var ax_lo: Dictionary = axes_from_state(mk_sit.call(0.0, -100.0, 12, 0, 0))
	ax_lo["tempo"] = 1.0
	ax_lo["stride"] = 1
	ax_set.append(ax_lo)
	var probe_bars := 64
	for ax in ax_set:
		for k in range(0, probe_bars * maxi(beats_per_bar * maxi(subdiv, 1), 1)):
			for e in _schedule_step(k, ax):
				used["%d|%s|%s" % [int(e["midi"]), str(e["kind"]), str(e.get("instr", ""))]] = true
	# ★★ 2026-10-16：**乐句引入的音高也必须过环路反解这一关**。
	#   乐句库带来了一批旋律里根本不会出现的音（低到 50 = D4 下方的宫、高到 90），
	#   而且六个时刻全在同一个 `ax` 下 —— 不枚举它们，"环路反解在这些新音高上还准不准"
	#   就是一句没人看的话。这里用一组**代表性四轴**（张力拉满 + 色彩满）逐时刻枚举：
	#   乐句只吃 `cue` 参数，四轴不影响它的音高，所以一组就够（多喂几组只是浪费时间）。
	for cq in CUE_IDS:
		for k in range(0, probe_bars * maxi(beats_per_bar * maxi(subdiv, 1), 1)):
			for e in _schedule_step(k, axes_from_tension(1.0), str(cq)):
				used["%d|%s|%s" % [int(e["midi"]), str(e["kind"]), str(e.get("instr", ""))]] = true
	var midi_min := 999
	var midi_max := -1
	for key in used:
		var mm := int(str(key).split("|")[0])
		midi_min = mini(midi_min, mm)
		midi_max = maxi(midi_max, mm)
	var sr_fix := maxi(sample_rate, 8000)
	# ★★ 必须**两种滤波器形状都验**：今天真发作的那个缺陷只在 `avg2` 这一档显形
	#    —— 只验出货态（sym3）的话，这条判据是**哑的**（`|τ−D|` 恒为 0，恒真式）。
	#    `use_sym3=false` 的那一档就是 `loop_pitch_fix` 单独打开时的真实回路。
	var modes := [
		{"lbl": "都修(sym3)", "sym3": true, "gd": 1.0},
		{"lbl": "只修音高(avg2)", "sym3": false, "gd": 0.5},
	]
	var n_checked := 0
	var tau_worst := 0.0
	var tau_who := ""
	var damp_worst := 0.0
	var damp_who := ""
	var cents_worst := 0.0
	var cents_who := ""
	var g0_worst := 0.0
	var mode_worst := {}
	for md in modes:
		var use3: bool = bool(md["sym3"])
		var gdl: float = float(md["gd"])
		var w := 0.0
		for key in used:
			var parts := str(key).split("|")
			var fq := midi_to_freq(int(parts[0]))
			# ★★ 2026-10-16：这里原来写的是 `pad_seconds if kind == "pad" else note_seconds`
			#   —— 那是**判据自己重写了一份 kind→时长映射**（铁律 70 的同族：
			#   判据不许重实现被测逻辑）。加了 `arp` / `orn` 两族之后，那份手写映射
			#   会把它们全按 `note_seconds` 算 ⇒ 判据量的 T60 与被测的合成器不是一个数，
			#   而它**照样绿**（因为 `|τ−D|` 那一半仍然成立）。改走唯一真源。
			var zmid_j := int(parts[0]) if parts.size() >= 3 and _resolve_instr(str(parts[2])) == "guzheng" else -1
			var secs := _seconds_for_kind(str(parts[1]), zmid_j)
			var D2 := float(sr_fix) / maxf(fq, 20.0)
			var g2 := 0.0
			if use3:
				g2 = minf(loop_damp_max, _g0_max(sr_fix, D2, secs) * 0.9)
			var n2 := _ring_len(D2, gdl, sr_fix)
			var a2 := _solve_ap(sr_fix, n2, g2, use3, D2)
			var t2 := _loop_tau(sr_fix, n2, g2, use3, true, a2)
			var m2 := maxf(float(_loop_resp(sr_fix, n2, g2, use3, true, a2)[3]), 1e-6)
			# ★ 与 `pluck_pcm()` **同一个**口径：`trip = D` 只在修时长时成立。
			var d2 := pow(10.0, -3.0 * (float(n2) + 0.5) / (float(sr_fix) * maxf(secs, 0.05)))
			if use3:
				d2 = _damp_target(sr_fix, D2, secs) / m2
			n_checked += 1
			var e2 := absf(t2 - D2)
			if e2 > w:
				w = e2
			# ★ 同时换算成**音分**（唯一有物理含义的单位）：`|τ−D|` 是采样域的，
			#   同一个界在 55Hz 与 1760Hz 上等价于**不同的**听感精度
			#   （0.02 采样 = 0.086 音分 @55Hz，却 = 1.9 音分 @1760Hz）。
			#   两个都印出来：界继续用采样（它才是"精确命中"的本义），
			#   音分用于让人一眼看出"这个偏差到底听不听得出来"。
			if t2 > 0.0 and D2 > 0.0:
				var cn := absf(1200.0 * log(t2 / D2) / log(2.0))
				if cn > cents_worst:
					cents_worst = cn
					cents_who = "%s %.1fHz/%s" % [str(md["lbl"]), fq, str(parts[1])]
			if e2 > tau_worst:
				tau_worst = e2
				tau_who = "%s %.1fHz/%s N=%d a=%.4f" % [str(md["lbl"]), fq, str(parts[1]), n2, a2]
			if d2 > damp_worst:
				damp_worst = d2
				damp_who = "%s %.1fHz/%s" % [str(md["lbl"]), fq, str(parts[1])]
			g0_worst = maxf(g0_worst, g2)
		mode_worst[str(md["lbl"])] = w
	checks.append(["⑰ 环路周期契约｜游戏用到的**每个** (音高,时长) × **两种滤波器形状**：解析周期必须精确命中 sr/f"
			+ "（钳位 = 静默走音）· 且样本要覆盖四轴极值带来的音高区间 [33, 93]",
		n_checked >= 40 and tau_worst <= 0.02 and midi_min <= 34 and midi_max >= 88,
		"%d 个组合 · 音高 %d~%d（期望落进 33~93）· |τ−D| 最大 %.4f 采样 = %.3f 音分（判据 ≤0.02 采样）· 最差 %s · 分模式 %s" % [
			n_checked, midi_min, midi_max, tau_worst, cents_worst, tau_who, str(mode_worst)]])

	# ⑱ `damp ≤ 1` **硬约束**（缺陷 D 的安全线）：`damp = dampTarget / |H(θ₁)|`。
	# ★ 为什么这是硬要求而不是"数值好看"：`damp > 1` ⇒ 环路在低频段**净增益 > 1**
	#   ⇒ **直流模态成长**。`loop_comp` 那条老路就是 `damp > 1`，实测 RMS 尾段 +12.8dB、
	#   直流涨 28 倍（而基频 h1 看起来"正常衰减"）—— **换病不是治病**。
	#   修法方向必须是"把 |H(θ₁)| 抬到接近 1"（三抽头），而不是"把损耗补进 damp"。
	# ★ 顺带钉住 `g0 ≤ loop_damp_max`：g0 是逐音反解出来的，它一旦越界就说明
	#   `_g0_max()` 的预算算错了（原型"光滑排程"那版越界 13/26、最多 1.8 倍）。
	checks.append(["⑱ 阻尼不超一｜`damp = dampTarget/|H(θ₁)|` 对每个组合都必须 ≤1｜damp>1 ⇒ 直流成长｜"
			+ " · 且 g0 ≤ loop_damp_max",
		n_checked >= 40 and damp_worst <= 1.0 and g0_worst <= loop_damp_max + 1e-6,
		"%d 个组合 · damp 最大 %.6f（判据 ≤1.0）· 最差 %s · g0 最大 %.4f（上限 %.4f）" % [
			n_checked, damp_worst, damp_who, g0_worst, loop_damp_max]])

	# ===== 四轴（2026-10-07：用户口令「从不同方面读取局势决定响度/节奏/音高/和弦色彩」）=====
	# ⑲ 四轴：**落点** + **交叉独立性**。本轮改造的全部要求就在这两件事上，所以两面都要咬：
	#   ① 每个轴真的被自己的信号推动（不是声明了却死在常量上）；
	#   ② 每个轴**只**读自己那一个方面 —— 这一半才是关键：只顾①的话，一个
	#      "把单标量铺满四轴"的旧实现照样能全绿（那正是改造前的问题）。
	# ★ 量的是**落点**（这一步到底发了什么音），不是轴字典本身：轴字典是中间量，
	#   "只对自己的中间量对账"是自证（铁律 13：判据量的东西 = 刀改的东西）。
	# ★★ 11-05 第十一轮 C 方案：⑲ 量的是 2026-10-07 那份「四轴落点」老契约。
	#   `axes_from_state()` 现在带 src="state" ⇒ 会吃到战况段落层（density 倍率 / stride 偏置）
	#   ⇒ 平静档旋律数被压到 0、音高均值分母空 ⇒ 判据红得指错地方。
	#   新层由 ㊿ 单独守；这里像 ㉞ 钉韵 / ㊽ 钉 zone_decay / ㊱ 钉 bass 一样，
	#   **显式钉住这批新旋钮再量、量完还原**（§111 / §119 / §136）。
	var fe_keep19 := form_enabled
	var ft_keep19 := form_trace
	form_enabled = false
	form_trace = false
	var bars := 4
	var spb_now := maxi(beats_per_bar * maxi(subdiv, 1), 1)
	var step_stat := func(ax: Dictionary) -> Dictionary:
		var n_all := 0
		var n_note := 0
		var gsum := 0.0
		var midi_sum := 0
		for k in range(1, bars * spb_now + 1):
			for e in _schedule_step(k, ax):
				n_all += 1
				gsum += float(e["gain"])
				# ★★ 2026-10-16："旋律"这个口径必须跟着**技法**一起扩 —— 技法会把一个旋律槽
				#   弹成 `orn`（摇指/刮奏/倚音），也会补一个 `orn` 泛音。只数 `note` 的话，
				#   `tech_*` 一开这条判据就量到一个腰斩的"旋律数"，而它自己以为在量节奏轴。
				#   排除的是**伴奏族**（和弦琶音 / 长音 / 读秒声）：那三样本来就不是旋律。
				if str(e["kind"]) == "note" or str(e["kind"]) == "orn":
					n_note += 1
					midi_sum += int(e["midi"])
		return {"n": n_all, "note": n_note, "g": gsum,
			"midi": float(midi_sum) / float(maxi(n_note, 1))}
	var chord_outsiders := func(hh: Dictionary) -> int:
		# ★ 复用判据 ① 建起来的 `want_set`：它来自**判据自带的字面音阶**（不是曲风表），
		#   所以"和弦音是不是阶外音"这件事不依赖被测物（否则又是一条恒真式）。
		var c := 0
		for v in (hh["chord"] as Array):
			if not want_set.has((((int(v) - root_midi) % 12) + 12) % 12):
				c += 1
		return c
	var axes_moved := func(sa: Dictionary, sb2: Dictionary) -> Array:
		var aa: Dictionary = axes_from_state(sa)
		var bb: Dictionary = axes_from_state(sb2)
		var mv: Array = []
		for kk in ["loud", "tempo", "pitch", "hue"]:
			if absf(float(aa[kk]) - float(bb[kk])) > 1e-9:
				mv.append(kk)
		return mv
	# —— 四组"只差一个信号"的对照（每组都从同一份基线出发）——
	var st_loud_a: Dictionary = mk_sit.call(0.0, 0.0, 6, 0, 0)
	var st_loud_b: Dictionary = mk_sit.call(1.0, 0.0, 6, 0, 0)
	var st_beat_a: Dictionary = mk_sit.call(0.0, 0.0, 6, 0, 0)
	var st_beat_b: Dictionary = st_beat_a.duplicate()
	st_beat_b["black_prisoners"] = 8          # 交手烈度拉满（提子差 8 = capture_ref）
	var st_pitch_a: Dictionary = mk_sit.call(0.0, 0.0, 12, 0, 0)
	var st_pitch_b: Dictionary = st_pitch_a.duplicate()
	st_pitch_b["an_player_diff"] = 20.0       # 玩家领先 20 目 = point_ref
	var st_form_a: Dictionary = mk_sit.call(0.0, 0.0, 6, 0, 0)
	var st_form_b: Dictionary = mk_sit.call(0.0, 0.0, 0, 0, 6)
	var mv_loud: Array = axes_moved.call(st_loud_a, st_loud_b)
	var mv_beat: Array = axes_moved.call(st_beat_a, st_beat_b)
	var mv_pitch: Array = axes_moved.call(st_pitch_a, st_pitch_b)
	var mv_form: Array = axes_moved.call(st_form_a, st_form_b)
	# ① 响度：事件集合逐点相同、只有 gain 被乘 ⇒ gain 之和的比 = 倍率之比（精确）
	var ss_la: Dictionary = step_stat.call(axes_from_state(st_loud_a))
	var ss_lb: Dictionary = step_stat.call(axes_from_state(st_loud_b))
	var rms_la := _rms(render_offline(3.0, 0.0, st_loud_a), 0.0, 3.0)
	var rms_lb := _rms(render_offline(3.0, 0.0, st_loud_b), 0.0, 3.0)
	var ok_loud: bool = (str(mv_loud) == str(["loud"])
			and float(ss_lb["g"]) >= float(ss_la["g"]) * 2.0
			and rms_lb >= rms_la * 1.6 and rms_la > 0.0)
	# ② 节奏：旋律出现次数（= 间隔的倒数）必须真的变密
	var ss_ba: Dictionary = step_stat.call(axes_from_state(st_beat_a))
	var ss_bb: Dictionary = step_stat.call(axes_from_state(st_beat_b))
	var ok_beat: bool = (str(mv_beat) == str(["tempo"])
			and int(ss_bb["note"]) >= int(ss_ba["note"]) * 1.5 and int(ss_bb["note"]) >= 4)
	# ③ 音高：旋律的**平均音高**必须真的上行（偏的是度数 ⇒ 恰好 +12 半音 = 一个八度）
	var ss_pa: Dictionary = step_stat.call(axes_from_state(st_pitch_a))
	var ss_pb: Dictionary = step_stat.call(axes_from_state(st_pitch_b))
	var ok_pitch: bool = (str(mv_pitch) == str(["pitch"])
			and float(ss_pb["midi"]) >= float(ss_pa["midi"]) + 3.0)
	# ④ 色彩：形态度动了 ⇒ 和弦必须真的换档。
	#   ★★★ 2026-10-17 **换物理量**（用户口令「好好调整和弦，让它更和谐就好」）。
	#     旧口径量的是"阶外音个数 0→≥1" —— 因为旧代码在最高色彩档把顶音换成 `+1`/`+6`
	#     的**阶外**偏音。要求齐奏之后那个偏音会**同时**撞在其余和弦音上（= 用户说"吵"的
	#     机械来源），所以它被"加一级音 + 顶音升八度"取代 ⇒ 旧物理量恒为 0→0。
	#     ★ **换物理量不是放松判据**：新口径要求形态轴把和弦换得**更多**，三面都验：
	#        ① 音数必须从平静档涨到张力满档（两个旋钮本身，不是差值的影子）；
	#        ② 顶距（最高音−最低音）必须**严格变大**（八度敞开 ⇒ 音域被拉开 = 听得见的"更亮"）；
	#        ③ 和弦音必须**全部落在阶内**（`chord_outsiders == 0`）—— 这条是"更和谐"的硬面，
	#           与 ㉘④ 的音程禁区互补：那条禁"碰撞音程"，这条禁"离开五声音阶"。
	#     三个面各有一条独立的红路：只留 ① ⇒ 顶音不动也绿；只留 ② ⇒ 音数不动也绿；
	#     ③ 是唯一能逮到"有人又把偏音加回来"的那面（它反向：红=有偏音）。
	var h_fa: Dictionary = _harmony_for_bar(0, float(axes_from_state(st_form_a)["hue"]))
	var h_fb: Dictionary = _harmony_for_bar(0, float(axes_from_state(st_form_b)["hue"]))
	var ch_fa: Array = (h_fa["chord"] as Array)
	var ch_fb: Array = (h_fb["chord"] as Array)
	var span_fa: int = int(ch_fa.back()) - int(ch_fa[0])
	var span_fb: int = int(ch_fb.back()) - int(ch_fb[0])
	var ok_form: bool = (str(mv_form) == str(["hue"]) and not bool(h_fa["high"])
			and bool(h_fb["high"])
			and ch_fa.size() == chord_tones_calm and ch_fb.size() == chord_tones_tense
			and ch_fa.size() < ch_fb.size() and span_fb > span_fa
			and chord_outsiders.call(h_fa) == 0 and chord_outsiders.call(h_fb) == 0)
	# 形态度 → 三档的映射（这同时是"色彩的输入端"的单调性）
	var hue_live := float(axes_from_state(mk_sit.call(0.0, 0.0, 6, 0, 0))["hue"])
	var hue_uns := float(axes_from_state(mk_sit.call(0.0, 0.0, 0, 6, 0))["hue"])
	var hue_dead := float(axes_from_state(mk_sit.call(0.0, 0.0, 0, 0, 6))["hue"])
	var ok_hue_bands: bool = (hue_live < HUE_MID and hue_uns >= HUE_MID and hue_uns < HUE_HIGH
			and hue_dead >= HUE_HIGH)
	# ★ 标量必须放**读数**里，不能拼进 label：`+` 的优先级高于 `%`，
	#   写成 `"…%.2f…" + "…%d…" % [...]` 只会格式化**后半段** ⇒ 前半段的 `%` 原样打出，
	#   而 `%` 运算还会报 "not all arguments converted"（日志里一条 ERROR，判决却可能还是绿的）。
	#   本工程早记过同类坑（`%e`/`%g` 那次），这次是"优先级"而不是"格式符"。
	var lbl_axe := ("⑲ 四轴落点｜危险度⇒响度(gain×%.2f→×%.2f) · 烈度⇒节奏(旋律 %d→%d 次)"
			+ " · 优劣⇒音高(平均 %.1f→%.1f) · 形态⇒色彩(和弦 %d→%d 音·顶距 %d→%d)") % [
		loud_min_scale, loud_max_scale, int(ss_ba["note"]), int(ss_bb["note"]),
		float(ss_pa["midi"]), float(ss_pb["midi"]),
		ch_fa.size(), ch_fb.size(), span_fa, span_fb]
	checks.append([lbl_axe,
		ok_loud and ok_beat and ok_pitch and ok_form and ok_hue_bands,
		"动的轴：响度组%s · 节奏组%s · 音高组%s · 色彩组%s（各自只许动一个）｜RMS %.4f→%.4f"
			% [str(mv_loud), str(mv_beat), str(mv_pitch), str(mv_form), rms_la, rms_lb]
			+ "｜色彩档和弦 %s → %s · 阶外音 %d→%d（须恒为 0：+1/+6 偏音已退役）"
			% [str(ch_fa), str(ch_fb), chord_outsiders.call(h_fa), chord_outsiders.call(h_fb)]
			+ "｜进来时 form=%s trace=%s（本判据钉为 false 后量）" % [str(fe_keep19), str(ft_keep19)]])
	form_enabled = fe_keep19
	form_trace = ft_keep19

	# ⑳ 局势档的调度可复现：同 (k, 四轴) 两次逐字相同 —— 与 ⑩ 同一条，但走**局势档**
	#    （`gain_scale ≠ 1` / `stride > 1` / `pitch_deg ≠ 0`），那才是"随机源有没有被喂进去"的
	#    真正风险面（密集/网格/偏度都会改事件集合）。
	var ax_det: Dictionary = axes_from_state(mk_sit.call(1.0, 20.0, 0, 0, 6))
	var d1 := _schedule_step(8, ax_det)
	var d2 := _schedule_step(8, ax_det)
	checks.append(["⑳ 局势档可复现｜同一步同四轴两次调度逐字相同 · 且样本非平凡｜gain≠1/偏度≠0｜",
		str(d1) == str(d2) and d1.size() >= 3 and int(ax_det["pitch_deg"]) != 0,
		"k=8 事件数 %d · 一致=%s · gain_scale=%.2f · stride=%d · pitch_deg=%d" % [
			d1.size(), str(str(d1) == str(d2)), float(ax_det["gain_scale"]),
			int(ax_det["stride"]), int(ax_det["pitch_deg"])]])

	# ㉑ 退化档 + 闸的贡献 + 终局收束
	#   · 退化档（快照里没有局势层）**必须逐字等于旧口径** —— 这是"**四轴**没被顺手改坏"
	#     在代码侧的契约。★ 2026-10-16 精确化：它**不**保证验收 wav 的 md5 不变
	#     （见 `axes_from_tension()` 的注：这一轮改的是调度/和声层，落在所有档位上）；
	#   · 反过来问**闸的贡献**（铁律 13：不是问"结论相同"）：同一组基础数字，
	#     只把 `has_situation` 打开 ⇒ 必须有轴真的不同，否则这道闸等于不存在。
	var st_nosit: Dictionary = mk_sit.call(1.0, 20.0, 0, 0, 6)
	st_nosit["black_prisoners"] = 8
	st_nosit.erase("has_situation")
	var t_fb := battle_tension(st_nosit)
	var ax_fb: Dictionary = axes_from(t_fb, st_nosit)
	var fallback_ok: bool = (absf(float(ax_fb["gain_scale"]) - 1.0) <= 1e-9
			and int(ax_fb["stride"]) == 1 and int(ax_fb["pitch_deg"]) == 0
			and absf(float(ax_fb["hue"]) - clampf(t_fb, 0.0, 1.0)) <= 1e-9)
	var st_sit2: Dictionary = mk_sit.call(1.0, 20.0, 0, 0, 6)
	st_sit2["black_prisoners"] = 8
	var ax_sit2: Dictionary = axes_from(t_fb, st_sit2)
	var gate_gain: bool = (String(ax_sit2["src"]) == "state"
			and (absf(float(ax_sit2["gain_scale"]) - float(ax_fb["gain_scale"])) > 1e-9
				or int(ax_sit2["stride"]) != int(ax_fb["stride"])
				or int(ax_sit2["pitch_deg"]) != int(ax_fb["pitch_deg"])
				or absf(float(ax_sit2["hue"]) - float(ax_fb["hue"])) > 1e-9))
	var st_over: Dictionary = mk_sit.call(1.0, 20.0, 0, 0, 6)
	st_over["black_prisoners"] = 8
	st_over["passes"] = 2
	st_over["game_over"] = true
	var ax_over: Dictionary = axes_from_state(st_over)
	var over_ok: bool = (absf(float(ax_over["gain_scale"]) - loud_min_scale) <= 1e-9
			and absf(float(ax_over["hue"])) <= 1e-9 and int(ax_over["pitch_deg"]) == 0
			and int(ax_over["stride"]) == _stride_of(0.0) and float(ax_over["tempo"]) <= 1e-9)
	checks.append(["㉑ 退化档与闸的贡献｜无局势层 ⇒ 逐字等于旧口径｜gain=1 · stride=1 · 偏 0 · hue=张力｜"
			+ " · 开了局势层必须真的不同 · 终局显式收束",
		fallback_ok and gate_gain and over_ok,
		"退化档 gain=%.2f/stride=%d/偏=%d/hue=%.3f ｜局势档 %s ｜终局 gain=%.2f/hue=%.3f/stride=%d" % [
			float(ax_fb["gain_scale"]), int(ax_fb["stride"]), int(ax_fb["pitch_deg"]),
			float(ax_fb["hue"]), str(ax_sit2), float(ax_over["gain_scale"]),
			float(ax_over["hue"]), int(ax_over["stride"])]])

	# ㉒ 局势完整性闸（`has_situation`）**三面**都要验：全在 ⇒ 真 · 缺**任一个** ⇒ 假 ·
	#    多一个不相干的名字 ⇒ 仍然真。★ 三面缺一面都是恒真式：只验"缺了会假"的话，
	#    一个永远返回 false 的闸也能过；只验"全在会真"的话，`return true` 也能过。
	var names_ok: Dictionary = {}
	for f in SITUATION_FIELDS:
		names_ok[String(f)] = true
	var gate_pos: bool = _situation_complete(names_ok)
	var n_gate_neg := 0
	for f in SITUATION_FIELDS:
		var n2 := names_ok.duplicate()
		n2.erase(String(f))
		if not _situation_complete(n2):
			n_gate_neg += 1
	var names_extra := names_ok.duplicate()
	names_extra["an_this_field_does_not_exist"] = true
	var gate_extra: bool = _situation_complete(names_extra)
	checks.append(["㉒ 完整性闸｜阳性｜全在⇒真｜· 阴性｜逐个缺⇒假，%d/%d 全要咬住｜· 多余名字不许干扰"
			% [n_gate_neg, SITUATION_FIELDS.size()],
		gate_pos and n_gate_neg == SITUATION_FIELDS.size() and gate_extra,
		"局势字段 %d 个（基础 %d 个）· 阳性=%s · 阴性命中 %d · 多余名不干扰=%s" % [
			SITUATION_FIELDS.size(), BATTLE_FIELDS.size(), str(gate_pos), n_gate_neg,
			str(gate_extra)]])

	# ===== 棋钟对接（2026-10-16）：外部棋钟 → 节拍 / 读秒声 =====
	# 判据都在**纯函数**这一层（`clash_level` / `_clock_ext_apply` / `_schedule_step` /
	# `axes_from_state`）：它们是"在线"与"离线"共同的真源，验它们等于验两条路。
	# 唯一读场景的是 `_read_battle_state()`（`clk` 字段名由 ⑦ 的静态检查守着）。
	var count_kind := func(evs: Array, kind: String) -> int:
		var n := 0
		for e in evs:
			if str(e["kind"]) == kind:
				n += 1
		return n

	# ㉓ 时间压力 → 节奏轴：同一个局面，只改 `clk_pressure` 这一个自变量
	#    ★ 阴性对照做在同一判据里：把权重拧到 0 后，同一个自变量必须**带不动**它 ——
	#      否则三档单调可能来自别的通路（比如它其实读的是提子差）。
	var mk_press := func(p: float) -> Dictionary:
		return {"black_prisoners": 0, "white_prisoners": 0, "board_size": 0,
			"tiles_total": 100, "passes": 0, "game_over": false, "clk_pressure": p}
	var cl_lo := clash_level(mk_press.call(0.0))
	var cl_mid := clash_level(mk_press.call(0.5))
	var cl_hi := clash_level(mk_press.call(1.0))
	var w_keep := clk_pressure_weight
	clk_pressure_weight = 0.0
	var cl_hi_off := clash_level(mk_press.call(1.0))
	clk_pressure_weight = w_keep
	checks.append(["㉓ 时间压力→节奏轴｜0 / 0.5 / 1 严格递增｜· 权重拧0后必须带不动",
		cl_lo < cl_mid - 1e-6 and cl_mid < cl_hi - 1e-6 and cl_hi_off <= 1e-9,
		"clash %.4f → %.4f → %.4f · 权重0时 %.4f · 权重 %.2f" % [
			cl_lo, cl_mid, cl_hi, cl_hi_off, w_keep]])

	# ㉔ 换速的**时机**：非小节头不许换、小节头才换、没有 clk 必须退回基准
	#    ★ 三面缺一不可：只验"小节头会换" ⇒ 一个每步都换的实现也能过；
	#      只验"非小节头不换" ⇒ 一个永远不换的实现也能过。
	var bpm_keep2 := bpm
	var spb_keep2 := beats_per_bar
	var sd_keep2 := subdiv
	bpm = 72.0
	beats_per_bar = 4
	subdiv = 2                                   # ⇒ 每小节 8 步
	_bpm_now = 0.0
	var clk_st := {"clk_bpm": 120.0, "clk_pressure": 0.4}
	_step_idx = 1                                # 非小节头
	_clock_ext_apply(clk_st)
	var b_mid := effective_bpm()
	_step_idx = 8                                # 小节头
	_clock_ext_apply(clk_st)
	var b_bar := effective_bpm()
	_step_idx = 16
	_clock_ext_apply({})                         # 没有 clk 字段 ⇒ 撤退回基准
	var b_back := effective_bpm()
	# 超界目标必须被夹住（否则 `step_seconds()` 能走到 0 或负数 ⇒ `_advance()` 空转）
	_step_idx = 24
	_clock_ext_apply({"clk_bpm": 9999.0, "clk_pressure": 0.0})
	var b_clamp := effective_bpm()
	checks.append(["㉔ 换速时机｜非小节头不许换｜小节头才换｜无 clk 退回基准｜超界夹住",
		absf(b_mid - 72.0) <= 1e-9 and absf(b_bar - 120.0) <= 1e-9
		and absf(b_back - 72.0) <= 1e-9 and absf(b_clamp - clk_bpm_max) <= 1e-9,
		"非小节头 %.1f · 小节头 %.1f · 撤退 %.1f · 夹取 %.1f · 基准 %.1f" % [
			b_mid, b_bar, b_back, b_clamp, bpm]])
	bpm = bpm_keep2
	beats_per_bar = spb_keep2
	subdiv = sd_keep2
	_bpm_now = 0.0

	# ㉕ 读秒声：闸下完全安静 · 过闸在**拍点**发声 · 非拍点一个都不许有
	#    ★ "非拍点"那一面必须有：否则"每步都响"的实现也是绿的，而它就是抢拍。
	var ax_q_lo := {"gain_scale": 1.0, "stride": 1, "tempo": 0.0, "pitch_deg": 0,
		"hue": 0.0, "pressure": 0.0}
	var ax_q_hi := ax_q_lo.duplicate()
	ax_q_hi["pressure"] = 1.0
	var n_tick_lo := int(count_kind.call(_schedule_step(2, ax_q_lo), "tick"))
	var ev_hi: Array = _schedule_step(2, ax_q_hi)          # k=2 ⇒ in_bar 2，2%2==0 ⇒ 拍点
	var n_tick_hi := int(count_kind.call(ev_hi, "tick"))
	var n_tick_off := int(count_kind.call(_schedule_step(3, ax_q_hi), "tick"))   # in_bar 3 ⇒ 非拍点
	var tick_midi_ok := false
	for e in ev_hi:
		if str(e["kind"]) == "tick" and int(e["midi"]) == clk_tick_midi:
			tick_midi_ok = true
	checks.append(["㉕ 读秒声｜闸下必须完全安静｜拍点发声且音高符合参数｜非拍点一个都不许有",
		n_tick_lo == 0 and n_tick_hi == 1 and n_tick_off == 0 and tick_midi_ok,
		"闸下 %d · 拍点 %d · 非拍点 %d · midi=%d 期望%d" % [
			n_tick_lo, n_tick_hi, n_tick_off, clk_tick_midi, clk_tick_midi]])

	# ㉖ 时长真源：**五个音族**各自归位，且大小关系必须成立。
	#    ★ 这条盯的是"在线取流"与"离线渲染"两条路各写一份 `if kind == "pad"` 的分叉 ——
	#      分叉了的话，在线听是短促读秒声、离线验收 wav 里却是长音，两边都不报错。
	#    ★★ 2026-10-16 扩到五族 + 补两条**大小关系**（它们就是用户那两条口令的量化形式）：
	#      · `arp < pad`：「和弦余音必须短」—— `pad_seconds = 4.0` 配 3.33 秒的小节，
	#        和弦永远叠着响，那正是"有点吵"的主因；
	#      · `orn < arp`：「装饰音必须更短」—— 刮奏是 7~8 个音在 0.4 秒里跑完，
	#        每个音拖 1.3 秒尾巴的话那串音就糊成噪音。
	#      只验"参数被读到"是不够的（那把两个数都设成 4.0 也照样绿）——这是**关系**级判据。
	#    ★★★ 2026-10-16 深夜再加两条**属性级**面，因为 `arp` 这一族变成了**派生量**
	#      `minf(arp_seconds, _arp_fit_seconds())`（理由见 `_seconds_for_kind()` 的注释）：
	#        ① **三档速度下都不跨小节**：`(CHORD_TONES_MAX-1)×_arp_gap() + 余音 ≤ 小节`。
	#           为什么必须扫三档：`arp_seconds` 是秒、小节随 BPM 缩 ⇒ **同一份秒数在不同
	#           速度下结论不同**。只在默认 72 BPM 上验的话，"200 BPM 时和弦必然跨小节"
	#           这个缺陷永远看不见（而它正是"糊"在快节奏下的复活）。
	#        ② **和弦余音 ≤ 初版的 `SIM_CHORD_BUDGET` 倍**（= `pad_seconds × SIM_CHORD_BUDGET`）：
	#           10-16 那版口令是「可以保留初版约1/3的同时演奏和弦」⇒ 预算 1/3；
	#           ★★★ 10-17 用户改口令「琶音太吵了，还是换回齐奏吧」⇒ **齐奏下"同时发声"
	#           必然 ≥ 和弦音数**，与"只留 1/3 同时发声"数学上不相容 ⇒ 后到的赢，预算 1/3 → 1/2。
	#           （预算不再是"同时发声的音数"，而是**余音长度**这一族的界；同时发声那一面归 ㉘。）
	#      ⇒ 派生量这一族验的是**不等式 + 两端行为**，不是相等：
	#         · 最慢档（自适应不生效）必须**逐位等于** `arp_seconds` ⇒ 参数真的被读到了；
	#         · 最快档（自适应生效）必须**严格更短** ⇒ 自适应真的在动。
	#         缺任何一头都能被绕过去：只验相等 ⇒ 自适应是死代码；只验更短 ⇒ 参数没被读也绿。
	#    ★★★ 2026-10-17 新增第三组面：**「所有音都适当延长一点」**（用户本轮第二句口令）。
	#      "适当"是个感觉词 ⇒ 必须落成可判的数（§117）：五族**各自**都不许短于 v8 的
	#      `LENGTHEN_MIN` 倍。为什么逐族列而不验"总时长"：五族是**五个独立的旋钮**，
	#      只把 `note_seconds` 拉长而 `tick/orn` 原地不动，用户听到的是"旋律拖了、颗粒没变"——
	#      总时长照样变绿。分母不是 0：五个 `*_SECONDS_V8` 都是 v8 出货值，改动前后都可读。
	#      下限而非等号：将来继续延长不该报红（"只增不减"，§111）。
	var sec_note := _seconds_for_kind("note")
	var sec_pad := _seconds_for_kind("pad")
	var sec_tick := _seconds_for_kind("tick")
	var sec_arp := _seconds_for_kind("arp")
	var sec_orn := _seconds_for_kind("orn")
	var cf_keep26 := clk_follow
	var si_keep26 := _step_idx
	clk_follow = true
	_step_idx = _steps_per_bar() * 3        # 小节头 ⇒ 允许提交（走 `_clock_ext_apply` 的真实路径）
	var speeds26: Array[float] = [clk_bpm_min, bpm, clk_bpm_max]
	var ring26: Array[float] = []
	var fit_bad26: Array[String] = []
	var bud_bad26: Array[String] = []
	for b26 in speeds26:
		_clock_ext_apply({"clk_bpm": b26, "clk_pressure": 0.0})
		var bar26 := float(_steps_per_bar()) * step_seconds()
		var used26 := float(maxi(CHORD_TONES_MAX - 1, 0)) * _arp_gap()
		var r26 := _seconds_for_kind("arp")
		ring26.append(r26)
		if used26 + r26 > bar26 + 1e-6:
			fit_bad26.append("%.0fBPM 占%.2f+余%.2f>小节%.2f" % [b26, used26, r26, bar26])
		if r26 > pad_seconds * SIM_CHORD_BUDGET + 1e-6:
			bud_bad26.append("%.0fBPM 余%.2f" % [b26, r26])
	_bpm_now = 0.0
	clk_follow = cf_keep26
	_step_idx = si_keep26
	var sec_arp_slow_ok := is_equal_approx(ring26[0], arp_seconds)
	var sec_arp_fast_short := ring26[2] < arp_seconds - 1e-6
	var len26: Array[String] = []
	for pr26 in [["tick", sec_tick, TICK_SECONDS_V8], ["note", sec_note, NOTE_SECONDS_V8],
			["arp", sec_arp, ARP_SECONDS_V8], ["pad", sec_pad, PAD_SECONDS_V8],
			["orn", sec_orn, ORN_SECONDS_V8]]:
		var need26 := float(pr26[2]) * LENGTHEN_MIN
		if float(pr26[1]) < need26 - 1e-6:
			len26.append("%s %.3f<%.3f" % [str(pr26[0]), float(pr26[1]), need26])
	checks.append(["㉖ 时长真源｜五族各归其位｜tick<note｜**arp<pad**｜**orn<arp**｜三档速度都不跨小节"
			+ "｜**五族都 ≥ v8 的 %.2f 倍**｜和弦余音 ≤ 初版的 %.2f = %.2fs"
			% [LENGTHEN_MIN, SIM_CHORD_BUDGET, pad_seconds * SIM_CHORD_BUDGET],
		is_equal_approx(sec_tick, tick_seconds) and is_equal_approx(sec_note, note_seconds)
		and is_equal_approx(sec_pad, pad_seconds)
		and sec_arp <= arp_seconds + 1e-6 and sec_arp > 0.0
		and is_equal_approx(sec_orn, orn_seconds)
		and is_equal_approx(_bright_for_kind("tick"), tick_brightness)
		and is_equal_approx(_bright_for_kind("orn"), orn_brightness)
		and sec_tick < sec_note and sec_arp < sec_pad and sec_orn < sec_arp
		and fit_bad26.is_empty() and bud_bad26.is_empty()
		and sec_arp_slow_ok and sec_arp_fast_short and len26.is_empty(),
		"note %.2fs / pad %.2fs / tick %.3fs / arp %.2fs / orn %.2fs · 亮度 tick %.2f orn %.2f 其余 %.2f"
			% [sec_note, sec_pad, sec_tick, sec_arp, sec_orn,
				_bright_for_kind("tick"), _bright_for_kind("orn"), brightness]
			+ " · 三档 arp 余音 %s（%.0f/%.0f/%.0f BPM，最慢档须逐位等于 %.2f、最快档须更短）"
			% [str(ring26).replace(",", " /"), clk_bpm_min, bpm, clk_bpm_max, arp_seconds]
			+ " · v8 倍数 tick %.2f note %.2f arp %.2f pad %.2f orn %.2f（下限 %.2f）"
			% [sec_tick / TICK_SECONDS_V8, sec_note / NOTE_SECONDS_V8, sec_arp / ARP_SECONDS_V8,
				sec_pad / PAD_SECONDS_V8, sec_orn / ORN_SECONDS_V8, LENGTHEN_MIN]
			+ (" · 跨小节 %s" % str(fit_bad26) if not fit_bad26.is_empty() else "")
			+ (" · 超预算 %s" % str(bud_bad26) if not bud_bad26.is_empty() else "")
			+ (" · 没延长够 %s" % str(len26) if not len26.is_empty() else "")])

	# ㉗ 压力进**四轴**并且**终局必须收束到 0**
	#    ★ 终局那一面是"同屏矛盾"守卫：钟停了但压力值会停在最后一手，
	#      不收的话比赛结束后读秒声还在滴答，而音乐已经进了收束档。
	var mk_full := func(press: float, over: bool) -> Dictionary:
		var d := {"black_prisoners": 0, "white_prisoners": 0, "board_size": 0,
			"tiles_total": 100, "passes": 0, "game_over": over, "has_situation": true,
			"clk_pressure": press}
		for f in SITUATION_FIELDS:
			d[String(f)] = 0.0
		return d
	var ax_r_lo: Dictionary = axes_from_state(mk_full.call(0.0, false))
	var ax_r_hi: Dictionary = axes_from_state(mk_full.call(1.0, false))
	var ax_r_over: Dictionary = axes_from_state(mk_full.call(1.0, true))
	checks.append(["㉗ 压力入四轴并收束｜压力升 ⇒ tempo 升｜终局 pressure 必须回 0",
		float(ax_r_hi["tempo"]) > float(ax_r_lo["tempo"]) + 0.1
		and absf(float(ax_r_lo["pressure"])) <= 1e-9
		and absf(float(ax_r_hi["pressure"]) - 1.0) <= 1e-9
		and absf(float(ax_r_over["pressure"])) <= 1e-9
		and float(ax_r_over["tempo"]) <= 1e-9,
		"tempo %.3f→%.3f · pressure %.2f→%.2f · 终局 tempo %.3f pressure %.2f" % [
			float(ax_r_lo["tempo"]), float(ax_r_hi["tempo"]),
			float(ax_r_lo["pressure"]), float(ax_r_hi["pressure"]),
			float(ax_r_over["tempo"]), float(ax_r_over["pressure"])]])

	# ===== 曲风 / 特殊时刻 / 古筝技法（2026-10-16，用户口令的落点）=====
	# ㉘ **同时发声 / 和声协和度**。★ 这一条**重写过两版** ——
	#    第一版用"全曲同时在响的音数"去量，实测峰值 8 / 均值 3.51 直接超了拍出来的界（5 / 2.2）；
	#    第二版拆成三面，但面③量的仍是"**全曲**平均同时发声的新/旧比"——
	#    那个量里**同时含着旋律那一口**，而用户的口令是「留白太多，尽量把音符延长」
	#    ⇒ 拉长旋律时分子分母同时涨、和弦那口的**绝对**节省却是个常数
	#    ⇒ 比值必被推向 1，判据会从"和弦降了多少"悄悄变成"**不许延长旋律**"。
	#    完整诊断见 `SIM_CHORD_BUDGET` 的常量注释。
	# ★★★ 2026-10-17 第三版：用户口令「琶音太吵了，还是换回齐奏吧，好好调整和弦，让它更和谐就好」
	#    ⇒ ① 的方向**反过来**（从"齐奏 ≤ 1/3"变成"齐奏 == 音数"），并且新增 ④ 音程协和度。
	#    现在四面各自盯一个**互不重叠**的物理量，**四面全过才算过**：
	#      ① 和弦**齐奏**（同时起音数 == 该档和弦音数）—— 这是现在的**意图**，不是缺陷；
	#      ② 和弦**跨不跨小节** —— "糊"的机械原因（`pad_seconds` 比小节还长时会跨）；
	#      ③ 和弦族的**平均**同时发声占初版的比例 —— 守着"别回到 v8 那种长音叠长音"；
	#      ④ 和弦**音程协和度** —— ①②③ 都管不到的第四种坏法：**音选错了**。
	#        一个齐奏的、不跨小节的、量也合格的三个音，照样可以因为小二度/三全音而刺耳
	#        —— 那正是旧代码在最高色彩档做的事（顶音 `+1` 或 `+6`）。
	#    ★★ 测量时把四种技法**临时关掉**（铁律 47：一次只动一个轴）——
	#       否则"降下来"这件事分不清是琶音的功劳还是技法的功劳。技法由判据 ㉝ 单独负责。
	var tt_keep28: Array[float] = [tech_tremolo, tech_gliss, tech_grace, tech_harmonic]
	tech_tremolo = 0.0
	tech_gliss = 0.0
	tech_grace = 0.0
	tech_harmonic = 0.0
	var ax28_c := axes_from_tension(0.0)
	var ax28_t := axes_from_tension(1.0)
	# ① 和弦齐奏：只量 `arp` 族。
	#    ★★★ 2026-10-17 **方向反过来**：旧口径是"每个和弦音各起一次、齐奏数必须 ≤ 1"，
	#    而用户现在要的就是**一起起** ⇒ 断言 `齐奏数 == 该档和弦音数`。
	#    ★ 这不是"把界放宽"那么轻：它还顺手证明了"**每个和弦音都真的发了**"——
	#      调度漏掉一个音时数会变小、立刻红；而旧口径下漏音是**绿**的（少发反而更"不吵"）。
	#    ★ 还断言 `_arp_gap() == 0`（默认速度与最快档都查）：齐奏必须来自"参数默认为 0"，
	#      而不是"某处偷偷把 `at` 抹平"—— 后者会让 `arp_step > 0` 也听不到琶音，是另一种静默。
	#    ★ `on28_flat_*` 保留着当**一致性证据**：`flatten` 只把 `at` 归零，
	#      齐奏下两个口径必须**逐位相同**；不同就说明 `at` 还有残余量。
	var cf_keep28b := clk_follow
	var si_keep28b := _step_idx
	clk_follow = true
	_step_idx = _steps_per_bar() * 3
	_clock_ext_apply({"clk_bpm": clk_bpm_max, "clk_pressure": 0.0})
	var gap28_fast := _arp_gap()
	_bpm_now = 0.0
	clk_follow = cf_keep28b
	_step_idx = si_keep28b
	var on28_c := onset_stats(ax28_c, 8, {}, false, ["arp"])
	var on28_t := onset_stats(ax28_t, 8, {}, false, ["arp"])
	var on28_flat_c := onset_stats(ax28_c, 8, {}, true, ["arp"])
	var on28_flat_t := onset_stats(ax28_t, 8, {}, true, ["arp"])
	var ok28_onset := int(on28_c["max"]) == chord_tones_calm \
		and int(on28_t["max"]) == chord_tones_tense \
		and int(on28_flat_c["max"]) == int(on28_c["max"]) \
		and int(on28_flat_t["max"]) == int(on28_t["max"]) \
		and absf(_arp_gap()) <= 1e-9 and absf(gap28_fast) <= 1e-9
	# ② 跨小节：和弦族的**重叠**峰值。新口径 ≤ `chord_tones_tense`（一小节内响完，
	#    由 `_arp_fit_seconds()` 构造保证），旧口径（时长换 `pad_seconds`）必须跨到下一小节。
	var sim28_arp := simul_stats(ax28_t, 8, {}, false, ["arp"])
	var sim28_arp_flat := simul_stats(ax28_t, 8, {}, true, ["arp"])
	var ok28_cross := int(sim28_arp["max"]) <= SIM_ARP_CROSS \
		and int(sim28_arp_flat["max"]) >= 2 * SIM_ARP_CROSS
	# ③ 和弦族的平均同时发声占初版的比例。解析值 = `_seconds_for_kind("arp") / pad_seconds`
	#    （两条路的事件数与时间窗完全相同 ⇒ 比值直接约掉）。实测必须落在解析值附近，
	#    并且必须**在预算之内** —— 两个不同的东西：解析值说"我算得对"，
	#    预算说"我还没回到 v8 那种长音叠长音"。
	var sim28_c := simul_stats(ax28_c, 8)
	var sim28_t := simul_stats(ax28_t, 8)
	var sim28_flat := simul_stats(ax28_t, 8, {}, true)
	var sim28_arp_mean := simul_stats(ax28_t, 8, {}, false, ["arp"])
	var sim28_arp_mean_flat := simul_stats(ax28_t, 8, {}, true, ["arp"])
	# ④ 和弦**音程协和度** —— 用户「好好调整和弦，让它更和谐」的字面落点。
	#    口径：拿 `_schedule_step()` 的**真实事件**（不重实现调度，铁律 70）：
	#      · 小节头那一族的 `arp` 音两两算音程（模 12，折到 0~6），落在 `CHORD_BANNED_ICS` 即红；
	#      · 再并入**高音区**（≥ 最低和弦音 + 19）的 `note` 事件 —— 也就是"火花"。
	#        为什么要并进来：火花单独响时**不成音程**，但它落在和弦 1.55 秒的余音**之上**，
	#        所以它其实一直在和和弦构成音程。旧代码给它 `+1`/`+6`，正是"吵"的另一半。
	#      · 旋律**整体**不检查：它允许经过音/邻音（大二度、小七度），一起禁掉会得到
	#        一条"永远红"的判据。★ 而且五声音阶内任意两音的音程只可能是
	#        {2,3,4,5,7,8,9,10}，**永远碰不到 1/6/11** ⇒ 旋律进来也不会假红。
	#    ★ 分母必须 > 0：一个和弦都没量到 ⇒ 是调度断线，不是"合格"（铁律 106）。
	#    ★★★ 2026-10-17 修分母口径：和弦只在**小节头**发（`in_bar == 0`），而 `k % spb == 0`
	#      才是小节头。原来写 `range(1, bars28+1)` 只走到**一个小节头**（k=8），于是
	#      `n28_bars` 恒为 1 而断言写的是 `== bars28` ⇒ 判决永远红。
	#      教训：分母判据本身也会"数错人数" —— 扫的**步号**必须换算成**小节头**（× spb），
	#      否则 8 小节的名义覆盖实际只有 1 小节，八个不同的和声度数只量到了一个。
	var bad28_ic: Array[String] = []
	var n28_pairs := 0
	var n28_bars := 0
	var n28_spark := 0
	var bars28 := 8
	var spb28 := maxi(_steps_per_bar(), 1)
	for b28 in range(1, bars28 + 1):
		var chord28: Array[int] = []
		var extra28: Array[int] = []
		for e28 in _schedule_step(b28 * spb28, ax28_t):
			var k28 := str(e28["kind"])
			if k28 == "arp":
				chord28.append(int(e28["midi"]))
			elif k28 == "note":
				extra28.append(int(e28["midi"]))
		if chord28.is_empty():
			continue
		n28_bars += 1
		var lo28: int = chord28[0]
		for m28 in chord28:
			lo28 = mini(lo28, m28)
		for hi28 in extra28:
			if hi28 >= lo28 + 19:
				chord28.append(hi28)
				n28_spark += 1
		for i28 in chord28.size():
			for j28 in range(i28 + 1, chord28.size()):
				var ic28 := absi(chord28[i28] - chord28[j28]) % 12
				ic28 = mini(ic28, 12 - ic28)
				n28_pairs += 1
				if CHORD_BANNED_ICS.has(ic28):
					bad28_ic.append("bar%d %d/%d=ic%d" % [b28, chord28[i28], chord28[j28], ic28])
	var ok28_ic := bad28_ic.is_empty() and n28_pairs > 0 and n28_bars == bars28
	tech_tremolo = tt_keep28[0]
	tech_gliss = tt_keep28[1]
	tech_grace = tt_keep28[2]
	tech_harmonic = tt_keep28[3]
	var ratio28_chord := float(sim28_arp_mean["mean"]) \
		/ maxf(float(sim28_arp_mean_flat["mean"]), 1e-6)
	var ratio28_an := _seconds_for_kind("arp") / maxf(pad_seconds, 1e-6)
	# 全曲新/旧比**不再是判据**（它就是被旋律长度绑架的那个量），只当信息量报出来。
	var info28_mratio := float(sim28_t["mean"]) / maxf(float(sim28_flat["mean"]), 1e-6)
	# ★ 判据名必须写成**从 `[` 后第一个字符就是 `"`** 的单段字面量（不许 `[("…" + "…")`）：
	#   读判据名的仪器（`struct_guard.py::JUDGE_NAME_RX` = `\.append\(\[\s*"([^"]*)"`）
	#   要求 `[` 之后紧跟 `"`，写成 `[("…")` 会让这条判据**在仪器眼里不存在**。
	#   同理名里不许出现全角括号（S26：仪器靠"第一个全角括号之前有没有 ✗"认红行）。
	checks.append(["㉘ 同时发声与和声｜① 和弦齐奏 == 音数 %d/%d｜② 和弦不跨小节 旧口径必跨 ≥ %d｜③ 和弦族均值占初版 ≤ %.2f｜④ 和弦音程禁小二度/大七度/三全音 %d 对"
			% [chord_tones_calm, chord_tones_tense, 2 * SIM_ARP_CROSS,
				SIM_CHORD_BUDGET, n28_pairs],
		ok28_onset and ok28_cross and ratio28_chord <= SIM_CHORD_BUDGET
		and absf(ratio28_chord - ratio28_an) <= 0.03 and ok28_ic,
		"齐奏 %d/%d（flat 口径 %d/%d 须与之逐位相同，错开量 %.3f/%.3f）· 和弦重叠 %d（旧 %d）· 和弦均值 %.2f/%.2f = %.3f（预算 %.2f，解析 %.3f）· 协和度 %d 对/%d 小节（火花 %d，违规 %s）· 全曲均值 %.2f/%.2f = %.3f（信息量，不判）· 全曲峰值 平静%d 张力满%d（旧 %d）· 5ms 网格 %d 点 × 8 小节" % [
			int(on28_c["max"]), int(on28_t["max"]),
			int(on28_flat_c["max"]), int(on28_flat_t["max"]), _arp_gap(), gap28_fast,
			int(sim28_arp["max"]), int(sim28_arp_flat["max"]),
			float(sim28_arp_mean["mean"]), float(sim28_arp_mean_flat["mean"]), ratio28_chord,
			SIM_CHORD_BUDGET, ratio28_an,
			n28_pairs, n28_bars, n28_spark, str(bad28_ic.slice(0, 4)),
			float(sim28_t["mean"]), float(sim28_flat["mean"]), info28_mratio,
			int(sim28_c["max"]), int(sim28_t["max"]), int(sim28_flat["max"]),
			int(sim28_t["grid"])]])

	# ㉙ 特殊时刻**检测**：`_detect_cue()` 是纯函数 ⇒ 可以直接喂两份手写快照来验。
	#    两面都必须有：阳性（`CUE_IDS` 每一类都能被触发）与阴性（该安静时必须安静）。
	#    ★ 只验阳性 ⇒ 一个"永远返回第一个时刻"的实现也能过；
	#      只验阴性 ⇒ 一个永远返回 "" 的实现也能过（那等于乐句系统压根没工作）。
	var cue_base: Dictionary = mk_sit.call(0.0, 0.0, 6, 0, 0)
	var cue_pos28: Array[String] = []
	var c29_end: Dictionary = cue_base.duplicate()
	c29_end["game_over"] = true
	if _detect_cue(cue_base, c29_end) == "end":
		cue_pos28.append("end")
	var c29_cr_a: Dictionary = cue_base.duplicate()
	c29_cr_a["an_crisis"] = cue_crisis_gate - 0.05
	var c29_cr_b: Dictionary = c29_cr_a.duplicate()
	c29_cr_b["an_crisis"] = cue_crisis_gate + 0.05
	if _detect_cue(c29_cr_a, c29_cr_b) == "crisis":
		cue_pos28.append("crisis")
	var c29_cap1: Dictionary = cue_base.duplicate()
	c29_cap1["black_prisoners"] = cue_big_capture
	var c29_cap0: Dictionary = cue_base.duplicate()
	c29_cap0["black_prisoners"] = 1
	if _detect_cue(cue_base, c29_cap1) == "big_capture":
		cue_pos28.append("big_capture")
	if _detect_cue(cue_base, c29_cap0) == "capture":
		cue_pos28.append("capture")
	var c29_dead: Dictionary = cue_base.duplicate()
	c29_dead["an_dead_blocks"] = int(c29_dead["an_dead_blocks"]) + 1
	if _detect_cue(cue_base, c29_dead) == "dead":
		cue_pos28.append("dead")
	var c29_live: Dictionary = cue_base.duplicate()
	c29_live["an_live_blocks"] = int(c29_live["an_live_blocks"]) + 1
	if _detect_cue(cue_base, c29_live) == "life":
		cue_pos28.append("life")
	# 阴性的三面：状态逐字不变 / 空快照（菜单、刚起音乐）/ 危急**停在**闸上方（那不是"越闸"）
	var cue_neg28 := 0
	if _detect_cue(cue_base, cue_base.duplicate()) == "":
		cue_neg28 += 1
	if _detect_cue({}, cue_base) == "" and _detect_cue(cue_base, {}) == "":
		cue_neg28 += 1
	var c29_hi: Dictionary = cue_base.duplicate()
	c29_hi["an_crisis"] = cue_crisis_gate + 0.2
	if _detect_cue(c29_hi, c29_hi.duplicate()) == "":
		cue_neg28 += 1
	checks.append(["㉙ 特殊时刻检测｜纯函数 · %d 类全部能被触发=阳性面｜状态不变/空快照/危急停在闸上必须安静=阴性面"
			% CUE_IDS.size(),
		cue_pos28.size() == CUE_IDS.size() and cue_neg28 == 3,
		"阳性 %s（%d/%d）· 阴性 %d/3" % [
			str(cue_pos28), cue_pos28.size(), CUE_IDS.size(), cue_neg28]])

	# ㉚ 乐句**落点** + 退化档。
	#    · 退化档：`cue = ""` 必须与"压根不传这个参数"逐字相同 ⇒ 旧调用点一个字节都不变
	#      （判据 ⑩/⑳ 与自检里那些 `_schedule_step(k, ax)` 全部依赖这条）；
	#    · 落点：带 cue 的那一步，除去小节头的琶音，**事件集合必须恰好等于**乐句本身
	#      —— 这同时钉住"乐句**取代**旋律"（不是叠上去）。用音高序列逐项对拍，
	#      不用"事件条数多了一个"这种粗口径：条数对得上但音不对是**最坏**的那种静默。
	#    · 音量线：`cue_gain` 翻倍 ⇒ 乐句那部分的增益和必须精确翻倍（旋钮真的接上线了）。
	#
	# ★★★ 2026-10-16（被阴性对照 K14 逼出来的）：落点这一面**必须扫满一小节 × 两档张力**，
	#   不能只看单独一个 `(k=8, tempo=0.4)`。原来的写法只测那一个点，而 K14
	#   （把 cue 分支的 `return evs` 删掉 ⇒ 乐句变成**叠在旋律上**）在那一刻**没咬住**：
	#   那一步的 `density` 抽签恰好没发旋律 ⇒ 事件集合反而"看起来对"。
	#   ⇒ 16 个样本（平静/张力满 × 8 步）里只要有**一个**不等于乐句本身就是红。
	#   ★ 为什么不是"多测几个随机点"：`_schedule_step()` 的 rng 由 `(bar, in_bar)` 播种
	#     ⇒ 每个步号的抽签结果是**确定的**，所以"扫满一小节"比"多抽几点"更强 ——
	#     前者能保证覆盖"这一步到底发不发旋律"的两种情形（一小节里必然两种都有）。
	var ax30 := axes_from_tension(0.4)
	var ev30_plain: Array = _schedule_step(8, ax30)
	var ev30_def: Array = _schedule_step(8, ax30, "")
	# ★★★ 2026-10-17：**必须先把错开总闸拧上去**再验"落点"。
	#   零错开时 `_expand_cue()` 每个 seg 只发落点音（理由见 `stagger_scale` 的注释：
	#   跑动型乐句齐奏 = 音簇、摇指型 = 同音叠加），于是"乐句音"只剩最后一个音，
	#   这条判据会以为"乐句被吃掉了一半"。
	#   ★ 但**不能**只测拧上去的档：零错开那一档也要有自己的判据 —— 那就是 ㊲
	#     （默认态全曲 `at` 恒为 0，且乐句确实还有声音）。两条互补，缺一不可。
	var ss_keep30 := stagger_scale
	stagger_scale = 1.0
	var ev30_cue: Array = _schedule_step(8, ax30, "capture")
	var want30: Array = []
	for e in _cue_events("capture"):
		want30.append(int(e["midi"]))
	var got30: Array = []
	var n_arp30 := 0
	# ★ 2026-11-05 第四轮：口径是「除**伴奏床**外恰好是乐句本身」。伴奏床 = 小节头
	#   和弦 `arp` + 低音勾托 `bass`：两者都在 `cue` 取代**之前**发出，都不属于乐句。
	#   低音层是后加的，不排除的话 `cue_gain` 翻倍那一面也会红（分母混进了不乘
	#   `cue_gain` 的 bass 增益）⇒ 红得指错地方。`--bass=0` 时这些条件全是空操作（§111）。
	var g30_sum := func(evs: Array) -> float:
		var s := 0.0
		for e in evs:
			var kd30s := str(e["kind"])
			if kd30s != "arp" and kd30s != "bass":
				s += float(e["gain"])
		return s
	for e in ev30_cue:
		var kd30 := str(e["kind"])
		if kd30 == "arp":
			n_arp30 += 1
		elif kd30 != "bass":
			got30.append(int(e["midi"]))
	var lit30_bad: Array[String] = []
	var n_lit30 := 0
	for t30 in [0.0, 1.0]:
		var ax30s := axes_from_tension(t30)
		for k30 in range(1, _steps_per_bar() + 1):
			var g30: Array = []
			for e in _schedule_step(k30, ax30s, "capture"):
				var kd30l := str(e["kind"])
				if kd30l != "arp" and kd30l != "bass":
					g30.append(int(e["midi"]))
			n_lit30 += 1
			if str(g30) != str(want30):
				lit30_bad.append("t=%.1f k=%d 实%s" % [t30, k30, str(g30)])
	var cg_keep30 := cue_gain
	cue_gain = cg_keep30 * 2.0
	var g30_double := float(g30_sum.call(_schedule_step(8, ax30, "capture")))
	cue_gain = cg_keep30
	var g30_base := float(g30_sum.call(ev30_cue))
	stagger_scale = ss_keep30
	checks.append(["㉚ 乐句落点｜cue=\"\" 与不传参**逐字相同**=退化档｜平静/张力满 × 一小节 8 步，带 cue 的每一步除**伴奏床**(arp/bass)外必须恰好是乐句本身=旋律被**取代**而不是叠加｜cue_gain 翻倍 ⇒ 乐句增益精确翻倍",
		str(ev30_plain) == str(ev30_def) and want30.size() >= 3
			and lit30_bad.is_empty() and n_lit30 == 2 * _steps_per_bar()
			and str(want30) == str(got30) and n_arp30 >= 1
			and g30_base > 0.0 and absf(g30_double - g30_base * 2.0) <= 1e-6,
		"退化档一致=%s · 落点 %d 个样本全中=%s（问题 %s）· 乐句音 %s（期望 %s）· 琶音 %d 个 · 乐句增益 %.4f→%.4f（期望 %.4f）" % [
			str(str(ev30_plain) == str(ev30_def)), n_lit30, str(lit30_bad.is_empty()),
			str(lit30_bad.slice(0, 3)), str(got30), str(want30), n_arp30,
			g30_base, g30_double, g30_base * 2.0]])

	# ㉛ 乐句库**结构**（"乐句库能不能被信任"的前提）。
	#    · 每套曲风都必须定义**每一个** `CUE_IDS`（少一个 ⇒ 那个时刻静默不出声）；
	#    · `at` 数组长度必须与音数相等（不等 ⇒ 多出来的音掉到 at = 0，乐句听感错位）；
	#    · `deg` / `semi` 必须**恰好有一个**；`kind` 必须在已知音族里；
	#    · ★★ **互补两面**：`deg` 展开出来的音必须在音阶**上**，`semi` 展开出来的音必须在
	#      音阶**外**。这两条合起来才是 `semi` 这个记号存在的全部意义
	#      （古筝的"苦音/按音"就是**故意**把音按出音阶）。只验一面就是恒真式。
	#    ★ 阶内/阶外这面**逐曲风切 `style_id` 再判**：`pent_at()` 读的是当前曲风，
	#      切过去之后判据与被测物参考的就是同一套音阶 —— 而且这顺便又证明了"换 id 真的换音阶"。
	var cue_bad31: Array[String] = []
	var n_seg31 := 0
	var n_semi31 := 0
	var kinds_ok31 := ["note", "pad", "orn", "arp", "tick"]
	var sid_keep31 := style_id
	for sid31 in STYLE_IDS:
		var sid_s31 := String(sid31)
		style_id = sid_s31
		var bank31: Dictionary = style_table()[sid_s31].get("cues", {})
		var wset31 := {}
		for v31 in (style_table()[sid_s31]["scale"] as Array):
			wset31[int(v31)] = true
		for cq31 in CUE_IDS:
			var cq_s31 := String(cq31)
			if not bank31.has(cq_s31):
				cue_bad31.append("%s 缺 %s" % [sid_s31, cq_s31])
				continue
			for seg31 in (bank31[cq_s31] as Dictionary).get("segs", []):
				n_seg31 += 1
				var has_deg: bool = (seg31 as Dictionary).has("deg")
				var has_semi: bool = (seg31 as Dictionary).has("semi")
				var degs31: Array = (seg31 as Dictionary).get("deg", [])
				var semis31: Array = (seg31 as Dictionary).get("semi", [])
				var ats31: Array = (seg31 as Dictionary).get("at", [])
				## ★★ 2026-11-03：`steps` = "第几个古筝步起音"（钟的小旋律用它，与 BPM 同步）。
				##   它与 `at`（秒）**同义二选一**：两个都写就是两个时间基准打架，
				##   只能是其中一个是死参数（§33 死参数 = 旋钮拧不动）。
				var sts31: Array = (seg31 as Dictionary).get("steps", [])
				var nn31 := maxi(degs31.size(), semis31.size())
				if has_deg == has_semi:
					cue_bad31.append("%s/%s：deg 与 semi 必须恰好有一个" % [sid_s31, cq_s31])
					continue
				if not sts31.is_empty():
					if not ats31.is_empty():
						cue_bad31.append("%s/%s：at 与 steps 只能有一个" % [sid_s31, cq_s31])
					if sts31.size() != nn31:
						cue_bad31.append("%s/%s：steps %d 个 vs 音 %d 个" % [
							sid_s31, cq_s31, sts31.size(), nn31])
					for i31s in sts31.size():
						if float(sts31[i31s]) < 0.0:
							cue_bad31.append("%s/%s：steps 出现负数" % [sid_s31, cq_s31])
							break
				elif ats31.size() != nn31:
					cue_bad31.append("%s/%s：at %d 个 vs 音 %d 个" % [
						sid_s31, cq_s31, ats31.size(), nn31])
				if not kinds_ok31.has(str((seg31 as Dictionary).get("kind", "note"))):
					cue_bad31.append("%s/%s：kind 非法" % [sid_s31, cq_s31])
				for i31 in nn31:
					var m31: int = root_midi + 12 + (pent_at(int(degs31[i31])) if has_deg
						else int(semis31[i31]))
					var inset31: bool = wset31.has((((m31 - root_midi) % 12) + 12) % 12)
					if has_semi:
						n_semi31 += 1
						if inset31:
							cue_bad31.append("%s/%s：semi %d 竟落在音阶内" % [
								sid_s31, cq_s31, int(semis31[i31])])
					elif not inset31:
						cue_bad31.append("%s/%s：deg %d 落在音阶外" % [
							sid_s31, cq_s31, int(degs31[i31])])
	style_id = sid_keep31
	# ★★ 判据名里的格式化必须**不留拼接**（与 ㉘ 同款纪律）：GDScript 里 `%` 的优先级高于 `+`，
	#   写成 `"A" + "B" % n` 会变成 `"A" + ("B" % n)` —— 只格式化后半段，
	#   前半段的 `%d` 原样留在判据名里（实测：本行曾印出字面的 `全部 %d 个时刻`）。
	#   而一旦改成 `("A" + "B") % n` 去补救，`[` 后面就不是 `"` 了 ⇒ 判据名对仪器隐形。
	#   ⇒ 唯一两全的写法是**单段字面量 + `%`**（本行现在就是）。
	#   ★ 这一条与铁律 112 同族（判据名是仪器读的东西，写坏了仪器就切不出来），
	#     区别在于 112 是 `✓/✗` 的位置，这里是格式化的作用面。
	checks.append(["㉛ 乐句库结构｜每套曲风都定义全部 %d 个时刻｜at 与音数相等｜deg/semi 恰好有一个｜kind 合法｜**deg 必在阶内 · semi 必在阶外**=互补两面"
			% CUE_IDS.size(),
		cue_bad31.is_empty() and n_seg31 >= CUE_IDS.size() and n_semi31 >= 1,
		"%d 段（含 %d 个 semi 偏音）· 问题 %s" % [
			n_seg31, n_semi31, str(cue_bad31.slice(0, 4))]])

	# ㉜ 曲风注册表 —— "留好余地"这件事必须**可判**，否则它只是一句装饰。三面：
	#    ① 每个 id 都能解析出完整定义（name / scale / progs / cues 四件齐全）；
	#    ② 非法 id **必须回退**（回退到的还得是"表里第一项"，而不是 null / 崩溃）；
	#    ③ ★★ **换 id 必须真的换声**。这一面是关键：表里只有一套曲风时，
	#       "两套曲风声音不同"这个断言的分母是 0（一条恒真式，比没有判据更坏：它假装验过了）。
	#       所以这里**注入一套临时的两曲风表**（`_style_table_override`，与 `--musiccontract=`
	#       同款：存在的唯一理由就是让判据有牙），断言同一个 `k` 在两个 id 下**四个出口全都不同**
	#       —— 事件表 / 音阶 / 和声度数 / 乐句。有谁绕过 `style_table()` 直接读 `STYLES`，这里当场红。
	var style_bad32: Array[String] = []
	for sid32 in STYLE_IDS:
		var d32: Dictionary = style_table()[String(sid32)]
		for fld32 in ["name", "scale", "progs", "cues"]:
			if not d32.has(String(fld32)):
				style_bad32.append("%s 缺 %s" % [String(sid32), String(fld32)])
	var sid_keep32 := style_id
	var warn_keep32 := _style_warned
	style_id = "__no_such_style__"
	var fb_ok32: bool = str(_style().get("scale", [])) == str(scale_lit[String(STYLE_IDS[0])])
	style_id = sid_keep32
	_style_warned = warn_keep32
	var cue_seg := {"segs": [{"deg": [0], "at": [0.0], "kind": "note", "gain": 0.40}]}
	var cue_seg_b := {"segs": [{"deg": [4], "at": [0.0], "kind": "note", "gain": 0.40}]}
	_style_table_override = {
		"aaa": {"name": "注入A", "scale": [0, 2, 4, 7, 9], "progs": [[0, 2, 0, 2]],
			"cues": {"capture": cue_seg}},
		"bbb": {"name": "注入B", "scale": [0, 1, 5, 7, 8], "progs": [[1, 3, 1, 3]],
			"cues": {"capture": cue_seg_b}},
	}
	var memo32 := style_id
	style_id = "aaa"
	var ev32_a: Array = _schedule_step(8, axes_from_tension(0.0))
	var sc32_a: Array = style_scale()
	var hg32_a := int(_harmony_for_bar(0, 0.0)["deg"])
	var cu32_a: Array = _cue_events("capture")
	style_id = "bbb"
	var ev32_b: Array = _schedule_step(8, axes_from_tension(0.0))
	var sc32_b: Array = style_scale()
	var hg32_b := int(_harmony_for_bar(0, 0.0)["deg"])
	var cu32_b: Array = _cue_events("capture")
	_style_table_override = {}
	style_id = memo32
	var swap32: bool = str(ev32_a) != str(ev32_b) and str(sc32_a) != str(sc32_b) \
		and hg32_a != hg32_b and str(cu32_a) != str(cu32_b)
	checks.append(["㉜ 曲风注册表｜每套曲风四件齐全 name/scale/progs/cues｜非法 id 必须回退到表里第一项"
			+ "｜**换 id 必须真的换声**（注入两曲风表：事件/音阶/和声/乐句四个出口全都要变）",
		style_bad32.is_empty() and fb_ok32 and swap32,
		"曲风 %d 套 · 缺件 %s · 回退=%s｜注入两曲风：事件%s 音阶%s 和声%s 乐句%s" % [
			STYLE_IDS.size(), str(style_bad32), str(fb_ok32),
			str(str(ev32_a) != str(ev32_b)), str(str(sc32_a) != str(sc32_b)),
			str(hg32_a != hg32_b), str(str(cu32_a) != str(cu32_b))]])

	# ㉝ 古筝技法：**四个旋钮各自有牙**，而且**必须挂在同一个旋律槽上**。
	#    ★ 做法是"同一步号的受控 A/B"：先扫出一个"确实有旋律槽"的步号（四技法全关时，
	#      该步的非伴奏事件恰好 1 个 `note`），然后**只改一个**技法旋钮、用**同一个 k**
	#      再调度一次 —— 随机种子一样 ⇒ 抽到的是同一个度数、同一个八度、同一个 `roll`，
	#      唯一的变量就是技法。这比"各扫 4 小节再比较统计量"干净得多（后者噪声大）。
	#    · 摇指 ⇒ 出现**同音反复** ≥3 次；
	#    · 刮奏 ⇒ 出现**严格递增**的一串 ≥3 个音，且最后一个音 == 随后的旋律音；
	#    · 倚音 ⇒ 出现"一个先响的音 + 一个更晚响的更高的音"（阶上邻音 ⇒ 高一个音阶度）；
	#    · 泛音 ⇒ 出现一个比旋律音**高 `harm_oct`** 的音。
	#    ★★ 阴性面（同样重要）：四技法全关 ⇒ 扫过的每一步的非伴奏事件**最多 1 个**。
	#      少了这一面，一个"技法恒定乱加音"的实现照样能满足上面四条
	#      （它每样都能找到形态符合的例子），而"技法把密度偷偷抬上去"正是要防的那个 bug。
	#    样本取**多个步号**：单个步号可能恰好"没有旋律槽"（`density` 是概率），
	#    那时四条阳性的分母是 0 —— 判据会变成恒真。所以先扫出真正有槽的那些步。
	var tt_keep33: Array[float] = [tech_tremolo, tech_gliss, tech_grace, tech_harmonic]
	# ★★★ 2026-10-17「怎么还有琶音，都去掉」：**先把错开总闸拧上去**再验技法。
	#   零错开时四技法**整体不出场**（倚音零错开 = 小二度、摇指 = 4 个同音叠加、
	#   刮奏 = 音簇，见 `stagger_scale` 的注释）⇒ 四条阳性面会全都没有分母。
	#   ★ 这条与 ㊲ 互补：这里验"拧上去之后技法真的在"，㊲ 验"默认态一个错开都没有"。
	#     两条合起来才是"技法没被删掉，只是默认不出场"。
	var ss_keep33 := stagger_scale
	stagger_scale = 1.0
	tech_tremolo = 0.0
	tech_gliss = 0.0
	tech_grace = 0.0
	tech_harmonic = 0.0
	var ax33 := axes_from_tension(0.5)
	var spb33 := maxi(beats_per_bar * maxi(subdiv, 1), 1)
	var probe33 := -1
	var neg33_worst := 0
	for k33 in range(1, 4 * spb33 + 1):
		var mel33: Array = []
		for e in _schedule_step(k33, ax33):
			var kd33 := str(e["kind"])
			# ★ 2026-11-05 第四轮：低音勾托是**伴奏族**，与 arp/tick/pad 并列排除。
			#   不排除的话「四技法全关 ⇒ 每步非伴奏事件最多 1 个」会恒为 2，而探针
			#   还会挑到没有低音的那一步 ⇒ 这条判据既不红也不再验它该验的东西。
			if kd33 != "arp" and kd33 != "tick" and kd33 != "pad" and kd33 != "bass":
				mel33.append(e)
		neg33_worst = maxi(neg33_worst, mel33.size())
		# 泛音有 `HARM_CEIL` 上限 ⇒ 探针必须是"这个音高之上还允许泛音"的那一步，
		# 否则阳性第 4 条的分母是 0（判据会假红，而不是发现缺陷）。
		if probe33 < 0 and mel33.size() == 1 and str(mel33[0]["kind"]) == "note" \
				and int(mel33[0]["midi"]) + int(_fnum(style_tech().get("harm_oct"), 12.0)) <= HARM_CEIL:
			probe33 = k33
	var tm33 := false
	var gl33 := false
	var gr33 := false
	var hm33 := false
	var tm33_txt := "无探针"
	if probe33 > 0:
		tech_tremolo = 1.0
		var ev33_tm: Array = _schedule_step(probe33, ax33)
		tech_tremolo = 0.0
		var tm_n := 0
		var tm_first := -999
		var tm_same := true
		for e in ev33_tm:
			if str(e["kind"]) == "orn":
				tm_n += 1
				if tm_first == -999:
					tm_first = int(e["midi"])
				elif int(e["midi"]) != tm_first:
					tm_same = false
		tm33 = tm_n >= 3 and tm_same
		tm33_txt = "摇指 %d 次同音=%s" % [tm_n, str(tm_same)]
		tech_gliss = 1.0
		var ev33_gl: Array = _schedule_step(probe33, ax33)
		tech_gliss = 0.0
		var gl_notes: Array[int] = []
		var gl_tail := -999
		for e in ev33_gl:
			if str(e["kind"]) == "orn":
				gl_notes.append(int(e["midi"]))
			elif str(e["kind"]) == "note":
				gl_tail = int(e["midi"])
		var gl_inc: bool = gl_notes.size() >= 3
		for i33 in range(1, gl_notes.size()):
			if gl_notes[i33] <= gl_notes[i33 - 1]:
				gl_inc = false
		gl33 = gl_inc and gl_tail == gl_notes[gl_notes.size() - 1]
		tech_grace = 1.0
		var ev33_gr: Array = _schedule_step(probe33, ax33)
		tech_grace = 0.0
		var gr_first := -999
		var gr_last := -999
		var gr_first_at := 9.9
		var gr_last_at := -9.9
		for e in ev33_gr:
			if str(e["kind"]) == "note" or str(e["kind"]) == "orn":
				var at33 := float(e.get("at", 0.0))
				if at33 <= 0.0:
					gr_first = int(e["midi"])
					gr_first_at = at33
				else:
					gr_last = int(e["midi"])
					gr_last_at = at33
		gr33 = gr_first != -999 and gr_last != -999 and gr_last > gr_first \
			and gr_last_at > gr_first_at
		tech_harmonic = 1.0
		var ev33_hm: Array = _schedule_step(probe33, ax33)
		tech_harmonic = 0.0
		var hm_note := -999
		var hm_hi := -999
		for e in ev33_hm:
			if str(e["kind"]) == "note":
				hm_note = int(e["midi"])
			elif str(e["kind"]) == "orn":
				hm_hi = int(e["midi"])
		hm33 = hm_note != -999 and hm_hi == hm_note + int(_fnum(style_tech().get("harm_oct"), 12.0))
	tech_tremolo = tt_keep33[0]
	tech_gliss = tt_keep33[1]
	tech_grace = tt_keep33[2]
	tech_harmonic = tt_keep33[3]
	stagger_scale = ss_keep33
	checks.append(["㉝ 古筝技法｜同一步号受控 A/B=只动一个旋钮｜摇指=同音反复≥3｜刮奏=严格递增且落在旋律音上"
			+ "｜倚音=先低后高且后者更晚｜泛音=高一个 `harm_oct`｜**四技法全关 ⇒ 每步非伴奏事件最多 1 个**",
		probe33 > 0 and tm33 and gl33 and gr33 and hm33 and neg33_worst <= 1,
		"探针第 %d 步 · %s · 刮奏=%s · 倚音=%s · 泛音=%s · 全关时最大非伴奏事件 %d 个" % [
			probe33, tm33_txt, str(gl33), str(gr33), str(hm33), neg33_worst]])

	# ㉞ `at` 折算**同源**（在线与离线逐采样等价）。
	#    ★★ 这一条把"在线听是琶音、验收 wav 里却是齐奏"那类**静默分家**变成可断言的事实：
	#      · `at = 0` ⇒ `voice_pcm()` 必须**原样**返回 `pluck_pcm()`（逐位相同 ⇒ 旧路径零变化）；
	#      · `at > 0` ⇒ 前面正好 `round(at*sr)` 个 0，其后逐位等于 `at = 0` 的那份；
	#      · 在线取流的**字节长度** == 2×(静音 + 本体) ⇒ 在线真的用了同一套折算
	#        （光看 PCM 函数对是不够的：`wav_for()` 忘了把 `at` 传下去同样会静默分家）。
	# ★★★ 2026-10-29：这条判据的基准是**古筝路径**（`voice_pcm` 必须原样返回 `pluck_pcm`）。
	#   它是「at 折算机制」的契约，不是「当前乐器」的契约。当前乐器一旦不是古筝
	#   （`--instrument=erhu` 或设置页选了笛子），`voice_pcm` 走的是别的引擎
	#   ⇒ 这一面**必然**假红，而它红得完全正确、却指错了地方。
	#   ⇒ 量之前把乐器钉在古筝、量完还原。★ 别改成"当前乐器不是古筝就跳过"：
	#     那就变成静默少跑（§138），而这里钉住之后**每一档都还是真的在量**。
	var ins_keep34 := instrument_id
	instrument_id = "guzheng"
	## ★★★ 2026-11-05：第三个「不是本条契约」的干扰项 —— 古筝·韵。
	##   韵改的是 **note 的波形**，而 ㉞ 量的是 **at 折算机制**（前置静音长度与逐采样等价）。
	##   开档时 `v34_0` 已被按滑重采样 ⇒ 与 `pluck_pcm` 不再逐位相同 ⇒ 假红且指错地方。
	##   ⇒ 量之前把韵关掉、量完还原（同「钉乐器」的做法，不是跳过判据，每一档仍真在量）。
	var yun_keep34 := yun_enabled
	yun_enabled = false
	var v34_0 := voice_pcm(69, "note", 0.0)
	var v34_raw := pluck_pcm(midi_to_freq(69), note_seconds, brightness)
	# ★★★ 2026-10-17：出货默认 `arp_step = 0`（齐奏）⇒ `_arp_gap() == 0` ⇒ 下面量到的静音长度
	#   是 **0 个采样**，于是"前 0 个采样全 0"是**空真**，`pad34 > 0` 当场报红（§106：有效分母=0
	#   必须报红，这条红是对的 —— 它逮到的正是"分母没了"）。
	#   但这条判据验的是**折算机制**，不是出货默认值：用户随时可以把 `arp_step` 拧回去，
	#   那时"在线听是琶音、验收 wav 里却是齐奏"的分家必须仍然被挡住。
	#   ⇒ 这里**显式把旋钮拧到 1 步**再量（分母恒 ≥ 1 个采样），量完还原；
	#     同时保留一面"默认值下 gap 恰好 0" ⇒ 有人若想"反正默认是 0"把整条折算路径删掉，
	#     这一面会红（它读的是还原后的 `_arp_gap()`，不是常数）。
	var as_keep34 := arp_step
	var ss_keep34 := stagger_scale
	arp_step = 1.0
	# ★ 2026-10-17：`_arp_gap()` 现在还会乘 `stagger_scale`（错开总闸）⇒ 两个旋钮**都**要拧，
	#   否则错开量仍是 0、"静音 0 采样"的空真又回来了（同一个坑的第二次）。
	stagger_scale = 1.0
	# ★ 取样的错开量走 `_arp_gap()`（**调度真正用的那个数**）而不是随手一个常数：
	#   随手给一个数就只能证明"传下来的 `at` 被折对了"，证明不了"调度传的就是这个数"。
	var at34 := _arp_gap()
	var pad34 := int(round(at34 * float(maxi(sample_rate, 8000))))
	var v34_sh := voice_pcm(69, "note", at34)
	var same34: bool = v34_0.size() == v34_raw.size()
	for i34 in v34_0.size():
		if v34_0[i34] != v34_raw[i34]:
			same34 = false
			break
	var zero34: bool = v34_sh.size() == pad34 + v34_0.size()
	for i34 in mini(pad34, v34_sh.size()):
		if v34_sh[i34] != 0.0:
			zero34 = false
			break
	var tail34: bool = v34_sh.size() == pad34 + v34_0.size()
	for i34 in v34_0.size():
		if i34 + pad34 >= v34_sh.size() or v34_sh[i34 + pad34] != v34_0[i34]:
			tail34 = false
			break
	var w34 := wav_for(69, "note", at34)
	var bytes34: bool = w34 != null and w34.data.size() == 2 * v34_sh.size()
	arp_step = as_keep34
	stagger_scale = ss_keep34
	instrument_id = ins_keep34
	yun_enabled = yun_keep34
	# 默认值那一面：还原后错开量必须**恰好**为 0（齐奏是这一轮的用户口令，不是"忘了配"）。
	var gap34_def := _arp_gap()
	var def34: bool = absf(gap34_def) <= 1e-9
	checks.append(["㉞ at 折算同源｜at=0 必须逐位等于 pluck_pcm=旧路径零变化｜at>0 前 %d 采样全 0 且其后逐位相同"
			% pad34
			+ "｜在线取流的字节长度 == 2×(静音+本体)｜旋钮拧到1步实测且默认值下错开量恰为0"
			+ "｜漏了它就是「在线琶音、验收 wav 齐奏」的静默分家",
		same34 and zero34 and tail34 and bytes34 and pad34 > 0 and def34,
		"at=0 逐位相同=%s · 静音 %d 采样全零=%s · 尾部逐位相同=%s · 流 %d 字节（期望 %d）"
			% [str(same34), pad34, str(zero34), str(tail34),
				w34.data.size() if w34 != null else -1, 2 * v34_sh.size()]
			+ " · 实测错开量 %.4fs（旋钮=1 步，还原后 %.4fs 须为 0）" % [at34, gap34_def]])

	# ㊱ 曲子的**疏密**：一头管太稀疏（用户口令「我感觉留白太多，尽量把音符延长解决」），
	#    一头管太挤（"延长"拧过头就变成上一轮用户抱怨的"糊"）。
	#
	# ★★★ 为什么"留白"必须是一条判据而不是一句感觉：它本来就是个**可量**的东西 ——
	#    `simul_stats()` 新加的 `silent`（一个声部都没有的时长占比）与 `gap`（最长连续静默秒）。
	#    "我感觉留白太多"如果不落成一个数，那这一轮改完就只剩"我觉得好点了"，下一轮谁也说不清。
	# ★★ 必须量**平静档**：`density_calm = 0.22` 且 `rhythm_stride_calm = 2`
	#    ⇒ 每小节只有 4 个发声音的机会，留白全在这里；张力满档每步都有机会（`stride = 1`、
	#    `density = 0.68`），在那儿量留白会得到一条永远绿的假牙
	#    （铁律 4：判据要跑在会出问题的那一档）。
	# ★★★ 四条面各自对应一个**独立**的坏法（①②是"留白到底多不多"，③是"停得久不久"，
	#    ④是"别延长过头反过来把上一轮的口径破掉"）：
	#    ① **绝对界** `SILENT_CALM_MAX = 0.15`：含义是一句人能听懂的话 ——
	#       **"至少 85% 的时间得有声音"**。
	#    ② **配对界** `SILENT_HEARD_KEEP = 0.70`：必须比用户抱怨的那一版**再少 30%**。
	#       ★ 用相对量是为了不依赖某个特定窗口下的绝对值（见下面"窗口必须够长"一段）。
	#    ③ **最长静默 ≤ 一小节**：占比合格、但"一停就停一整个小节"照样是"留白太多"，
	#       而且那正是用户说「削弱了节奏」时听到的东西之一（拍感断了）。
	#    ④ **旋律族不许延长到糊**（绝对界 `SIM_MELODY_MAX`，外加元断言：
	#       界必须严于"把 `note_seconds` 拉到 export 上限 6.0s"的**当场实测**）。
	#       ★★ 这一面在 2026-10-17 换了口径，理由必须留下：它原来是"整曲同时发声 ≤ 初版口径"，
	#       而 v8 正是用户说「听起来有点吵」的那一版 —— 界本身没错。但本轮口令
	#       「所有音都适当延长一点」与它**方向相反**（延长 ⇔ 更挤），两条都是用户亲口要的，
	#       后到的赢。★ 换的时候差点犯第二个错：`flatten` 只还原和弦、旋律仍读当前
	#       `note_seconds`，我第一次只把 `note_seconds` 拨回 v8 ⇒ 参照物另一半（和弦按
	#       `pad_seconds` 读）跟着 4.0→4.8 漂了，界从 6.49 **静默放宽**到 7.17
	#       （放宽不喊，比报红危险）⇒ 两个参数都钉死后参照物才回到不变量 6.49。
	#       ★ 钉死之后真相出来了：整曲均值 6.98 **确实**高于 v8 的 6.49 ——
	#       也就是说"延长"这件事真的让整曲比 v8 挤了 7.6%。这不是 bug，是口令的代价；
	#       但"整曲均值"不能当界（它的主成分就是被点名要拉的旋律长度 ⇒ 拿输入判输入，
	#       正是 §119 的另一副面孔）。⇒ 界改成"旋律族延长到什么程度算糊"的绝对量，
	#       和弦族的界留在 ㉘③（预算 + 解析值对账），两族各一处，不重复设界。
	#
	# ★★★ ①②里的那个"界"必须落在"当前实测"与"用户抱怨的那一版实测"**之间**才叫有牙齿：
	#    落在上边两条都绿（判据恒真），落在下边两条都红（判据变噪声）。
	#    我**不**把这个"落在中间"写成注释里的承诺 —— 它由**元断言**当场把住：
	#      `SILENT_CALM_MAX < st36_heard["silent"]`
	#    这一条是非有不可的：声部数、`step_seconds()`、`density_*` 任何一项一调，
	#    两个实测值都会动，而没有元断言的绝对界会**静默**地漂成恒真/恒假。
	#
	# ★★★ 面④ 由"实测对**解析模型**"改成"实测对**实测**"，理由必须记下来：
	#   最初那版拿 `spb × (density + SPARK_CHANCE)` 当解析的事件条数，而实测只有它的约 70%
	#   （细节行的 `note` 与"期望"两个数就是为这件事准备的）。
	#   ★★ 我当时**误判成"随机源有偏"**（依据是"每步 `rng.seed = 小整数` 之后头两次 `randf()`
	#      可能打在密度闸与火花闸上"），还据此写了一版种子混合函数 `_mix64()` 并把它焊进
	#      `_schedule_step()`。**这个诊断是错的，改动已撤回。** 证据 = 独立探针工程铺到
	#      **4096 个种子**：`randf() < 0.68` 的比例 **0.6792**（期望 0.6800）、
	#      同小节内步与步**独立**（方差 1.7601 vs 独立 1.7408；连续段数 1783 = 1783）。
	#      真因是**判据窗口太短**（见下一段），这 39/64 只是"一次 −2σ 抽样"。
	#   ⇒ 与其维护一个我不完全理解、还得给它配余量的模型，不如把命题写成它本来该有的样子：
	#     **同一把尺子量两次**（铁律 16：配对优于跨样本）。配对还有一个额外好处 ——
	#     它对"这一步到底发了几条"完全不敏感 ⇒ 以后动随机源也不会让它漂。
	#
	# ★★ 技法照 ㉘ 一样**临时关掉**（铁律 47：一次只动一个轴）—— 技法只会**加**音
	#    ⇒ 关掉之后量到的留白是**悲观**的一侧，判据因此更严，不会漏。
	# ★★★ 窗口必须**够长**：一开始用 8 小节，量到平静档静默 0.284、张力满档 64 步只有 39 个音
	#   事件，据此差点得出"随机源有偏"的错误结论。查到底之后才发现 8 小节窗口
	#   （平静档只有 32 个发声槽位）的抽样噪声约 ±0.07 ⇒ **判据自己在漂**
	#   （完整对拍见 `_schedule_step()` 里那段"查过但结论是不用改"的注释）。
	#   ⇒ 改用 **32 小节**：平静档槽位 ×4、张力满档事件 ×4，抽样噪声减半。
	#   ★ 这不改判据的**内容**，只改它的**精度** —— 而且方向是让界更难糊过去
	#     （正因为窗口短才出现"看起来变稀了"的假象）。
	const BARS36 := 32
	# ★★★ 2026-11-05 第四轮：低音勾托层是**新的、正交的一层**，本判据整段把它关掉。
	#   理由不是「怕它红」，是 ㊱ 的三档参照物（new / 用户抱怨的 v8 / 初版口径）
	#   全都生成于「**没有低音层**」的口径下：低音每小节一个、余音 2.4s，会把
	#   `active[]` 填掉 ⇒ 连 v8 那一档也不再静默 ⇒ 元断言
	#   `SILENT_CALM_MAX < st36_heard["silent"]` 会红，但红的是「参照物不再是 v8」，
	#   不是「曲子变挤了」。§110：参照物不许与被测物同源；§47：一次只动一个轴。
	#   ⇒ 与上面「临时关技法」同一条纪律。低音层由判据 ㊻ 单独守。
	#   `--bass=0` 时这一对开关是空操作 ⇒ 新口径在旧工况逐项退化成旧式（§111）。
	var be_keep36 := bass_enabled
	bass_enabled = false
	var tt_keep36: Array[float] = [tech_tremolo, tech_gliss, tech_grace, tech_harmonic]
	tech_tremolo = 0.0
	tech_gliss = 0.0
	tech_grace = 0.0
	tech_harmonic = 0.0
	var ax36_c := axes_from_tension(0.0)
	var ax36_t := axes_from_tension(1.0)
	var spb36 := float(_steps_per_bar())
	var bar36 := spb36 * step_seconds()
	var st36_new := simul_stats(ax36_c, BARS36)
	# 面①②的对照档 = **用户听过并抱怨的那一版**（v8）：`note_seconds = 1.6` + `arp_seconds = 1.5`。
	# ★★ 为什么这里要用**实测对实测**的配对，而不是把上一轮那次测量写成常量：
	#   同一个参数在 **8 小节**窗口上量到 0.284，在 **32 小节**窗口上只有 0.18 ——
	#   差了一半。窗口一变，写死的常量就成了假话。
	#   ⇒ 参照物每次**当场量**（只用参数把它拨回 v8 的样子），判据才不会随窗口漂。
	# ★★★ 2026-10-17 **第二次修**（同一类毛病的另一半）：`flatten` 把和弦按 `pad_seconds` 读，
	#    而 `pad_seconds` 这一轮被「所有音都适当延长一点」抬到了 4.8 ⇒ 参照物**又**跟着被测参数
	#    动了，只不过这次动的是和弦那一口：实测 6.49 → **7.17**。
	#    这一动是**静默放宽界**（7.17 比 6.49 松），比报红危险得多 —— 红会喊，放宽不喊。
	#    ⇒ 和弦那一侧也必须钉回 `PAD_SECONDS_V8`。参照物现在是**逐项**都由 `*_V8` 常量构成的
	#      不变量：旋律 `NOTE_SECONDS_V8` + 和弦 `PAD_SECONDS_V8` + 错开量 0。
	#    ★ 记法（§119）：凡"参照物 = 用参数拨回去"的判据，**每一个**参与读取的参数都要点名钉住；
	#      只钉一半，另一半就会随口令漂，而漂的方向通常是**变松**。
	var nt_keep36 := note_seconds
	var ap_keep36 := arp_seconds
	var pd_keep36 := pad_seconds
	note_seconds = NOTE_SECONDS_V8
	arp_seconds = ARP_SECONDS_V8
	var st36_heard := simul_stats(ax36_c, BARS36)
	# ★ 诊断量（**不判**）：**只**把 `note_seconds` 压回 v8、和弦保持现状。
	#   它把"延长旋律"与"缩短和弦余音"两根杠杆**分开**——不然两个数一起退回去，
	#   谁在管留白就永远看不出来。
	# ★★ 实测（32 小节）三个数摆在一起，结论与**直觉相反**，必须记下来：
	#     现在（note 2.4 + arp 1.30）静默 **0.102**
	#     只退 note（1.6 + 1.30）     静默 **0.186**   ⇒ 旋律那一口 = **−0.084**
	#     两根都退（1.6 + 1.50）       静默 **0.169**   ⇒ 和弦那一口 = **+0.017**（**反向**）
	#    ⇒ 用户口令「尽量把音符延长解决」**打在点子上**：旋律长度是**主**杠杆（−0.084）。
	#    ⇒ 但和弦余音那根是**反着**的：和弦越长、覆盖面越大 ⇒ 静默越**少**。
	#      所以这一轮"缩短和弦余音"其实**略微增加了**留白（+0.017），
	#      靠延长旋律（−0.084）才净赚 −0.067。★ 这条不写下来，
	#      下次有人为了"少吵一点"再去砍 `arp_seconds`，就会莫名其妙发现留白涨了。
	arp_seconds = ap_keep36
	var st36_ntv8 := simul_stats(ax36_c, BARS36)
	note_seconds = nt_keep36
	# 面④ 的对照档 = **初版口径**：旋律按 `NOTE_SECONDS_V8`、和弦按 `pad_seconds` 读、错开量归零。
	# ★★★ 2026-10-17 **修**：原来这里只用了 `flatten = true`，而 `flatten` **不管旋律**
	#    （`note` 仍按当前的 `note_seconds` 读，见 `simul_stats()` 的文档）⇒ "初版口径"这一侧
	#    也跟着被测参数一起动 ⇒ 这条比较几乎是一条恒真式。
	#    实测证据（阴性对照 K18 打出来的）：基线"初版口径 = **7.97**"，
	#    把 `note_seconds` 压回 1.6 后同一个量变成 **6.49** —— 一个"初版"参照自己跟着
	#    被测参数走，它就已经不叫参照了（铁律 §110）。
	#    ⇒ 现在**先把 `note_seconds` 临时拨回 v8**，再叠加 `flatten`。
	#    参照物因此变成**不变量** 6.49（与 `note_seconds` / `arp_seconds` / `arp_step` 全都无关），
	#    这一面才真正在说"整曲不许比 v8 挤"，而不是"整曲不许比整曲挤"。
	# ★★★ 但只拨旋律**还不够**（当天第二次踩同一个坑）：`flatten` 把和弦按 `pad_seconds` 读，
	#    而 `pad_seconds` 被本轮口令抬到 4.8 ⇒ 参照物那口**又**跟着动了，6.49 → **7.17**
	#    ⇒ "≤ 初版"这条界被**静默放宽**（放宽比报红危险：红会喊，放宽不喊）。
	#    ⇒ 现在**两个参数都钉住**（`NOTE_SECONDS_V8` + `PAD_SECONDS_V8`），参照物回到 6.49。
	#    凡"用参数把参照物拨回初版"的判据都适用：**参与读取的每个参数都要点名钉住**，
	#    钉一半就等于让另一半随口令漂，而漂的方向几乎总是变松。
	# ★★ 仍然用 `flatten`（与 ㉘ 的旧口径同一个开关）而不是我另行拼一份"初版参数"：
	#    和弦那一侧的口径必须是**同一个**，否则两面说的"初版"不是同一件事。
	# ★★ 必须与 `st36_tense` **成对**量：两边都由同一个 `_schedule_step()` 产出
	#    （`flatten` 只改"怎么读"，不改"发什么"）⇒ 事件集合逐条相同
	#    ⇒ 这条比较是**确定性**的，没有抽样噪声。
	# ★ 这一面有没有**自己的牙**由阴性对照 K20 证明（`note_seconds 2.4 → 3.6`：
	#   ①②③ 全绿、只有这一面红）—— 没有 K20 的话，"④ 红了"和"④ 恒绿"看起来是一样的。
	note_seconds = NOTE_SECONDS_V8
	pad_seconds = PAD_SECONDS_V8
	var st36_tense_base := simul_stats(ax36_t, BARS36, {}, true)
	pad_seconds = pd_keep36
	note_seconds = nt_keep36
	var st36_tense := simul_stats(ax36_t, BARS36)
	# ④ **旋律族的绝对上限**（"延长"过头会变成糊；具体为什么不能用"整曲 ≤ 初版"，见
	#    `SIM_MELODY_MAX` 的注释）—— 只在 `note`/`orn` 两族上量，和弦族的上限在 ㉘③。
	# ★ 元断言（§117）：这个界必须**严格严于"延长到头"的当场实测**，否则它就是一句空话。
	#   "延长到头"取 `@export_range` 的上限 6.0s（不是随手乘 2，免得以后改了区间这条就悄悄失效）。
	var m36_mel := simul_stats(ax36_t, BARS36, {}, false, ["note", "orn"])
	note_seconds = 6.0
	var m36_mel_end := simul_stats(ax36_t, BARS36, {}, false, ["note", "orn"])
	note_seconds = nt_keep36
	var mel36 := float(m36_mel["mean"])
	var mel36_end := float(m36_mel_end["mean"])
	var ok36_mel: bool = mel36 <= SIM_MELODY_MAX and SIM_MELODY_MAX < mel36_end
	# ★★ 把 `note` 族按 gain 拆成"**旋律**"与"**火花**"两块（gain 0.46 / 0.18，
	#   `gain_scale = 1` 时可直接认）。为什么必须拆：`density` 参数只管前者，
	#   只报合计的话"密度参数没按它说的发那么多音"会表现成"留白偏多"，
	#   然后被当成"调一下 `note_seconds` 就行"，而真正的原因永远查不出来
	#   —— 本轮就是靠这两个数把上面那场"随机源到底有没有偏"的排查做到底的。
	# ★ 必须在**技法关掉**的窗口内数，否则摇指/刮奏会把旋律槽弹成 `orn`、
	#   或把旋律音的 gain 改成 0.40（刮奏的收尾音），两类都会被错分。
	var n36_mel := 0
	var n36_spk := 0
	for kk36 in range(1, _steps_per_bar() * BARS36 + 1):
		for ee36 in _schedule_step(kk36, ax36_t):
			if str(ee36["kind"]) != "note":
				continue
			if absf(float(ee36["gain"]) - 0.46) <= 1e-6:
				n36_mel += 1
			else:
				n36_spk += 1
	tech_tremolo = tt_keep36[0]
	tech_gliss = tt_keep36[1]
	tech_grace = tt_keep36[2]
	tech_harmonic = tt_keep36[3]
	bass_enabled = be_keep36
	checks.append(["㊱ 曲子的疏密｜平静档静默占比 ≤ %.2f 且须 ≤ 用户抱怨那版的 %.0f%%｜最长静默 ≤ 一小节｜张力满档旋律族均值 ≤ %.1f 且界须严于延长到头的实测｜界须严于用户抱怨那版的实测"
			% [SILENT_CALM_MAX, SILENT_HEARD_KEEP * 100.0, SIM_MELODY_MAX],
		float(st36_new["silent"]) <= SILENT_CALM_MAX
		and float(st36_new["silent"]) <= float(st36_heard["silent"]) * SILENT_HEARD_KEEP
		and float(st36_new["gap"]) <= bar36 + 1e-6
		and ok36_mel
		and SILENT_CALM_MAX < float(st36_heard["silent"]),
		"平静档静默 %.3f（界 %.2f；用户抱怨的那一版当场实测 %.3f，须 ≤ 它的 %.0f%% = %.3f）· 最长静默 %.3fs（一小节 %.3fs）· 张力满旋律族均值 %.2f（界 %.2f，延长到头 %.2f 须更松）· 张力满全曲均值 %.2f（初版口径 %.2f，信息量不判）· 平静均值 %.2f · 张力满 note %d = 旋律 %d（期望 %.1f）+ 火花 %d（期望 %.1f）· arp %d · 诊断：只把 note_seconds 压回 %.1fs ⇒ 静默 %.3f（信息量，不判）· %d 小节 · 5ms 网格 %d 点" % [
			float(st36_new["silent"]), SILENT_CALM_MAX,
			float(st36_heard["silent"]), SILENT_HEARD_KEEP * 100.0,
			float(st36_heard["silent"]) * SILENT_HEARD_KEEP,
			float(st36_new["gap"]), bar36,
			mel36, SIM_MELODY_MAX, mel36_end,
			float(st36_tense["mean"]), float(st36_tense_base["mean"]), float(st36_new["mean"]),
			int(st36_tense["ev"].get("note", 0)), n36_mel, spb36 * float(BARS36) * density_tense,
			n36_spk, spb36 * float(BARS36) * SPARK_CHANCE,
			int(st36_tense["ev"].get("arp", 0)), NOTE_SECONDS_V8, float(st36_ntv8["silent"]),
			BARS36, int(st36_new["grid"])]])

	# ㊲ 错开口径（2026-11-05 用户裁决后重立）。
	#    ★ 用户「琶音的裁决可以忽略了，只要效果对了就可以」⇒ 古筝技法不再是违例。
	#      现在守的是三件更具体的事：
	#      ① **和弦 (arp) 必须齐奏** —— 10-17 真正抱怨的「太吵」来自这里，没放开；
	#      ② **技法允许错开但不许跨小节** —— 摇指/刮奏/倚音按各自顺序起，越界会撞下一小节；
	#      ③ **钟的小旋律必须真的错开** —— 反向例外，全 0 = 被压成一声（11-03 那个症状）。
	#    ★ 另外三面防蒙混：分母 > 0、乐句仍出声、**orn 真有非 0 的 at**（阳性对照：
	#      若 `tech_free_time` 没接上，四技法又会被压成齐奏音簇，这一面会红）（§106/§127）。
	#    ★ 显式置两档再量，不依赖"默认值碰巧是几"这个外部事实。
	var bad37: Array[String] = []
	var n_ev37 := 0
	var kinds37 := {}
	var cue_ok37 := 0
	var cue_slots37 := 0
	var n_bell37 := 0
	var ss_keep37 := stagger_scale
	var tf_keep37 := tech_free_time
	var bars37 := 8
	stagger_scale = 0.0
	tech_free_time = true        # 显式置档：不依赖"默认值还是 true"这个外部事实
	var bar_secs37 := float(_steps_per_bar()) * step_seconds()
	var orn_moved37 := 0
	for t37 in [0.0, 1.0]:
		var ax37 := axes_from_tension(t37)
		for k37 in range(1, _steps_per_bar() * bars37 + 1):
			for e37 in _schedule_step(k37, ax37):
				n_ev37 += 1
				var kd37 := str(e37["kind"])
				kinds37[kd37] = true
				var atv37 := absf(float(e37.get("at", 0.0)))
				if kd37 == "arp" and atv37 > 1e-9:
					bad37.append("和弦不齐奏 t%.0f k%d at%.3f" % [t37, k37, atv37])
				elif atv37 > bar_secs37:
					bad37.append("错开跨小节 t%.0f k%d %s at%.3f"
						% [t37, k37, kd37, atv37])
				if kd37 == "orn" and atv37 > 1e-9:
					orn_moved37 += 1
		for cid37 in CUE_IDS:
			for k37 in range(1, _steps_per_bar() + 1):
				cue_slots37 += 1
				var n37 := 0
				var nb37 := 0
				var bell_at37 := false
				for e37 in _schedule_step(k37, ax37, String(cid37)):
					kinds37[str(e37["kind"])] = true     # ★ cue 那一族也要记（`pad` 只出现在乐句里）
					var at37 := absf(float(e37.get("at", 0.0)))
					## ★★★ 2026-11-03：钟是**例外，而且是反向的例外**。
					##   「怎么还有琶音，都去掉」针对的是**古筝**的旋律/和弦/装饰（滚动会造小二度、
					##   4 音叠加、音簇）。钟是**打击乐点**：用户要的正是几个音的小旋律 + 二倍拍速。
					##   ⇒ 这一族反过来判：乐句里的古筝仍发落点音（at=0），钟**这一串里必须至少有一个非 0**
					##     （全 0 = 旋律被压成一声，正是用户报的那个症状）。
					##   ★ 判的是"这一串"而不是"每一个音"：小旋律的**第一个音本来就起在 0**
					##     （乐句起点），逐音判会把正确的东西判红 —— 那是把判据写成了
					##     "所有音都不许在第一拍"，跟要验的事无关。
					##   ★ 不做成"跳过钟"：跳过的判据对这族完全没有牙。
					if str(e37.get("instr", "")) != "":
						nb37 += 1
						n_bell37 += 1
						if at37 > 1e-9:
							bell_at37 = true
					elif at37 > 1e-9:
						bad37.append("cue%s t%.0f k%d at%.3f"
							% [str(cid37), t37, k37, float(e37["at"])])
					if str(e37["kind"]) != "arp":
						n37 += 1
				if nb37 >= 2 and not bell_at37:
					bad37.append("cue%s t%.0f 的 %d 个钟音 at 全为 0（小旋律被压成一声）"
						% [str(cid37), t37, nb37])
				if n37 > 0:
					cue_ok37 += 1
	stagger_scale = ss_keep37
	tech_free_time = tf_keep37
	checks.append(["㊲ 错开口径｜和弦 (arp) 必须齐奏｜技法允许错开但不许跨小节｜钟的小旋律必须真的错开(反向例外)｜覆盖 %d 小节 × 两档张力 + %d 个时刻 × 两档 × 一小节｜出货总闸须为 0｜乐句仍须出声 %d/%d｜分母 %d 个事件 / %d 个钟音 / %d 个音族 / %d 个错开技法音"
			% [bars37, CUE_IDS.size(), cue_ok37, cue_slots37, n_ev37, n_bell37, kinds37.size(), orn_moved37],
		bad37.is_empty() and absf(ss_keep37) <= 1e-9
			and n_ev37 > 0 and kinds37.size() >= 3 and orn_moved37 > 0
			and cue_slots37 > 0 and cue_ok37 == cue_slots37
			and n_bell37 > 0,
		"违例 %d 条（样本 %s）· 事件 %d 个 · 钟音 %d 个 · 错开技法音 %d 个 · 音族 %s · 乐句出声 %d/%d · 总闸 %.2f（须为 0）· 技法自由档进来时 %s"
			% [bad37.size(), str(bad37.slice(0, 4)), n_ev37, n_bell37, orn_moved37,
				str(kinds37.keys()), cue_ok37, cue_slots37, ss_keep37, str(tf_keep37)]])

	# ㊴ 正弦模型（2026-10-30）。四个面，前两个是阳性面、后两个是**阴性对照**
	#    （§127 正负成对：只验"能出声"等于没验"它到底改了什么"）。
	#
	#   ① `sine_mix = 0` ⇒ `instr_pcm()` 与 `_instr_pcm_base()` **逐位相同**。
	#      这一条就是古筝字节锚（md5 61043c95…）的**结构保证** —— 出厂默认必须走这里。
	#   ② 九件乐器在 `sine_mix = 1` 下**都要出声**（峰值 ≥ 0.05）。
	#      没有它的话，"忘了给某件乐器配 `sine` 子字典"会**静默**退回原引擎，
	#      而听感上只是"这一件没变"，没人会怀疑到配置缺失上。
	#   ③ 衰减族三件：各谐波 T−20dB **不许严格单调**（至少出现一次"后一个比前一个长 15%"）。
	#      ★★ 这是整个正弦模型**唯一的存在理由**：KS 是一条延迟线 ⇒ 单调 ⇒ 电子味。
	#      真二胡实测 1.58/0.87/1.01/0.24/0.64/0.26（有起有落）。
	#   ④ 阴性对照：`sine_life = 0` ⇒ 包络粗糙度必**降**；`sine_air = 0` ⇒ 尾部 RMS 必**降**。
	#      两句都是"拧了旋钮必须有反应"的可判形式（§33 死参数）。取值不判幅度，
	#      只判方向 —— 幅度是调参的事，方向是**接线**的事。
	var ns_keep39 := note_seconds
	var ins_keep39 := instrument_id
	var sm_keep39 := sine_mix
	var life_keep39 := sine_life
	var air_keep39 := sine_air
	var bad39: Array[String] = []

	# ① 闸门关着时逐位相同
	sine_mix = 0.0
	var g39a: PackedFloat32Array = instr_pcm(69, "note")
	var g39b: PackedFloat32Array = _instr_pcm_base(69, "note")
	var gate39: bool = g39a.size() == g39b.size()
	if gate39:
		for i in g39a.size():
			if g39a[i] != g39b[i]:
				gate39 = false
				break
	if not gate39:
		bad39.append("闸门关时不逐位相同")

	# ② 九件都出声
	note_seconds = 0.8
	sine_mix = 1.0
	var quiet39: Array[String] = []
	for sid in INSTR_IDS:
		set_instrument(String(sid))
		var p: PackedFloat32Array = instr_pcm(69, "note")
		var pk := 0.0
		for v in p:
			pk = maxf(pk, absf(v))
		if p.is_empty() or pk < 0.05:
			quiet39.append(String(sid))
	if not quiet39.is_empty():
		bad39.append("不出声 %s" % str(quiet39))

	# ③ 衰减族：各谐波 T−20dB 非单调
	## ★★ 编钟**不在这条判据里**，理由是判据本身不成立（§118）：它的分音是
	##   1 : 2.02 : 2.98 : 4.06 : 5.35 : 6.78，**根本不是整数倍**，用整数谐波解调器去量
	##   就是在量伪影（实测读出 0.46/0.00/0.09/0.00/0.00，那些 0.00 是"一开窗就掉到
	##   −20dB"的漏电，不是衰减）。要用它必须先按 `partials` 的**真实频率比**解调，
	##   那是另一条判据，不该塞进这条。
	note_seconds = 1.5
	var dec39 := ["pipa", "guzheng", "yangqin"]
	var bump_txt := ""
	for sid in dec39:
		set_instrument(sid)
		var p: PackedFloat32Array = instr_pcm(69, "note")
		var t20: Array = _harm_t20(p, 440.0, 5, 1.4)
		var ok39: Array[float] = []
		for v in t20:
			if float(v) > 0.0:
				ok39.append(float(v))
		var bumps := 0
		for i in range(1, ok39.size()):
			if ok39[i] > ok39[i - 1] * 1.15:
				bumps += 1
		var seq39 := ""
		for v in t20:
			seq39 += ("%.2f " % float(v)) if float(v) > 0.0 else "-- "
		bump_txt += "%s:折%d[%s] " % [sid, bumps, seq39]
		if bumps < 1:
			bad39.append("%s 各谐波严格单调" % sid)

	# ④ 阴性对照（两个旋钮各拧一次，方向必须对）
	## ★★ 必须在**持续音**上量，不能在拨弦上量：
	##   · `_env_rough` 去掉的是**趋势**，而拨弦的 60dB 衰减本身就是最大的趋势，
	##     两次测量的差会被"衰减速率"污染（实测方向真的反了：0.60→0.70）。
	##   · 噪声底是**跟随包络**的，拨弦尾部包络已经 −70dB ⇒ 噪声也一起没了，
	##     在尾部量噪声底永远量不到（实测两次都是 0.00070，一模一样）。
	##   笙：`sustain` 0.90 且**没有揉弦**（`vib_hz` 0）⇒ 它的包络起伏纯粹来自
	##   LFO 与噪声，两个旋钮各管一半，方向清楚。
	note_seconds = 1.2
	set_instrument("sheng")
	sine_mix = 1.0
	sine_life = 1.0
	sine_air = 1.0
	var ref39: PackedFloat32Array = instr_pcm(69, "note")
	var rough_on := _env_rough(ref39)
	var rms_on := _rms(ref39, 0.20, 0.72)
	sine_life = 0.0
	var rough_off := _env_rough(instr_pcm(69, "note"))
	sine_life = 1.0
	sine_air = 0.0
	var pcm_dry: PackedFloat32Array = instr_pcm(69, "note")
	var rms_dry := _rms(pcm_dry, 0.20, 0.72)
	var nz_sheng := _noise_rel_db(ref39, pcm_dry)
	if not (rough_off < rough_on * 0.90):
		bad39.append("活气旋钮没带动包络粗糙度")
	## ★★ 这一面查的是**接线**（§33 死参数），不是预算。所以是**双向粗档**：
	##   上界 −20dB：噪声底不许响到荒唐（只把 `na` 拧回 0.35 时笙读 −27.6dB，
	##     连低通一起还原才约 −21.5dB ⇒ 这个粗档**故意**抓不住预算问题，那是 ㊵ 的活）。
	##   下界 −55dB：旋钮不许变成哑的（拔掉就是 −999）。
	##   实测笙 −43.1dB，两侧余量 12dB / 23dB。
	if not (nz_sheng < -20.0 and nz_sheng > -55.0):
		bad39.append("噪声底旋钮不在合理档位（%.1f dB）" % nz_sheng)

	checks.append(["㊴ 正弦模型｜闸门关时与 `_instr_pcm_base` 逐位相同 · %d 件乐器在 `sine_mix=1` 下都出声 · 衰减族各谐波 T−20dB 不许严格单调 · 两个阴性对照都在笙上：关活气⇒包络粗糙度↓ · 关噪声底⇒噪信比落在 −55~−20 dB"
			% INSTR_IDS.size(),
		bad39.is_empty(),
		"逐位相同=%s · 不出声 %s · %s· 笙 包络粗糙 %.4f→%.4f ｜ 噪信比 %.1f dB · RMS %.5f→%.5f" % [
			str(gate39), str(quiet39), bump_txt, rough_on, rough_off, nz_sheng,
			rms_on, rms_dry]])

	sine_mix = sm_keep39
	sine_life = life_keep39
	sine_air = air_keep39
	note_seconds = ns_keep39
	instrument_id = ins_keep39
	_wav_cache.clear()
	_cache_fp = ""

	# ㊵ 噪声底预算｜「正弦模型不许靠白噪冒充亮度」—— 用户听感「杀杀杀的噪音感」的回归闸。
	#
	# ★★ 为什么必须有这一条：⑧ 那段原来是 `na = air_k * 0.35` + **3400Hz 低通**。
	#   噪声能量于是全堆在 1~4kHz —— 那正好是（a）耳朵最敏感的频段，（b）`tilt ≈ 1`
	#   之后谐波已衰减到 f0 的 20% 以下。噪声在关键频带里比音**还响**，听成"沙"是必然的。
	#   而我当初把 `air` 拉到 1.30~1.45 的理由是"对齐真二胡实测的高频含量"——
	#   这个理由本身是错的：真乐器的高频是**谐波**，不是宽带噪声。
	#   （旁证：KS 那 5~10kHz 能量里只有 10% 落在谐波上，90% 是拨弦噪声与延迟线杂音
	#    ⇒ "两边的 5~10kHz 一样多"根本不能当"亮度正确"的证据。）
	#   修好之后**没有任何判据会拦着别人把 `na` 拧回去** ⇒ 这一条就是那个闸。
	#
	# ★ 判据用 `_noise_rel_db()`：把加性噪声从信号里减出来，不经过任何频谱掩码
	#   ⇒ 换乐器、换音高、改 `tilt`/`H`/`inharm` 都不会误报（这类闸最怕的是被后续
	#   正当改动误杀，然后被人把阈值放宽到失效）。
	# ★ 阈值 −30dB 的来历（§135：期望值须解释每一条）：
	#   真实乐器气声在 −30~−45dB ⇒ 这是物理区间；
	#   旧缺陷版实测约 −21.5dB ⇒ **必红 8.5dB**；
	#   修正后实测 −35.7 ~ −43.1dB ⇒ 余量 5.7 ~ 13dB。
	# ★ 为什么是 0.7s 而不是生产口径的 1.2s：这一面量的是**功率比**，与音长无关；
	#   而九件要渲两遍（air=1 / air=0），1.2s 会把自检撑到 +1.7s。0.7s 实测 +0.9s。
	var ns_keep40 := note_seconds
	var ins_keep40 := instrument_id
	var sm_keep40 := sine_mix
	var air_keep40 := sine_air
	note_seconds = 0.7
	sine_mix = 1.0
	var bad40: Array = []
	var nz_parts: Array = []
	var nz_worst := -999.0
	var nz_worst_id := ""
	for iid in INSTR_IDS:
		set_instrument(str(iid))
		var cn := str(_instr_spec(str(iid)).get("name", str(iid)))
		sine_air = 1.0
		var wi40: PackedFloat32Array = instr_pcm(69, "note")
		sine_air = 0.0
		var wo40: PackedFloat32Array = instr_pcm(69, "note")
		var nz40 := _noise_rel_db(wi40, wo40)
		nz_parts.append("%s %.1f" % [cn, nz40])
		if nz40 > nz_worst:
			nz_worst = nz40
			nz_worst_id = cn
		if not (nz40 < -30.0):
			bad40.append(str(iid))
	checks.append(["㊵ 噪声底预算｜9 件乐器在 `sine_mix=1` 下的**噪信比**都须 < −30dB · 噪声底不许靠白噪冒充亮度 · 旧缺陷版约 −21.5dB · 修正后 −35.7~−43.1dB",
		bad40.is_empty(),
		"最差 %s %.1f dB · %s" % [nz_worst_id, nz_worst, " · ".join(nz_parts)]])
	note_seconds = ns_keep40
	instrument_id = ins_keep40
	sine_mix = sm_keep40
	sine_air = air_keep40
	_wav_cache.clear()
	_cache_fp = ""

	# ㊶ 预热｜把"首次合成"从主线程搬到后台线程 —— 用户听感「整曲卡顿明显」的回归闸。
	#
	# ★★ 病因（实测，不是猜）：播放路径 `_process()`→`_on_step()`→`_play_event()`→`wav_for()`
	#   在缓存未命中时**当场合成**。A4 / note_seconds 2.9s / 22050Hz 的单音成本：
	#     note  KS 15.1ms / **正弦 56.8ms**；pad（4.8s）KS 22.3ms / **正弦 91.4ms**。
	#   60fps 一帧 16.7ms ⇒ 一个没缓存的音冻 1~6 帧；密集档最坏的一步（3~5 个音）实测 175.5ms。
	#   **所以这不是"缓存失效"，是首次合成分配错了线程。**
	#
	# ★★ 为什么"按帧分摊预算"救不了（先试的，量完否掉）：预算是每帧几毫秒，而一个工作单元
	#   是单个音的 57~94ms —— 工作单元比整帧还大，分摊只是把同样的冻结挪个位置。
	#   唯一的另一条路是把 `_sine_pcm()` 改成可暂停续算的分块渲染，那必然改输出字节，
	#   而用户已经验收了当前音色 ⇒ 不动。
	#
	# ★ 这一条四个面（前三面是结构性断言，不靠墙钟，不会因负载假红）：
	#   ① 排程：`_pw_plan()` 必须能为未来的步排出键（否则预热没活干，②③ 都是恒真式）
	#   ② 发送 + 阴性对照：`prewarm_workers > 0` ⇒ 真的发出后台任务；
	#      `prewarm_workers = 0` ⇒ **一个都不发**（§127 正负成对）
	#   ③ **后台线程的合成结果与主线程逐字节相同** —— 这是线程安全的硬断言，也是
	#      "偷偷改了刚验收的音色"这道门的唯一拦法（线程若踩坏某个惰性缓存，这里必红）
	#   ④ 观测器自检：`wav_for()` 未命中把 `_synth_on_main` 加一、命中不加
	#      （④ 是前三面的地基：③④ 都靠这个计数器/比较，它坏了前三面就成了假牙）
	var ns_keep41 := note_seconds
	var ins_keep41 := instrument_id
	var sm_keep41 := sine_mix
	var ps_keep41 := prewarm_steps
	var wkr_keep41 := prewarm_workers
	var cm_keep41 := prewarm_commit_per_frame
	var wc_keep41 := wav_cache_max
	var bad41: Array = []
	var planned41 := 0
	var inflight_on41 := 0
	var inflight_off41 := -1
	var same41 := -1
	var cnt41 := ""

	note_seconds = 0.6
	sine_mix = 1.0
	set_instrument("pipa")
	prewarm_steps = 8
	prewarm_workers = 2
	prewarm_commit_per_frame = 1
	wav_cache_max = 192
	_wav_cache.clear()
	_wav_used.clear()
	_pw_queue.clear()
	_pw_queued.clear()
	_pw_infly.clear()
	_cache_fp = ""

	## 找一个"有音"的步当预测起点（前几步可能是空的 ⇒ 不找会掉进"分母 0 却绿"的坑）
	var ax41 := axes_from(1.0, {})
	var k41 := 1
	var keys41: Array = []
	for _i41 in 24:
		keys41 = _keys_of_step(k41, ax41, "")
		if not keys41.is_empty():
			break
		k41 += 1
	if keys41.is_empty():
		bad41.append("找不到有音的步（有效分母 0）")
	else:
		# ① 排程
		_step_idx = k41 - 1
		_pw_plan(ax41)
		planned41 = _pw_queue.size()
		if planned41 <= 0:
			bad41.append("排程没排出任何键")
		# ② 发送 + 阴性对照
		_pw_pump()
		inflight_on41 = _pw_infly.size()
		for tid41 in _pw_infly:
			WorkerThreadPool.wait_for_task_completion(int(tid41))
		_pw_infly.clear()
		_pw_queue.clear()
		_pw_queued.clear()
		prewarm_workers = 0
		_pw_plan(ax41)
		_pw_pump()
		inflight_off41 = _pw_infly.size()
		prewarm_workers = 2
		_pw_infly.clear()
		_pw_queue.clear()
		_pw_queued.clear()
		if inflight_on41 <= 0:
			bad41.append("预热没发出后台任务")
		if inflight_off41 != 0:
			bad41.append("关掉预热后仍在发任务")
		# ③ 后台 vs 主线程逐字节
		var midi41 := int(keys41[0][1])
		var kind41 := str(keys41[0][2])
		var at41 := float(keys41[0][3])
		var box41: Array = [null]
		var tid41b := WorkerThreadPool.add_task(
			func() -> void: box41[0] = voice_pcm(midi41, kind41, at41), false, "musictest41")
		WorkerThreadPool.wait_for_task_completion(tid41b)
		var main41: PackedFloat32Array = voice_pcm(midi41, kind41, at41)
		var thr41: Variant = box41[0]
		if thr41 == null:
			bad41.append("后台线程没返回 PCM")
		else:
			same41 = 1 if (thr41 as PackedFloat32Array) == main41 else 0
			if same41 != 1:
				bad41.append("后台合成与主线程不逐字节相同")
		# ④ 观测器自检
		_wav_cache.clear()
		_wav_used.clear()
		_synth_on_main = 0
		wav_for(midi41, kind41, at41)
		var c1_41 := _synth_on_main
		wav_for(midi41, kind41, at41)
		var c2_41 := _synth_on_main
		cnt41 = "%d→%d" % [c1_41, c2_41]
		if not (c1_41 == 1 and c2_41 == 1):
			bad41.append("`_synth_on_main` 计数不对（未命中该 +1、命中不该加）")

	note_seconds = ns_keep41
	instrument_id = ins_keep41
	sine_mix = sm_keep41
	prewarm_steps = ps_keep41
	prewarm_workers = wkr_keep41
	prewarm_commit_per_frame = cm_keep41
	wav_cache_max = wc_keep41
	_wav_cache.clear()
	_wav_used.clear()
	_pw_queue.clear()
	_pw_queued.clear()
	_pw_infly.clear()
	_cache_fp = ""
	checks.append(["㊶ 预热｜后台合成把首次合成搬出主线程：排程能排出键 · `prewarm_workers>0` 真的发任务且关掉后一个不发 · **后台线程合成与主线程逐字节相同** · `wav_for` 未命中计数正确",
		bad41.is_empty(),
		"排程 %d 键（起点第 %d 步）· 在飞 %d / 关掉后 %d · 逐字节相同=%s · 计数 %s" % [
			planned41, k41, inflight_on41, inflight_off41,
			"是" if same41 == 1 else ("否" if same41 == 0 else "无效"), cnt41]])

	# ㊷ 二胡保共鸣重合成｜「像坏掉的喇叭」这一类缺陷的回归闸。
	## 用户就是这么骂的，而**38 条判据里一条都没咬到**——因为 ㊳ 只量音准、㊴/㊵ 只量
	## 噪声底与出声，没有任何一条看"谐波之间"。缺陷真身是**相位没有跨块累积**：
	## 每个 64 采样块（2.9ms = 344Hz）被随机跳一次相位 ⇒ 一层宽带调制噪声，
	## 实测谐波间能量占比 5.44%，而参考件 0.026%。
	var bad42: Array = []
	var ins_keep42 := instrument_id
	var em_keep42 := erhu_resyn_mix
	var hm_keep42 := erhu_resyn_hmax
	var ns_keep42 := note_seconds
	var path_keep42 := erhu_resyn_path
	note_seconds = 2.49
	instrument_id = "erhu"
	erhu_resyn_hmax = 48
	erhu_resyn_mix = 1.0
	_wav_cache.clear()
	_cache_fp = ""
	var p42: PackedFloat32Array = instr_pcm(57, "note")
