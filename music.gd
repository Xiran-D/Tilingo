@export_range(-1.0, 1.0, 0.01) var instr_bright: float = 0.0
## 气声 / 弓噪 / 触弦噪声的倍率（只影响持续激励族与拨弦族的噪声口）。
@export_range(0.0, 2.0, 0.05) var instr_breath: float = 1.0
## 揉弦（颤音）深度倍率。0 = 完全不揉（直音），2 = 加倍。
@export_range(0.0, 2.0, 0.05) var instr_vibrato: float = 1.0
## 管间 / 弦间失谐倍率（笙的双管、扬琴的双弦、二胡的双弦都吃这一口）。0 = 完全齐奏。
@export_range(0.0, 3.0, 0.05) var instr_detune: float = 1.0
## 起音时长倍率。1.0 = 照乐器本体（笛 22ms / 箫 95ms / 二胡 100ms …）。
@export_range(0.2, 4.0, 0.05) var instr_attack: float = 1.0
## 共鸣峰（body）强度倍率。0 = 直通（没有木腔/皮膜染色），1.0 = 乐器本体设定。
@export_range(0.0, 2.0, 0.05) var instr_body: float = 1.0
## 「空气感」倍率：拨弦族在**谐波之间**的噪声底（跟随信号包络，不是恒定白噪）。0 = 数字静音。
## ★★ 为什么需要这一口（2026-10-30 实测，参照物 = CC0 真二胡 22050 单声道）：
##   真采样在谐波之外还有 **1.0%** 的能量（弓毛/房间/空气），而引擎的三件弹拨是
##   **绝对数字零**（实测噪声底 0.000）。"背景死寂"是所有合成器味的共同根 ——
##   耳朵把"完全没有底噪"直接判成"这不是真乐器"，与音高、包络都无关。
@export_range(0.0, 3.0, 0.05) var pluck_air: float = 1.0
## 「活气」倍率：拨弦族的**双弦失谐**与**快衰减副弦**权重。0 = 单根完美周期弦。
## ★★ 另一条实测：真二胡的基频幅度起伏（去趋势变异系数）= **0.416**，而引擎 pipa = **0.002**
##   （差 200 倍）—— 也就是说合成的每个音是**绝对周期的循环**，谐波幅度一动不动。
##   真乐器那个"呼吸"来自双弦拍频、琴体耦合、弓压变化；这里用最便宜的两条复刻：
##   一条 +N 音分的同音副弦（拍频）、一条衰减更快的副弦（谱形随时间变化）。
@export_range(0.0, 3.0, 0.05) var pluck_char: float = 1.0
## **正弦模型混合量**：0 = 全用现有的物理/STK 引擎（**出货默认**），1 = 全用正弦模型。
## ★★ 为什么默认必须是 0：古筝出厂音色「逐字节不变」是硬约束（单音件字节锚
##   md5 `61043c95…`）。`sine_mix <= 0` 时 `instr_pcm()` 的**第一行**就早退到原路径
##   ⇒ 默认态这套代码一个字节都不参与，零代价零风险。
## ★ 中间值（0.3/0.5…）是**交叉淡化**，只在 A/B 试听时用，不作为出货档
##   （两套谱叠在一起会同时具备两边的缺点：KS 的严格单调 + 正弦的相位散乱）。
@export_range(0.0, 1.0, 0.05) var sine_mix: float = 0.0
## —— 二胡专属档（2026-10-31）——
## 保共鸣重合成的分析表路径（`audio/erhu_resyn.json`，离线由
