## 与上面六个**合成**族并列的第七条路：查外部采样库，命中就用样本，查不到就退回合成。
##
## ★★★ 默认是**关**的（`instr_sample_dir` 空串 ⇒ `_sample_pcm()` 立刻返回空 ⇒
##   `instr_pcm()` 的行为与没有这段代码时逐位相同）。理由：出货行为不许因为一次试验而改变，
##   古筝 md5 锚 `61043c95…` 必须仍然成立。
##
## ★★ `SAMPLE_SETS` 里的 `hz` 是**实测基频**，不是抄 sfz 的 `pitch_keycenter`。
##   实测依据（`_音源调研/_fund.py`，Goertzel 细扫 + 谐波列核对）：
##     erhu_d5_sus_rr1 → 290.4Hz / erhu_a5_sus_rr1 → 441.9Hz / erhu_a6_sus_rr1 → 880.5Hz
##   而 sfz 声明 `pitch_keycenter=50/57/69` = 146.8/220/440Hz ⇒ **整体低一个八度**。
##   照抄它会把整件乐器弹高一个八度，而且"高八度在频谱上太协调"，听感上很容易被当成
##   "音色亮" —— 同 ㊳ 那条注释的理由。⇒ 采样表只信**量出来的数**。
##
## ★ 已知边界（不是缺陷，是这套音源的事实）：CC0 那套二胡只录了 D4–A5（290–880Hz）。
##   超出 `sample_stretch` 个半音就退回合成器 ⇒ 同一个曲子里可能"低音是合成的、高音是采样的"。
##   这是**音源覆盖面**的问题，换代码解决不了（见 `music.md` 的调研结论）。
const SAMPLE_SETS := {
	"erhu": {
		"src": "sfzinstruments/aliexpress-erhu（CC0-1.0）",
		"attack": 0.040, "release": 0.22, "gain": 0.95,
		## 一个根音最多往两边各撑几个半音就另外找一个根音；都不在范围内 ⇒ 退回合成。
		"sample_stretch": 12,
		"roots": [
			{"file": "erhu_d5_sus_rr1.wav", "hz": 290.4},
			{"file": "erhu_a5_sus_rr1.wav", "hz": 441.9},
			{"file": "erhu_a6_sus_rr1.wav", "hz": 880.5},
		],
	},
}

var _sample_bank := {}


## 读 16-bit 单声道/立体声 RIFF wav（手写解析：不依赖任何版本相关的加载 API，
## 与 `save_wav()` 对称）。失败返回空字典 —— 调用方必须把它当"没有采样"处理。
func _read_wav_mono(path: String) -> Dictionary:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return {}
	var head := f.get_buffer(12)
	if head.size() < 12 or head.slice(0, 4).get_string_from_ascii() != "RIFF":
		return {}
	var sr := 0
	var ch := 1
	var bits := 16
	var data := PackedByteArray()
	while f.get_position() + 8 <= f.get_length():
		var cid := f.get_buffer(4)
		if cid.size() < 4:
			break
		var sz := f.get_32()
		var tag := cid.get_string_from_ascii()
		if tag == "fmt ":
			var fmt := f.get_16()
			ch = f.get_16()
			sr = f.get_32()
			f.get_32()
			f.get_16()
			bits = f.get_16()
			var skip := sz - 16
			if skip > 0:
				f.seek(f.get_position() + skip)
		elif tag == "data":
			data = f.get_buffer(sz)
		else:
			f.seek(f.get_position() + sz + (sz & 1))
	if sr <= 0 or data.is_empty():
		return {}
	var bytes := bits / 8
	if bits != 16 or bytes <= 0:
		return {}
	var n := data.size() / (bytes * ch)
	var pcm := PackedFloat32Array()
	pcm.resize(n)
	for i in n:
		var acc := 0.0
		for c in ch:
			var o := (i * ch + c) * bytes
			acc += float(data.decode_s16(o)) / 32768.0
		pcm[i] = acc / float(ch)
	return {"sr": sr, "pcm": pcm}


## 采样库懒加载（每件乐器只读一次盘）。返回 `[{"hz":float,"pcm":…,"sr":int}, …]`。
func _sample_bank_for(id: String) -> Array:
	## ★ 锁的理由同 `_sine_lut_get()`：这是"首次调用时写 `_sample_bank`"的惰性缓存，
	##   而预热任务在工作线程里跑 ⇒ Dictionary 并发插入会损坏（Godot 的 Dictionary 不是线程安全的）。
	##   ★★ 注意它**即使 `instr_sample_dir == ""` 也会写**（缓存一个空数组）——
	##   所以"没开采样就不会撞车"这个想法是错的，锁不能省。
	_thr_mutex.lock()
	if not _sample_bank.has(id):
		var out: Array = []
		if instr_sample_dir != "" and SAMPLE_SETS.has(id):
			var set: Dictionary = SAMPLE_SETS[id]
			for r in set.get("roots", []):
				var path := instr_sample_dir.path_join(str(r.get("file", "")))
				var w := _read_wav_mono(path)
				if w.is_empty():
					push_warning("[Music] 采样读不出来：%s" % path)
					continue
				out.append({"hz": float(r.get("hz", 440.0)),
					"pcm": w["pcm"], "sr": int(w["sr"])})
		_sample_bank[id] = out
	var res: Array = _sample_bank[id]
	_thr_mutex.unlock()
	return res


## 采样族主入口。**返回空 = 本音不归采样管**（调用方退回合成器，这是唯一的否决语义）。
## `ratio` 同时承担两件事：音高平移（目标/根音）与重采样（样本 sr → 引擎 sr）。
##   ⇒ 一个乘除就够，绝不能分两步各做一次（两步做等于把音高平移吞掉，且不报错）。
func _sample_pcm(id: String, midi: int, secs: float, bright: float) -> PackedFloat32Array:
	var empty := PackedFloat32Array()
	if instr_sample_dir == "" or not SAMPLE_SETS.has(id):
		return empty
	var bank := _sample_bank_for(id)
	if bank.is_empty():
		return empty
	var spec: Dictionary = SAMPLE_SETS[id]
	var want := midi_to_freq(midi)
	# 选**最近**的根音（按音分距离，不是按 Hz 差：低音区 10Hz 是半个音，高音区不是）
	var best: Dictionary = {}
	var best_d := 1e9
	for r in bank:
		var d := absf(1200.0 * log(want / float(r["hz"])) / log(2.0))
		if d < best_d:
			best_d = d
			best = r
	var reach := 100.0 * float(spec.get("sample_stretch", 12))
	if best.is_empty() or best_d > reach:
		return empty
	var sr_out := maxi(sample_rate, 8000)
	var ratio := want / float(best["hz"]) * float(best["sr"]) / float(sr_out)
	var src: PackedFloat32Array = best["pcm"]
	var n := maxi(int(secs * float(sr_out)), 8)
	var out := PackedFloat32Array()
	out.resize(n)
	var last := src.size() - 1
	if last < 2:
		return empty
	var atk := maxf(maxf(float(spec.get("attack", 0.04)) * instr_attack, 0.002) * float(sr_out), 1.0)
	var rel := maxf(float(spec.get("release", 0.22)), 0.02) * float(sr_out)
	var pos := 0.0
	var live := float(last)
	for i in n:
		if pos >= live:
			# 样本比这个音短 ⇒ 尾巴只能淡出（没有循环点：这套 wav 没有 smpl 块，
			# 硬接就是一声"咔"）。这是采样的**固有边界**，不是可以调好的参数。
			break
		var i0 := int(pos)
		var fr := pos - float(i0)
		var i1 := mini(i0 + 1, last)
		out[i] = src[i0] * (1.0 - fr) + src[i1] * fr
		pos += ratio
	# 剩下没填的是 0；用 `_lin_env` 的同一套起落，避免"截断处一脚踩空"
	var used := int(minf(pos / maxf(ratio, 1e-6), float(n)))
	if used <= 0:
		return empty
	for i in used:
		out[i] *= _lin_env(i, used, atk, minf(rel, float(used) * 0.25))
	out = _darken(out, bright, sr_out)
	# ★ 归一到 ±1 峰值：与另外六个引擎**同一条约定**（见 `INSTRUMENTS` 头注释里
	#   `gain` 那句"三个引擎都归一到 ±1 峰值 ⇒ 不同频谱的听感响度差很多"）。
	#   不加这一步的实测后果：采样版二胡比合成版**低 4.8dB**，而这不是音色差异，
	#   只是样本峰值 0.85 与合成器 Peak=1.0 的口径差 —— 会把 A/B 听成"采样更弱"。
	out = _norm_peak(out)
	var gg := float(spec.get("gain", 1.0))
	if gg != 1.0:
		for i in n:
			out[i] *= gg
	return out


## 乐器定义查表（非法/缺项 ⇒ 回退古筝；`INSTRUMENTS` 一定含它）。
func _instr_spec(id: String) -> Dictionary:
	var d: Variant = INSTRUMENTS.get(id)
	if d is Dictionary:
		return d
	return INSTRUMENTS["guzheng"]


## **当前乐器 id 的唯一读点**。空串 ⇒ 跟随曲风（`STYLES[*]["instr"]`，缺项 = guzheng）。
## ★ 为什么用一个函数而不是把 id 存成成员：跟随曲风时它是**派生量**，存起来就会与
##   `style_id` 分家（换曲风而乐器不动，且不报错）。
func _instr_id() -> String:
	var id := instrument_id.strip_edges()
	if id == "":
		id = str(_style().get("instr", "guzheng"))
	if INSTRUMENTS.has(id):
		return id
	if not _instr_warned:
		_instr_warned = true
		push_warning("[Music] 未知乐器 id「%s」⇒ 回退 guzheng（合法值见 INSTR_IDS）" % id)
	return "guzheng"


## 乐器中文名（日志/菜单/验收件用）。
func instr_name(id: String) -> String:
	return str(_instr_spec(id).get("name", id))


## 当前乐器 id（公开只读）。
func current_instrument() -> String:
	return _instr_id()
# ⚰️ 2026-11-02 墓碑（名字不许回收）：`instr_list()` 已删除（全工程零读者，`_audit_gd` ②）。


## 换乐器（运行期可调）。空串 = 跟随曲风。
## ★ 必须**当场清缓存**：指纹里虽然含乐器 id（`_timbre_fp()` 会兜住），但显式清一次
##   能让"调了没反应"这件事在编译期就不成立（同 `_wav_cache_guard()` 的理由）。
func set_instrument(id: String) -> void:
	instrument_id = id.strip_edges()
	_wav_cache.clear()
	_cache_fp = ""


## ★★ **单声部音源的唯一入口**（`voice_pcm()` 与离线渲染都走它）。
##
## 分两层：
##   · `instr_pcm()`      —— **正弦模型闸门**（`sine_mix`）。`<= 0` ⇒ 原样透传给 `_instr_pcm_base()`，
##                          一个字节都不多算 ⇒ 出厂音色逐字节不变。
##   · `_instr_pcm_base()` —— 原有的"三引擎 + 采样"分发，**一行没动**（古筝仍在此早退）。
## ★★ 为什么要把闸门做成**外面一层**而不是插在 `_instr_pcm_base()` 里面：
##   古筝的早退在主路径的**第一行**。若把正弦模型插在它后面，「古筝走不走正弦模型」
##   就取决于「早退在不在前面」，而那是一个**位置契约** —— 后面任何人往前挪一行就崩，
##   而且崩的方式是静默的（字节锚红，但看不出为什么）。包一层等于把它变成**结构**。
func instr_pcm(midi: int, kind: String, id_in: String = "") -> PackedFloat32Array:
	## ★★ 2026-11-03：第三参数 = **事件级乐器覆盖**（特殊时刻的钟声层用它）。
	##   缺省空串 ⇒ `_instr_id()` ⇒ 与只有两参数的旧调用点**逐位相同**。
	var iid := _resolve_instr(id_in)
	var w := clampf(sine_mix, 0.0, 1.0)
	if w <= 0.0001:
		return _instr_pcm_base(midi, kind, iid)
	var sine := _sine_pcm_for(midi, kind, iid)
	if sine.is_empty():
		return _instr_pcm_base(midi, kind, iid)
	if w >= 0.9999:
		return sine
	## 中间档 = 交叉淡化（只用于 A/B 试听，不是出货档：两套谱叠加会同时具备两边的缺点）
	var base := _instr_pcm_base(midi, kind, iid)
	var n := mini(base.size(), sine.size())
	var out := PackedFloat32Array()
	out.resize(n)
	var iw := 1.0 - w
	for i in n:
		out[i] = iw * base[i] + w * sine[i]
	return out


## **事件级乐器 id 的单一解析点**（`instr_pcm()` 与 `_wav_key()` 共用，铁律 18/70）。
## 空串 ⇒ 全局 `_instr_id()`；非法 id ⇒ **也**退回全局。
## ★ 为什么非法 id 在这里退回而不是硬失败：本函数服务的三条路（在线取流 / 离线渲染 /
##   预热）任何一条返回空数组都会变成"静默失声"。非法 id 的正确处置在**上游**
##   （`_cue_events()` 直接不出声 + 判据 ㊸ 会把"拼错的钟 id"报红）。
func _resolve_instr(id_in: String) -> String:
	var s := id_in.strip_edges()
	if s == "" or not INSTRUMENTS.has(s):
		return _instr_id()
	return s


## 把「乐器本体 + 本音族长度/亮度」折算成正弦模型的一音。
## 返回空 ⇒ 该乐器没配 `sine` 子字典（或采样命中），调用方退回原引擎。
func _sine_pcm_for(midi: int, kind: String, iid_in: String = "") -> PackedFloat32Array:
	var id := _resolve_instr(iid_in)
	var spec := _instr_spec(id)
	var freq := midi_to_freq(midi)
	## ★ 2026-11-05 第七/九轮：弦区**亮度与余音**都只给古筝，其它乐器逐位退回旧口径。
	##   （第九轮初版把余音放给所有乐器 ⇒ 二胡重合成表长度对不上，判据 ㊷ 当场报红。）
	var zmid_sine := midi if id == "guzheng" else -1
	var seconds := _seconds_for_kind(kind, zmid_sine)
	var bk := _bright_for_kind(kind, zmid_sine)
	var bright := clampf(float(spec.get("bright", brightness)) + instr_bright
		+ (bk - brightness), 0.05, 1.0)
	## ★ 采样优先：真录音永远比合成更像真的。`instr_sample_dir` 非空且命中时，
	##   即使 `sine_mix = 1` 也走采样 —— 否则「有了更好的一档却被正弦模型盖掉」。
	var smp := _sample_pcm(id, midi, seconds, bright)
	if smp.size() > 0:
		return smp
	## ★ 与 `_pluck_ext_pcm()` 同一口径：`decay` 是 T60 倍率，`secs = 音长 × decay`。
	var secs := maxf(seconds * float(spec.get("decay", 1.0)), 0.05)
	return _sine_pcm(freq, secs, bright, spec)


## ★★ 古筝**早退**：直接返回 `pluck_pcm()` 的那个数组 —— 这是"出厂音色一字节不动"的
##   唯一保证（既有单音件字节锚 md5 `61043c95…` 靠它继续成立）。
## ★ 换乐器时的亮度口径：`乐器基准 + instr_bright + (本音族亮度 − 全局 brightness)`。
##   第三项是**相对**量，所以「装饰短音比单音更亮」这类既有关系在换乐器后仍然成立；
##   若写成绝对值，换到琵琶（基准 0.82）后所有音族会挤到同一个亮度上（静默丢失层次）。
func _instr_pcm_base(midi: int, kind: String, iid_in: String = "") -> PackedFloat32Array:
	var freq := midi_to_freq(midi)
	var id := _resolve_instr(iid_in)
	## ★ 2026-11-05 第七轮：只有古筝的 note 吃弦区亮度；`midi < 0` = 旧口径逐位退化。
	var zmid := midi if id == "guzheng" else -1
	var secs := _seconds_for_kind(kind, zmid)
	var bk := _bright_for_kind(kind, zmid)
	if id == "guzheng":
		return pluck_pcm(freq, secs, bk)
	var spec := _instr_spec(id)
	var bright := clampf(float(spec.get("bright", brightness)) + instr_bright
		+ (bk - brightness), 0.05, 1.0)
	# ★ 采样族优先（默认关，见 `instr_sample_dir`）。**返回空 = 本音不归采样管** ⇒ 往下走合成。
	#   这条分支放在 `bright` 之后：采样也要吃同一份亮度口径，否则换到采样后
	#   "装饰短音比单音更亮"这条既有关系会静默消失。
	var smp := _sample_pcm(id, midi, secs, bright)
	if smp.size() > 0:
		return smp
	match str(spec.get("family", "pluck")):
		"pluck":
			return _pluck_ext_pcm(freq, secs, bright, spec)
		## ↓ 三个 STK 移植族（2026-10-29）：非线性在模型内部，`bright` 只在末尾收口
		"flute":
			return _stk_flute_pcm(freq, secs, bright, spec)
		"reed":
			return _stk_reed_pcm(freq, secs, bright, spec)
		"bow":
			## ★★ 2026-10-31 二胡换引擎：物理模型（`_stk_bowed_pcm`）被用户裁决"不像二胡"，
			##   改用保共鸣重合成（`_erhu_resyn_pcm`，= 离线 v3 的引擎版）。
			##   `erhu_resyn_mix = 0` 时**原样**退回物理模型 ⇒ 回滚是一行改旋钮，不用改代码。
			var erm := clampf(erhu_resyn_mix, 0.0, 1.0)
			if erm <= 0.0001:
				return _stk_bowed_pcm(freq, secs, bright, spec)
			var rs := _erhu_resyn_pcm(freq, secs, bright, spec)
			## 表缺失 ⇒ 空数组 ⇒ 退回物理模型（不能静默失声）
			if rs.is_empty():
				return _stk_bowed_pcm(freq, secs, bright, spec)
			if erm >= 0.9999:
				return rs
			var bow := _stk_bowed_pcm(freq, secs, bright, spec)
			var m := mini(bow.size(), rs.size())
			var mix := PackedFloat32Array()
			mix.resize(m)
			var iw := 1.0 - erm
			for i in m:
				mix[i] = iw * bow[i] + erm * rs[i]
			return mix
		"sustain":
			return _sustain_pcm(freq, secs, bright, spec)
		"bell":
			return _bell_pcm(freq, secs, bright, spec)
	return pluck_pcm(freq, secs, bk)


## 事件种类 → 余音长度 / 激励亮度。★★ **唯一真源**：在线取流（`wav_for()`）与离线渲染
## （`render_offline()`）都必须走它。此前那两处各写了一份 `if kind == "pad"` ——
## 加第三种 kind（2026-10-16 的 `tick`）时"只改一处"是**必然**发生的，而症状是
## "在线听是短促的读秒声、离线验收 wav 里却是长音"，两边都不报错。
##
## ★★ 2026-10-16 五族齐备（用户口令「减少同时弹奏的和弦」）：
##   `arp` = 琶音（和弦音：**短于** note，否则相邻小节的和弦会叠起来）
##   `orn` = 装饰短音（刮奏/摇指/倚音/泛音共用，0.6s：必须远短于 arp，
##           因为刮奏是 7~8 个音在 0.4 秒里跑完）
##   ⚠️ 加族时**必须**同时加进 `_timbre_fp()`：不进指纹 ⇒ 运行期改它不失效缓存
##      ⇒ "调了参数却没变化"那种静默缺陷（同 `_wav_cache_guard` 的注释）。
##
## ★★★ 2026-10-16 深夜：`arp` 这一族改成**派生量** `minf(arp_seconds, _arp_fit_seconds())`。
##   为什么允许它与其他四族不同：另外四族是**音色**（一根弦衰多快，与曲子快慢无关），
##   而 `arp` 还背着一份**结构契约** —— 和弦族不许跨小节。契约里含"小节有多长"，
##   小节长随 BPM 变，所以这一族只能由当前速度算出来，不能是一个固定秒数。
##   ★ 这个 `minf` 的**单一读点就在这里**：调度、在线取流、离线渲染、判据四条路都走它
##     ⇒ "在线听的和弦比验收 wav 里短"这类静默分家不可能发生（守卫 S68/S71 钉这一点）。
## ★★ 2026-11-05 第九轮加第二参：`midi >= 0` 时对**旋律音**按音区折算 T60。
##   `midi = -1`（默认）= 只问「这一族多长」⇒ 所有不传音高的老调用点逐位退回旧值。
##   ★ 三条必须同源的读取方都传事件音高：合成器（`_instr_pcm_base` / `_sine_pcm_for`）、
##     `simul_stats()` 的重叠口径、⑰⑱ 环路/阻尼反算。漏一个就是「波形长度与统计/判据
##     分家」，而且静默（§133 一个量服务两个语义）。
##   ★ 余音用**对称**的 `_zone_u_raw()`，不吃 `zone_low_soft`（那是亮度轴的感知旋钮）。
func _seconds_for_kind(kind: String, midi: int = -1) -> float:
	var base := note_seconds
	match kind:
		"pad":
			base = pad_seconds
		"tick":
			base = tick_seconds
		"arp":
			base = minf(arp_seconds, _arp_fit_seconds())
		"orn":
			base = orn_seconds
		"bass":
			## ★ 2026-11-05 第六轮：低音勾托的「悠长」由这里单独给，不再蹭 `note_seconds`。
			base = maxf(bass_seconds, 0.05)
	if kind == "note" and midi >= 0 and zone_enabled:
		base = maxf(base * (1.0 - zone_decay * _zone_u_raw(midi)), 0.05)
	return base


## 弦区折算的**底层真源**（纯函数、对称）：u = −1 低音区 / 0 中性点 / +1 高音区。
## ★ 69 处必须严格返回 0：㉞ 与单音验收件都量的是这个音，乘 1.0 才逐位不变。
func _zone_u_raw(midi: int) -> float:
	return clampf(float(midi - ZONE_CENTER_MIDI) / maxf(zone_span, 1.0), -1.0, 1.0)


## 亮度轴用的折算量（含低音半轴柔化）。★ 11-05 第八轮：非对称性放在这里，
##   别在 `_bright_for_kind()` 里另写一份（否则判据读的真源与合成用的会分家）。
##   u=0 时不受影响 ⇒ 中性点 69 仍逐位不变。
func _zone_u(midi: int) -> float:
	var u := _zone_u_raw(midi)
	if u < 0.0:
		u *= clampf(zone_low_soft, 0.0, 1.0)
	return u


func _bright_for_kind(kind: String, midi: int = -1) -> float:
	if kind == "tick":
		return tick_brightness
	if kind == "orn":
		return orn_brightness
	if kind == "bass":
		## ★ 2026-11-05 第六轮：低音「浑厚」＝激励更暗，与全局 `brightness` 分开。
		return clampf(bass_bright, 0.05, 1.0)
	var b := brightness
	## ★★ 2026-11-05 第七轮：弦区音色。`midi >= 0` 才生效 ⇒ 所有不传音高的老调用点
	##   （判据、㊻⑦ 的设计基准、simul_stats 之外的读数）全部逐位退回旧口径。
	if kind == "note" and midi >= 0 and zone_enabled:
		b = clampf(b * (1.0 + zone_bright * _zone_u(midi)), 0.05, 1.0)
	return b


func _timbre_fp() -> String:
	# ★★ 11-05 第五轮：**`dyn_*` 三个旋钮刻意不进指纹**。它们只改事件的 `vel`
	#   （播放/渲染时乘的增益倍率），不改任何一个音的波形；`_wav_key()` 也不含 vel。
	#   ⇒ 缓存里的流仍然是对的，不存在「拧了旋钮没反应」。反过来，把它们塞进指纹只会
	#   让每次调力度都白白重合成整张缓存表。调度层参数与波形参数的界就画在这里。
	# ★ `excit_noise` 必须进指纹：不进的话运行期改它**不失效缓存** ⇒
	#   "调了参数却没变化"是静默的（同 _wav_cache_guard 那几句注释）。
	# ★★ 环路修复开关与 g0 上限同理 —— 它们改的是**每一个音**，不进指纹就是
	#   "拧了开关没反应"那种静默缺陷。
	# ★ 读秒声的两个参数同理（它们只影响 `tick` 这一族，但取值就是"每一个 tick 音"）。
	# ★★ 2026-10-16 新增三族同理：`arp` / `orn` 的时长与亮度不进指纹 ⇒ 运行期把它们
	#   改短改亮**不会有任何变化**（缓存里还是旧值）—— "拧了旋钮没反应"是最典型的静默缺陷。
	# ★★★ 2026-10-29 多乐器：乐器 id 与六个旋钮全部进指纹。★ 为什么连 id 也要进：
	#   `instrument_id == ""`（跟随曲风）时它是**派生量**，换曲风而指纹不变的话，
	#   缓存里还留着上一件乐器的流 ⇒ 换曲风"换了调没换声"，而且**静默**。
	# ★★ 2026-10-29 采样族：`instr_sample_dir` 也进指纹。不进的话，运行期把采样包目录
	#   从空改成有（或换一套）时缓存里还是旧的合成流 ⇒「开了采样没反应」静默缺陷。
	return "%d|%.3f|%.2f|%.2f|%d%d|%.3f|%.3f|%.2f|%.3f|%.3f|%.2f|%s|%.2f|%.2f|%.2f|%.2f|%.2f|%.2f|%s|%.2f|%.2f|%.2f|%.2f|%.2f|%s|%.2f|%d|%.3f|%d|%.2f|%.2f|%.2f|%.2f|%.2f|%.3f|%.2f|%d|%.2f|%.2f|%.2f|%.2f" % [
		sample_rate,
		note_seconds, brightness,
		excit_noise, 1 if loop_pitch_fix else 0, 1 if loop_loss_fix else 0, loop_damp_max,
		tick_seconds, tick_brightness, arp_seconds, orn_seconds, orn_brightness,
		_instr_id(), instr_bright, instr_breath, instr_vibrato, instr_detune,
		instr_attack, instr_body, instr_sample_dir,
		## ★ 2026-10-30 新增两个拨弦旋钮也必须进指纹：不进就是"拧了没反应"的静默缺陷
		##   （`pluck_air` / `pluck_char` 改的是**每一个**弹拨音）。
		pluck_air, pluck_char,
		## ★★ 2026-10-30 正弦模型三件同理，而且更危险：`sine_mix` 从 0 拧到 1 是
		##   **换整套引擎**。不进指纹的话，运行期把它打开**什么都不会变**（缓存里还是
		##   旧引擎的流），而用户看到的现象是"开关坏了"—— 这正是最典型的静默缺陷。
		sine_mix, sine_life, sine_air,
		## ★★ 2026-10-31 二胡专属档同理：`erhu_resyn_mix` 也是**换引擎**的开关，
		##   不进指纹就是"拧了没反应"。表路径也进：换一张分析表必须重算。
		erhu_resyn_path, erhu_resyn_mix, erhu_resyn_hmax,
		## ★★★ 2026-11-03 钟的拍频深度同理，而且它是**结构开关**（0 = 每分音退回单条
		##   谐振器，声音从"金属钟"变成"电子铃"）。不进指纹 ⇒ 拧它听不出任何变化，
		##   而用户会把它当成"这个旋钮没用"。
		bell_beating,
		## ★ 2026-11-05 古筝·韵：这六个量改的是**每一个旋律音的波形**，
		##   不进指纹就是「拧了旋钮没反应」（同 sine_mix 的理由）。
		1 if yun_enabled else 0, yun_ratio, yun_slide, yun_slide_sec, yun_vibrato, yun_vib_hz,
		## ★★ 2026-11-05 第六轮：低音专属的时长/亮度改的是 `bass` **每一个音的波形**，
		##   与第五轮 `dyn_*`（只改播放增益倍率）恰好相反 ⇒ 必须进指纹，否则运行期拧旋钮
		##   缓存不失效、听感不变（§33「死参数」）。判据 ㊻⑦ 有两个阴性对照钉这一点。
		bass_seconds, bass_bright,
		## ★★ 2026-11-05 第七轮：弦区折算改的是**每一个古筝旋律音的激励波形** ⇒ 三个量
		##   必须都进指纹，否则运行期拧旋钮缓存不失效、听感不变（§33 死参数）。
		##   与第五轮 `dyn_*`（只改播放增益）恰好相反。判据 ㊽ 有阴性对照钉这一点。
		1 if zone_enabled else 0, zone_span, zone_bright,
		## ★ 11-05 第八轮：低音柔化也改每一个低音旋律音的激励波形 ⇒ 同样必须进指纹。
		zone_low_soft,
		## ★ 11-05 第九轮：`zone_decay` 改每个旋律音的**数组长度** ⇒ 必须进指纹。
		zone_decay]


func _wav_cache_guard() -> void:
	# 音色参数变了 ⇒ 旧缓存全废（否则"调了参数却没变化"是静默的）
	var fp := _timbre_fp()
	if fp != _cache_fp:
		_wav_cache.clear()
		_wav_used.clear()
		## ★ 队列与在飞任务也必须一起丢：它们带的 key 里嵌的是**旧指纹**，
		##   回填时会被 `_pw_pump()` 的指纹检查拦掉，但队列会白留着永不命中。
		_pw_queue.clear()
		_pw_queued.clear()
		_pw_infly.clear()
		_pw_planned_at = -1
		_cache_fp = fp
	## ★★ 这里原来还有一句 `if _wav_cache.size() > 128: _wav_cache.clear()`。
	##   已换成 `wav_for()` 末尾的 `_wav_evict()`（LRU）。理由见 `wav_cache_max` 的注释：
	##   整体清空是"崖式失效" —— 它不降级，它把缓存一次归零，然后每个音重新冻 57~94ms。
	##   而那一刻往往发生在最长的一局里（键空间随局势连续变化而增长）。


## 按 LRU 淘汰到 `wav_cache_max` 以内。**永不整体清空**（那就是原来那个悬崖）。
## ★ 跳过仍在预热队列里的键：它们马上要用，淘汰掉等于白合成一次。
## ★ `oldest == ""` 就 break：全部候选都被保护时宁可暂时超上限，也不要死循环。
func _wav_evict() -> void:
	var cap := maxi(wav_cache_max, 8)
	if _wav_cache.size() <= cap:
		return
	while _wav_cache.size() > cap:
		var oldest := ""
		var best := 0x7FFFFFFFFFFFFFFF
		for k in _wav_used:
			if not _wav_cache.has(k):
				continue
			if _pw_queued.has(k):
				continue
			var u: int = int(_wav_used[k])
			if u < best:
				best = u
				oldest = str(k)
		if oldest == "":
			return
		_wav_cache.erase(oldest)
		_wav_used.erase(oldest)


## 查一步的事件要哪些缓存键（**只算键，不合成**）。`_pw_plan()` 与判据共用这一份，
## 免得"判据自己另写一遍键的拼法"而两边悄悄分家（§70）。
func _keys_of_step(k: int, ax: Dictionary, cue: String = "") -> Array:
	var out: Array = []
	for e in _schedule_step(k, ax, cue):
		var at := float(e.get("at", 0.0))
		var ins := str(e.get("instr", ""))
		## ★ id 一直带到第 5 格：`_pw_pump()` 用它在**后台线程**合成同一件乐器。
		##   丢掉它 ⇒ 预热合成的是主乐器、播放要的是钟 ⇒ 缓存永不命中（钟每次都主线程合成）。
		out.append([_wav_key(int(e["midi"]), str(e["kind"]), at, ins),
			int(e["midi"]), str(e["kind"]), at, ins])
	return out


## 把未来 `prewarm_steps` 步要用到的音排进预热队列。
## ★★ 预测的**工具**是当前这一份四轴（`_ax_last`）：`_schedule_step(k, ax, cue)` 是纯函数、
##   按显式 k 播种、无副作用（`render_offline()` 的注释钉着这一点），所以"预演未来几步"
##   就是真调它。★ 唯一的偏差：跨小节时 `axes_now()` 会变，而预测还按旧四轴 ⇒
##   预测失败。失败**只退化成一次同步合成**（`wav_for()` 的未命中路径照旧），不影响正确性。
##   提前量 8 步 ≈ 3.3s，比一小节（3.33s）相当 ⇒ 偏差面被限制在一小节之内。
## ★ `cue` 一律按 "" 预测：特殊时刻只有在真的发生提子/吃子时才知道，
##   而它本身很稀有（判据 ㉚ 里有占比）⇒ 按 "" 预测的命中率已经足够高。
func _pw_plan(ax_in: Dictionary = {}) -> void:
	if prewarm_steps <= 0 or prewarm_workers <= 0:
		return
	## `ax_in` 只给 `_pw_warm_sync()` 用（起播那一刻还没有 `_ax_last`）。
	## ★ 这样 `_ax_last` 仍然只有 `_on_step()` 一个写点。
	var ax := _ax_last if ax_in.is_empty() else ax_in
	if ax.is_empty():
		return
	_wav_cache_guard()
	for j in range(1, prewarm_steps + 1):
		for it in _keys_of_step(_step_idx + j, ax, ""):
			var key := str(it[0])
			if _wav_cache.has(key) or _pw_queued.has(key):
				continue
			_pw_queued[key] = true
			_pw_queue.append(it)


## 每帧收一次已完成的后台合成，再发最多 `prewarm_workers` 个新任务。
## ★ 主线程在这里只做 `_pcm_to_wav()`（2~3ms/音）并把结果塞进缓存。
func _pw_pump() -> void:
	if prewarm_workers <= 0:
		return
	# ---------- ① 收已完成 ----------
	var done: Array = []
	for tid in _pw_infly:
		if WorkerThreadPool.is_task_completed(int(tid)):
			done.append(tid)
	var committed := 0
	for tid2 in done:
		if committed >= maxi(prewarm_commit_per_frame, 1):
			break
		var job: Dictionary = _pw_infly[int(tid2)]
		WorkerThreadPool.wait_for_task_completion(int(tid2))
		_pw_infly.erase(int(tid2))
		committed += 1
		var pcm: Variant = job["box"][0]
		if pcm == null:
			continue
		var key := str(job["key"])
		## 指纹已变 ⇒ 这一份的 key 属于旧音色，丢掉（否则"换了乐器听到旧声"，静默缺陷）
		## ★★ 指纹必须**随任务一起存**，不能从 key 里切出来：key 是 `midi|kind|pad|指纹`
		##   四段格式，而指纹**自身就含 `|`**（24 个字段）⇒ `get_slice("|", 3)` 只会拿到
		##   指纹的第一段（`22050`），与整串永远不等 ⇒ 每个回填都被当成"指纹已变"丢掉。
		##   这个 bug 的表现是**预热完全不生效**，而且不报任何错。
		if str(job["fp"]) != _cache_fp:
			continue
		if _wav_cache.has(key):
			continue
		_wav_cache[key] = _pcm_to_wav(pcm)
		_wav_tick += 1
		_wav_used[key] = _wav_tick
		_wav_evict()
	# ---------- ② 发新任务 ----------
	while _pw_infly.size() < prewarm_workers and not _pw_queue.is_empty():
		var it: Array = _pw_queue.pop_front()
		var key2 := str(it[0])
		_pw_queued.erase(key2)
		if _wav_cache.has(key2):
			continue
		## ★ 指纹快照跟着任务走（见上面 `job["fp"]` 的注释：key 里的 `|` 不唯一）
		var fp2 := _cache_fp
		var midi := int(it[1])
		var kind_s := str(it[2])
		var at := float(it[3])
		var ins2 := str(it[4]) if it.size() > 4 else ""
		## ★ 预分配一格 Array 当"信封"：工作线程只写 `box[0]`、主线程读 `box[0]`。
		##   不能在工作线程里往 `_pw_infly` 这个 **Dictionary** 插键 —— Godot 的 Dictionary
		##   并发插入会损坏（它不是线程安全的）。事先建好信封就没有并发写字典这件事。
		var box: Array = [null]
		var tid3 := WorkerThreadPool.add_task(
			func() -> void: box[0] = voice_pcm(midi, kind_s, at, ins2), false, "music_prewarm")
		_pw_infly[tid3] = {"key": key2, "box": box, "fp": fp2}


## 同步预热（只在 `play_bgm()` 用一次）：把队列里最靠前的若干音**当场**合成。
## `budget_ms` 是上界；因为一个音就 57~94ms，所以实际是"至少做一个、超预算就停"。
func _pw_warm_sync(budget_ms: int) -> void:
	if prewarm_steps <= 0 or budget_ms <= 0:
		return
	_wav_cache_guard()
	## 起播那一刻 `_ax_last` 还是空的（`_on_step()` 还没跑过）⇒ 用"无战况"的四轴当预测。
	## `axes_now({})` 接受显式快照，不读场景 ⇒ 没有 `_read_battle_state()` 那个"识别刚落子"的副作用。
	_pw_plan(_ax_last if not _ax_last.is_empty() else axes_now({}))
	var t0 := Time.get_ticks_usec()
	while not _pw_queue.is_empty():
		var it: Array = _pw_queue.pop_front()
		var key := str(it[0])
		_pw_queued.erase(key)
		if _wav_cache.has(key):
			continue
		wav_for(int(it[1]), str(it[2]), float(it[3]), str(it[4]) if it.size() > 4 else "")
		if Time.get_ticks_usec() - t0 >= budget_ms * 1000:
			break


## 特殊时刻的**钟声层**要在起播时一次性合成好（2026-11-03）。
##
## ★★ 为什么必须单独做：`_pw_plan()` 一律按 `cue = ""` 预测（见那里的注释），
##   所以钟声永远不会进预热队列。而钟声出现的时刻恰好是"提子/终局"那一瞬间 ——
##   玩家最在意、也最不该卡的那一下。让它当场在主线程合成是**主动制造卡顿**。
## ★ 代价可忽略：`CUE_IDS` 六个时刻各 1 个钟音（`_bell_pcm` 六个分音，实测数毫秒级），
##   比一次未命中的 `pad`（~22ms）还便宜。
## ★ 只预热**真的有角色**的事件：主乐器那条已经在 `_pw_warm_sync()` 的覆盖范围内
##   （而它的 cue 版本其实也没预热 —— 那部分留给"首次同步合成"，判别据 ㊶ 的观测）。
func _pw_warm_cue_bells() -> void:
	if not cue_bell_enabled:
		return
	for cq in CUE_IDS:
		for e in _cue_events(str(cq)):
			var ins := str(e.get("instr", ""))
			if ins == "":
				continue
			wav_for(int(e["midi"]), str(e["kind"]), float(e.get("at", 0.0)), ins)


## ★★ 单声部音源 —— **在线与离线唯一**的合成入口（守卫 S68 钉的就是这一点）。
##
## `at` = 这个音在**本步之内**的起音偏移（秒）。实现方式是**前置静音**（把 PCM 前面补
## `at` 秒的 0），于是"琶音错开 / 刮奏 / 摇指"这件事在两条路上**逐采样等价**。
##
## ★★ 为什么不能"在线用定时器、离线用采样偏移"：那两条路会**静默分家** ——
##   在线听是琶音、验收 wav 里却是齐奏（或反过来），而两边都不报任何错，
##   判据 ⑬⑭ 只看长度与非静音也照样绿 ⇒ 那时"人耳验收件"就再也不代表玩家听到的东西了。
##   把偏移折算成样本、两条路共用这一份 PCM，等于让"同源"成为**构造成立**的事实。
##
## ★ `at <= 0` ⇒ **原样返回** `pluck_pcm()` 的那个数组（逐位相同）：
##   没有特殊时刻、`arp_step = 0`、旧调用点 —— 全部一个字节都不动。
## `at`（错开起音量，秒）折算成**前置静音样本数** —— **单真源**（守卫 S106 钉着）。
## ★★ 为什么必须是单真源：这个数有**两个**消费者，而且它们必须永远一致 ——
##   ① `voice_pcm()` 拿它铺前置静音（真正的音响效果）；
##   ② `wav_for()` 拿它进**缓存键**（错开量不同的音不能共用一份流；不带它 ⇒ 琶音静默退回齐奏）。
##   两份各写一遍的话，一处改了另一处没改是必然的，而且**两边都不报错**：
##   · 只改 ① ⇒ 缓存键把两个错开量不同的音判成同一个 ⇒ 后一个拿到前一个的流（齐奏复活）；
##   · 只改 ② ⇒ 缓存里全是不带静音的流，琶音听起来没发生。
## ★ 取整用 `round` 而不是 `int`：`at` 来自 `_arp_gap() × i`（浮点乘），
##   `int()` 会把 0.0899999 截成 0 ⇒ 两个和弦音撞进同一格。
## ★ 采样率下限 8000 与 `_pcm_to_wav()` / `_ring_len()` 同一口径。
func _at_pad(at: float) -> int:
	return int(round(maxf(at, 0.0) * float(maxi(sample_rate, 8000))))


## ★★★ 2026-11-05 古筝·韵：**单音内部的按滑 / 揉弦**。
##
## 物理做法：对 KS 输出做**变速率重采样**（相位累加），不是把整段音频整体变速。
##   瞬时半音偏移 d(t) → 瞬时速率 2^(d/12)，累加得到读取位置。d(t) = 0 时速率 = 1
##   ⇒ 输出与输入**逐样本相同**（稳态音准不漂、音长不变）。
## ★ 11-05 第二轮：首版四种形态（上/下/回滑 + 揉弦）按 `posmod(midi,4)` 轮换，
##   相邻两个旋律音一个往上扭、一个往下扭 ⇒ 用户原话「有点像喝醉了弹的」。
##   ⇒ 收敛为**两种**：上滑（只音头，从下方按到本音）与揉弦（围绕 0 的渐入渐出）。
##   下滑/回滑整段把音拉低，最容易听成走音，去掉。
## ★ 两种形态的 d(t) **终值都回到 0** ⇒ 稳态音准不漂。
## ★ 只从 midi 派生形态 ⇒ 同一音每次一样，`_schedule_step()` 的纯函数性不被破坏。
func _yun_pcm(body: PackedFloat32Array, midi: int) -> PackedFloat32Array:
	var n := body.size()
	var ratio_max := clampf(yun_ratio, 0.0, 1.0)
	var slide_amt := 0.55 * clampf(yun_slide, 0.0, 3.0)
	var vib_amt := clampf(yun_vibrato, 0.0, 2.0)
	if n < 16 or ratio_max <= 0.0 or (slide_amt <= 0.0 and vib_amt <= 0.0):
		return body
	if float(posmod(midi * 37 + 11, 1000)) >= 1000.0 * ratio_max:
		return body
	var shape := posmod(midi, 2)          # 0 上滑 / 1 揉弦
	var sr := float(maxi(sample_rate, 8000))
	var st := maxf(yun_slide_sec, 0.02)
	var vhz := maxf(yun_vib_hz, 0.5)
	var out := PackedFloat32Array()
	out.resize(n)
	var acc := 0.0
	for i in n:
		var t := float(i) / sr
		var semis := 0.0
		var u := 0.0
		if shape == 0:
			## 上滑用 smoothstep 缓入缓出：线性会在音头留下一个「跳一下」的台阶。
			u = clampf(t / st, 0.0, 1.0)
			semis = -slide_amt * (1.0 - u * u * (3.0 - 2.0 * u))
		else:
			## 渐入 0.12→0.30s，1.0s 后渐出、2.0s 归零 ⇒ 长音尾不会一直抖。
			var vin := clampf((t - 0.12) / 0.30, 0.0, 1.0)
			var vout := 1.0 - clampf((t - 1.0) / 1.0, 0.0, 1.0)
			semis = (9.0 * vib_amt / 100.0) * vin * vout * sin(TAU * vhz * t)
		var rate := pow(2.0, semis / 12.0)
		var j := int(acc)
		if j + 1 >= n:
			out[i] = 0.0
		else:
			out[i] = lerpf(body[j], body[j + 1], acc - float(j))
		acc += rate
	return out


func voice_pcm(midi: int, kind: String, at: float = 0.0, id_in: String = "") -> PackedFloat32Array:
	# ★★ 2026-10-29：音源从 `pluck_pcm()` 换成 `instr_pcm()`（多乐器分发）。
	#   古筝仍在 `instr_pcm()` 里**早退**到 `pluck_pcm()` ⇒ 出厂档逐位不变（判据 ㉞ 钉着）。
	# ★★ 2026-11-03：`id_in` = 事件级乐器（特殊时刻钟声）。空 ⇒ 主乐器，逐位不变。
	var body := instr_pcm(midi, kind, id_in)
	## ★★ 2026-11-05 古筝·韵：只给**古筝的旋律音**加。关闸 / 非古筝 / 和弦音（arp、pad、
	##   tick、orn）全部原样透传 ⇒ 出货逐字节不变，和声不变量一个都不碰。
	if yun_enabled and kind == "note" and _resolve_instr(id_in) == "guzheng":
		body = _yun_pcm(body, midi)
	var pad := _at_pad(at)
	if pad <= 0:
		return body
	var out := PackedFloat32Array()
	out.resize(pad + body.size())
	for i in body.size():
		out[pad + i] = body[i]
	return out


## 取（并缓存）某个音的 AudioStreamWAV。`kind` 决定时长/亮度（走 `_seconds_for_kind()` /
## `_bright_for_kind()`），`at` 走 `voice_pcm()` 折成前置静音。
## ★ 缓存键必须带上**折算后的静音样本数**（不能只带 `at` 的浮点数：那样 0.0901 与 0.0899
##   会各占一格而拿到同一份流，白占内存；也不能不带：不带就等于"错开量不同的音共用一份流"
##   ⇒ 琶音会静默退回齐奏）。
## ★ 缓存键的**唯一拼法**（`wav_for()` / `_keys_of_step()` 共用，铁律 18/70）。
## ★★ 2026-11-03 加第四段 `乐器 id`：同一 midi/kind 在**钟**与**古筝**下是两份流。
##   不写进键的后果是具体的：钟声那条事件会命中古筝那格缓存 ⇒ **钟永远不响**
##   （而且键里原来只有 `_cache_fp`，它含的是**全局** `_instr_id()`，与事件级乐器无关）。
##   这一段必须和 `voice_pcm()` 的第三参数用**同一个** `_resolve_instr()` 解析结果，
##   否则"键里写的乐器"与"合成用的乐器"会分家 ⇒ 换乐器听到旧声。
const WAV_KEY_FMT := "%d|%s|%d|%s|%s"

func _wav_key(midi: int, kind: String, at: float, id_in: String = "") -> String:
	return WAV_KEY_FMT % [midi, kind, _at_pad(at), _resolve_instr(id_in), _cache_fp]


func wav_for(midi: int, kind: String, at: float = 0.0, id_in: String = "") -> AudioStreamWAV:
	_wav_cache_guard()
	# ★ 缓存键里的 `pad` 与 `voice_pcm()` 里铺静音用的是**同一个数**（`_at_pad()`，守卫 S106）。
	var key := _wav_key(midi, kind, at, id_in)
	_wav_tick += 1
	if _wav_cache.has(key):
		_wav_used[key] = _wav_tick
		return _wav_cache[key]
	## ★★ 走这里 = **主线程上真的合成了一次**。预热生效时这个分支在稳态下不该被走到
	##   （判据 ㊶ 就盯着这个数在 pump 期间不涨）。把它留在原位是**正确性**要求：
	##   预测失败（跨小节换四轴、cue 突然出现、预热被关掉）时必须还有一条能出声的路。
	_synth_on_main += 1
	var w := _pcm_to_wav(voice_pcm(midi, kind, at, id_in))
	_wav_cache[key] = w
	_wav_used[key] = _wav_tick
	_wav_evict()
	return w


func _pcm_to_wav(pcm: PackedFloat32Array) -> AudioStreamWAV:
	var bytes := PackedByteArray()
	bytes.resize(pcm.size() * 2)
	for i in pcm.size():
		bytes.encode_s16(i * 2, int(clampf(pcm[i], -1.0, 1.0) * 32767.0))
	var w := AudioStreamWAV.new()
	w.format = AudioStreamWAV.FORMAT_16_BITS
	w.mix_rate = maxi(sample_rate, 8000)
	w.stereo = false
	w.data = bytes
	w.loop_mode = AudioStreamWAV.LOOP_DISABLED
	return w


func _is_headless() -> bool:
	return DisplayServer.get_name() == "headless"


func _play_event(e: Dictionary, accent: bool) -> void:
	if muted or _is_headless():
		if _is_headless() and not _no_audio_warned:
			_no_audio_warned = true
			print("[Music] headless：不实际发声（只跑调度；判据靠数值不靠听）")
		return
	if _pool.is_empty():
		return
	var p := _pool[_pool_i % _pool.size()]
	_pool_i += 1
	p.stream = wav_for(int(e["midi"]), str(e["kind"]), float(e.get("at", 0.0)),
		str(e.get("instr", "")))
	var db := linear_to_db(maxf(bgm_volume, 0.0001)) + linear_to_db(clampf(_event_gain(e), 0.01, 1.0))
	p.volume_db = db + (3.0 if accent else 0.0)
	p.play()


# ===== 离线渲染（供人耳验收 + 供工作区 Python 做独立频谱验证） =====
## 用**同一份** `_schedule_step()` 与**同一份** `voice_pcm()` 把 N 秒渲染成 PCM。
## ★ 这不是"另写一个合成器"：调度与合成都是调同一批函数，所以验证的是**引擎真实输出**。
## ★ 无副作用：调度按**显式传入的 k** 播种（不用 `_step_idx`），渲染完不改动本节点任何状态。
## `st` 非空且带局势层 ⇒ 走四轴；否则用 `tension` 走退化档（旧口径，逐字节不变）。
## `cues` = 「步号 → 时刻名」的**注入表**（只给验收件与自检用）：它让"吃子时会响什么"
##   不必真等一次吃子才听得到。默认空 ⇒ 与改造前逐字节相同。
func render_offline(seconds: float, tension: float, st: Dictionary = {},
		cues: Dictionary = {}) -> PackedFloat32Array:
	var sr := maxi(sample_rate, 8000)
	var n := maxi(int(seconds * float(sr)), 8)
	var mix := PackedFloat32Array()
	mix.resize(n)
	var sd := step_seconds()
	var ax := axes_from(tension, st)
	var steps := int(seconds / sd) + 1
	for k in range(1, steps + 1):
		var start := int(float(k - 1) * sd * float(sr))
		if start >= n:
			break
		## ★ 11-05 第十一轮：只给长 A/B 件用的「局势演进」轨迹（离线验收仪器）。
		##   默认 `form_trace=false` ⇒ ax 仍是循环外那一份、逐位不变。
		if form_trace:
			var tt := clampf(float(k - 1) / float(maxi(steps - 1, 1)), 0.0, 1.0)
			ax = axes_from(lerpf(form_trace_lo, form_trace_hi, tt), st)
			## ★ 验收仪器「冒充」战况档 ⇒ 段落层在长件里生效（在线真战况本来就是 state）。
			##   只改这一个标记，不动四轴数值；默认 form_trace=false ⇒ 整个分支不进。
			ax["src"] = "state"
		for e in _schedule_step(k, ax, str(cues.get(k, ""))):
			var kind_s := str(e["kind"])
			# ★ 时长的真源在 `voice_pcm()` → `_seconds_for_kind()`（与在线 `wav_for()` 同一处）
			#   —— 离线这一侧**不重写** `if kind == "pad"`：那正是上一版的分叉点。
			# ★ `at` 也在 `voice_pcm()` 里折成前置静音 ⇒ 两条路的"错开起音"逐采样等价。
			# ★ `instr` 同理：钟声层必须是**同一件乐器**，否则"在线是钟、验收件里是古筝"。
			var voice := voice_pcm(int(e["midi"]), kind_s, float(e.get("at", 0.0)),
				str(e.get("instr", "")))
			var g := _event_gain(e) * bgm_volume
			for i in voice.size():
				var j := start + i
				if j >= n:
					break
				mix[j] += voice[i] * g
	return mix


## 特殊时刻的**验收件**：把 `CUE_IDS` 里每个乐句各渲染一段，首尾相接成一个 wav。
##
## ★★ 为什么必须有它：乐句好不好听**只能**由耳朵裁决，而在游戏里要听到"吃子那一下"
##   得真等到一次提子（还要正好是那一步）—— 六个时刻一次听全，才有可比较的验收件。
##   同 `--musicdump` 的理由：把"没验"变成"能验"。
## ★ 每段都是**正常的小节床 + 一句乐句**（乐句落在第 2 个小节头，`cue_step`），
##   所以听到的是它真实的上下文，而不是一句孤立的音型。
## ★ 打印时间轴是**判据的一部分**：不听时间轴就无法知道哪一段对应哪个时刻
##   （而"听不出来是哪一段"会让整个验收件白做）。
func render_cue_demo(per_seconds: float = 4.5, gap_seconds: float = 0.5) -> PackedFloat32Array:
	var sr := maxi(sample_rate, 8000)
	var out := PackedFloat32Array()
	var gap := maxi(int(gap_seconds * float(sr)), 0)
	var cue_step := maxi(_steps_per_bar(), 1)          # 第 2 个小节头
	var t0 := float(cue_step - 1) * step_seconds()
	print("[Music] 特殊时刻验收件：每段 %.2fs，乐句落在段内第 %.2fs（第 %d 步）" % [
		per_seconds, t0, cue_step])
	for c in CUE_IDS:
		print("        %-12s @ 全曲 %.2fs" % [str(c), float(out.size()) / float(sr)])
		out.append_array(render_offline(per_seconds, 0.0, {}, {cue_step: str(c)}))
		for _i in gap:
			out.append(0.0)
	print("        合计 %.2fs（%d 段 + 段间 %.2fs 静音）" % [
		float(out.size()) / float(sr), CUE_IDS.size(), gap_seconds])
	return out


## **编钟音阶验收件**（2026-11-03，用户口令："这个钟怎么听着不对味…调一下编钟的音阶给我听"）。
## 两遍，各管一件事：
##   ① 宫调五声（D 宫）两个八度上下行 —— 听**音程关系**与"钟和古筝是不是同一个调"；
##   ② D4→D5 十二半音 —— 听**每个半音的音准**（钟的基音有没有跑、有没有被高次分音盖住）。
## ★★ 走 `instr_pcm()` 这条**真源**合成，不另写一套（§70：验收件不许重实现被测逻辑）。
##   听到的必须是游戏里那口钟，否则"调对了"和"听着不对"会各说各话。
## ★ 用 `pad` 这一族渲（钟在曲子里就用 `note`/`pad`，长音才是钟的外形）；
##   `step_s` 是**相邻两音的起音间隔**，比自然音长短 —— 尾音叠着走，正好能听出拍频"嗡不嗡"。
func render_bell_scale(step_s: float = 0.55) -> PackedFloat32Array:
	var sr := maxi(sample_rate, 8000)
	var notes: Array = []
	var pent := [0, 2, 4, 7, 9]
	## ★ 音域**必须覆盖曲子里钟实际会落的音**：cue 的 `base = root_midi + 12 = 62(D4)`，
	##   最低用 `deg[-5]` ⇒ 62 − 12 = 50(D3)，最高 `deg[5]` ⇒ 74(D5)。
	##   从 62 起测（我第一版的做法）会漏掉 D3 那两个低音钟 —— 而"低音钟轰不轰"
	##   恰恰是旧版最刺耳的地方，验收件里听不到它等于没验。
	for o in 2:
		for d in pent:
			notes.append(50 + 12 * o + int(d))
	notes.append(74)
	var up := notes.size()
	for i in range(up - 1, -1, -1):
		notes.append(int(notes[i]))
	var n_pent := notes.size()
	for s in 13:
		notes.append(62 + s)
	var step := maxi(int(step_s * float(sr)), 1)
	var tail := maxi(int(maxf(pad_seconds, 1.0) * float(sr)), 1)
	var n_out := step * maxi(notes.size() - 1, 0) + tail
	var out := PackedFloat32Array()
	out.resize(n_out)
	var use_kind := "pad"
	for k in notes.size():
		var m := int(notes[k])
		var pcm := instr_pcm(m, use_kind, cue_bell_instrument)
		var off := k * step
		var lim := mini(pcm.size(), n_out - off)
		for i in lim:
			out[off + i] += pcm[i]
	out = _norm_peak(out)
	for i in out.size():
		out[i] *= 0.90
	print("[Music] 编钟音阶验收件：%d 个音（前 %d = 五声上下行，后 13 = 十二半音）· 间隔 %.2fs · 拍频深度 %.2f" % [
		notes.size(), n_pent, step_s, bell_beating])
	var head: Array[String] = []
	for k in mini(n_pent, 12):
		head.append("%.1fHz" % midi_to_freq(int(notes[k])))
	print("        五声：%s" % " ".join(head))
	return out


## 乐器验收件（2026-10-29）：每件民族乐器各渲一段，**走同一条调度链**
## （`render_offline()` → `_schedule_step()` → `voice_pcm()` → `instr_pcm()`）
## ⇒ 听到的就是它在游戏里真实的样子，而不是一段孤立的正弦对比。
## ★ 为什么必须要这件东西：音色的最终判据是耳朵，而耳朵只能在"同一段音乐、只差一件乐器"
##   的条件下比较。九件乐器在游戏里逐一听全，需要分别等九次合适的战况 ——
##   一次性落九个 wav 才能真的做 A/B（同 `--musicdump` / `--musiccuedump` 的理由）。
## ★ 每件都印**渲染耗时**：持续激励族比拨弦族重得多（波表 + 气声 + 两级 EQ），
##   这个数就是"换乐器会不会卡"的唯一证据（音符是缓存的，卡只发生在第一次取流）。
func render_instrument_demo(dir_path: String, per_seconds: float = 2.6) -> Dictionary:
	var res := {}
	if dir_path != "":
		DirAccess.make_dir_recursive_absolute(dir_path)
	var keep := instrument_id
	print("[Music] 乐器验收件：%d 件 × %.2fs（同一段调度，只差乐器）" % [
		INSTR_IDS.size(), per_seconds])
	for id in INSTR_IDS:
		var sid := String(id)
		instrument_id = sid
		_wav_cache.clear()
		_cache_fp = ""
		var t0 := Time.get_ticks_msec()
		var pcm := render_offline(per_seconds, 0.0)
		var ms := Time.get_ticks_msec() - t0
		var rms := _rms(pcm, 0.0, 1.0)
		# 音准：三个孤立音各量一次基频，报**音分**偏差。
		# ★ 为什么必须量：三个 STK 移植族的延迟长度是我按"环路总长"反解的，写错一个分母
		#   就是整件乐器差一个八度 —— 而"差八度"在频谱上太协调，听感上很容易被当成"音色亮"。
		# ★ 只在孤立单音上量（混合件里旋律与和弦叠着，自相关会锁到别的音上）。
		var cents_txt := ""
		var worst_cents := 0.0
		for m in [45, 57, 69]:
			var f0 := midi_to_freq(int(m))
			var pc := instr_pcm(int(m), "note")
			# 一律用 Goertzel 窄带峰（见 `_fund_hz_goertzel()` 的两级纪律）。
			var hz := _fund_hz_goertzel(pc, f0 * 0.55, f0 * 1.8)
			var c := 0.0
			if hz > 0.0:
				c = 1200.0 * log(hz / f0) / log(2.0)
			if absf(c) > absf(worst_cents):
				worst_cents = c
			cents_txt += "%d:%+.0f " % [int(m), c]
		var path := ""
		var wrote := false
		if dir_path != "":
			path = dir_path.path_join("%s.wav" % sid)
			DirAccess.remove_absolute(path)     # 先删旧件，见 ⑭ 的同一条理由
			wrote = save_wav(path, pcm)
		print("        %-10s %-4s %6d ms · RMS %.4f · 音准 %s· %s" % [
			sid, instr_name(sid), ms, rms, cents_txt,
			path if path != "" else "(未落盘)"])
		res[sid] = {"ms": ms, "size": pcm.size(), "rms": rms,
			"cents": worst_cents, "path": path, "wrote": wrote}
	instrument_id = keep
	_wav_cache.clear()
	_cache_fp = ""
	return res


## 写 16-bit 单声道 wav（手写 RIFF 头：不依赖任何版本相关的保存 API）。
func save_wav(path: String, pcm: PackedFloat32Array) -> bool:
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		push_warning("[Music] 打不开 wav 输出路径：%s" % path)
		return false
	var sr := maxi(sample_rate, 8000)
	var data_bytes := pcm.size() * 2
	f.store_buffer("RIFF".to_ascii_buffer())
	f.store_32(36 + data_bytes)
	f.store_buffer("WAVEfmt ".to_ascii_buffer())
	f.store_32(16)
	f.store_16(1)                # PCM
	f.store_16(1)                # 单声道
	f.store_32(sr)
	f.store_32(sr * 2)           # 字节率
	f.store_16(2)                # 块对齐
	f.store_16(16)               # 位深
	f.store_buffer("data".to_ascii_buffer())
	f.store_32(data_bytes)
	for i in pcm.size():
		f.store_16(int(clampf(pcm[i], -1.0, 1.0) * 32767.0))
	f.close()
	return true


# ===== 公开 API（名字与语义都不许变：menu.gd 与 game.gd 都直连它们） =====
func play_bgm() -> void:
	_running = true
	_clock = 0.0
	## ★ 起播那一刻缓存是空的，而 `_process()` 的第一帧就要发第一个音 —— 预热没有任何
	##   "上一拍"可借。这里做一次**一次性**的同步预热（上界 `prewarm_sync_ms`），
	##   把最靠前的几个音先做好；之后的音全部由后台线程提前合成。
	## ★ 为什么允许这一次同步：它落在音乐还没建立的瞬间（听众只听到"音乐开始了"），
	##   而代价换来的是之后不再每两秒冻 4~6 帧。150ms 约够 2~3 个音。
	_pw_planned_at = -1
	_pw_warm_sync(prewarm_sync_ms)
	_pw_warm_cue_bells()
	if not _is_headless():
		print("[Music] 起节拍器：%d BPM · %d/%d 拍 · 步长 %.3fs" % [
			int(bpm), beats_per_bar, maxi(subdiv, 1), step_seconds()])


func stop_bgm() -> void:
	_running = false
	for p in _pool:
		p.stop()


func set_bgm_volume(v: float) -> void:
	bgm_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()


func toggle_mute() -> void:
	muted = not muted
	_apply_volumes()
	print("[Music] 静音：", muted, " | 音乐音量：", bgm_volume, " | 音效音量：", sfx_volume)


func set_muted(m: bool) -> void:
	muted = m
	_apply_volumes()


## 落子音效（由 game.gd 反射调用，见文件头契约）
func play_sfx_place() -> void:
	if _sfx_place == null or _sfx_player == null or muted or _is_headless():
		return
	_sfx_player.stream = _sfx_place
	_sfx_player.volume_db = linear_to_db(maxf(sfx_volume, 0.0001))
	_sfx_player.play()


func _apply_volumes() -> void:
	# 音乐音量不预乘到每个音符上（音符音量在 `_play_event` 里算），这里只管音效与静音态
	if _sfx_player != null:
		_sfx_player.volume_db = -80.0 if muted else linear_to_db(maxf(sfx_volume, 0.0001))


# ===== 自检 =====
## 命令行用户参数（与 `menu.gd::_argv()` 同口径）。
func _argv() -> PackedStringArray:
	var out := OS.get_cmdline_args()
	out.append_array(OS.get_cmdline_user_args())
	return out


func _arg_value(prefix: String) -> String:
	for a in _argv():
		if a.begins_with(prefix):
			return a.substr(prefix.length())
	return ""


## 契约检查用哪份源码（默认 `res://game.gd`；阴性对照可指向一份改坏了的副本
## —— 那是**唯一**能在不碰 game.gd 的前提下证明这条判据有牙齿的办法）。
func _contract_path() -> String:
	var p := _arg_value("--musiccontract=")
	return p if p != "" else DEFAULT_CONTRACT_PATH


## 静音能量比（判据 ⑤ 用）：相邻采样差分的能量 / 总能量 —— 粗糙但够用的"亮度"代理量。
func _hf_ratio(pcm: PackedFloat32Array) -> float:
	var de := 0.0
	var te := 0.0
	for i in pcm.size():
		te += pcm[i] * pcm[i]
		if i > 0:
			var d := pcm[i] - pcm[i - 1]
			de += d * d
	return de / maxf(te, 1e-9)


func _rms(pcm: PackedFloat32Array, from_frac: float, to_frac: float) -> float:
	var a := int(clampf(from_frac, 0.0, 1.0) * pcm.size())
	var b := int(clampf(to_frac, 0.0, 1.0) * pcm.size())
	if b <= a:
		return 0.0
	var s := 0.0
	for i in range(a, b):
		s += pcm[i] * pcm[i]
	return sqrt(s / float(b - a))


## 归一化自相关估基频（判据 ③ 用）。返回 {"hz": 估频, "peak": 相关峰高, "lag": 滞后}。
##
## ★★ 为什么不用"数零交叉"：**那不是基频估计器**。同一批激励下零交叉给出
##    43.5~877.7Hz 的乱跳（30 个样本里只有 7 个落 ±2%）—— 引擎首跑读到 321.5Hz
##    只是这个宽分布里的一次抽样，不是"某个系统性偏差"。换成自相关后 30/30 落 ±2%
##    且范围只有一个值（零方差）。**一条会随机红/绿的判据等于没牙齿。**
## ★ 整数滞后、**不做**抛物线插值：延迟线长度本来就是整数采样（nn = round(sr/freq)），
##    插值反而把真周期 50 拉到 49.5（+1% 偏差）。实测整数滞后恰好落在 nn 上。
## ★ `peak` 是**可信度闸门**，不是装饰：argmax 对白噪声也会硬报一个"音高"（峰高 0.032），
##    判据必须同时断言峰高，否则就成了恒真式（铁律：判据里要有"样本非平凡"）。
func _pitch_hz(pcm: PackedFloat32Array, lo_hz: float, hi_hz: float) -> Dictionary:
	var sr := maxi(sample_rate, 8000)
	var a := int(float(pcm.size()) * 0.06)          # 跳过音头（激励最脏的一段）
	var lag_min := maxi(int(float(sr) / maxf(hi_hz, 20.0)), 2)
	var lag_max := int(float(sr) / maxf(lo_hz, 20.0))
	var win := mini(3072, pcm.size() - a - lag_max - 1)
	if win < 64:
		return {"hz": 0.0, "peak": 0.0, "lag": 0}
	var best_r := -2.0
	var best_lag := lag_min
	for lag in range(lag_min, lag_max + 1):
		var num := 0.0
		var e1 := 0.0
		var e2 := 0.0
		for i in range(a, a + win):
			var v1 := pcm[i]
			var v2 := pcm[i + lag]
			num += v1 * v2
			e1 += v1 * v1
			e2 += v2 * v2
		var r := num / sqrt(maxf(e1 * e2, 1e-18))
		if r > best_r:
			best_r = r
			best_lag = lag
	return {"hz": float(sr) / float(best_lag), "peak": best_r, "lag": best_lag}


## |直流| / RMS（判据 ⑮ 用）：段内均值绝对值 ÷ 段内 RMS。
func _dc_ratio(pcm: PackedFloat32Array, from_frac: float, to_frac: float) -> float:
	var a := int(clampf(from_frac, 0.0, 1.0) * pcm.size())
	var b := int(clampf(to_frac, 0.0, 1.0) * pcm.size())
	if b <= a:
		return 0.0
	var m := 0.0
	var s := 0.0
	for i in range(a, b):
		m += pcm[i]
		s += pcm[i] * pcm[i]
	m /= float(b - a)
	return absf(m) / maxf(sqrt(s / float(b - a)), 1e-12)


## 各谐波的 T−20dB（秒）—— 判据 ㊴ 的观测器，量的是「谐波各自死得多快」。
## 返回长度 `hmax` 的数组，`-1` = 观测窗内没降到 −20dB（或该谐波没能量）。
##
## ★ 为什么不用 STFT：自检里要跑九件 × 多次，一秒级开销不能接受。
##   这里用**复解调 + 一极点低通**：把 x[n] 乘上 k·f0 的复本振，低通后就得到该谐波
##   的复包络，模即幅度。本振走同一张波表（cos 用 sin 错开 1/4 周），一次乘法都不浪费。
## ★ 低通必须 ≪ f0（取 f0/12）**且必须是二阶**：一阶只有 6dB/倍频程，而相邻谐波
##   隔了整整 f0 —— 一阶在 440Hz 偏移处只衰减 ~16dB，于是强基频会**漏进二次谐波的
##   解调器**里，把"后死的谐波"抬起来、把衰减曲线整形成单峰（实测就是这样把 guzheng
##   判成"严格单调"的：h1/h2 读成 0.32/0.33，而离线 FFT 口径是 0.71/0.91）。
##   二阶 + f0/12 ⇒ 440Hz 偏移处衰减 ~43dB，漏进来的量比 −20dB 判点低两个数量级。
## ★ `secs_limit` 之后的样本不参与：衰减族在 1.5s 内已经分出胜负，再长只是白烧时间。
func _harm_t20(pcm: PackedFloat32Array, f0: float, hmax: int = 5,
		secs_limit: float = 1.5) -> Array:
	var sr := maxi(sample_rate, 8000)
	var W := maxi(hmax, 1)
	var n := mini(pcm.size(), int(secs_limit * float(sr)))
	var t0 := int(float(pcm.size()) * 0.02)
	if n - t0 < 256:
		var empty: Array = []
		for h in W:
			empty.append(-1.0)
		return empty
	var lut := _sine_lut_get()
	var tabs := float(SINE_TAB)
	var q := tabs * 0.25
	var re := PackedFloat32Array()
	var im := PackedFloat32Array()
	var re2 := PackedFloat32Array()
	var im2 := PackedFloat32Array()
	var ph := PackedFloat32Array()
	var dp := PackedFloat32Array()
	var pk := PackedFloat32Array()
	var hit := PackedFloat32Array()
	re.resize(W)
	im.resize(W)
	re2.resize(W)
	im2.resize(W)
	ph.resize(W)
	dp.resize(W)
	pk.resize(W)
	hit.resize(W)
	for h in W:
		re[h] = 0.0
		im[h] = 0.0
		re2[h] = 0.0
		im2[h] = 0.0
		ph[h] = 0.0
		dp[h] = float(h + 1) * f0 / float(sr) * tabs
		pk[h] = 0.0
		hit[h] = -1.0
	var a_lp := 1.0 - exp(-TAU * maxf(f0 / 12.0, 10.0) / float(sr))
	for i in range(t0, n):
		var x := pcm[i]
		for h in W:
			var p := ph[h]
			var cc := lut[int(p)]
			var p4 := p + q
			if p4 >= tabs:
				p4 -= tabs
			var ss := lut[int(p4)]
			## 二阶：两级一极点串联（每级 −6dB/oct ⇒ 合计 −12dB/oct）
			var r1 := re[h] + a_lp * (x * cc - re[h])
			var i1 := im[h] + a_lp * (x * ss - im[h])
			re[h] = r1
			im[h] = i1
			var r := re2[h] + a_lp * (r1 - re2[h])
			var m := im2[h] + a_lp * (i1 - im2[h])
			re2[h] = r
			im2[h] = m
			var e := r * r + m * m
			if e > pk[h]:
				pk[h] = e
			elif hit[h] < 0.0 and pk[h] > 1.0e-12 and e < pk[h] * 0.01:
				hit[h] = float(i - t0) / float(sr)
			p += dp[h]
			if p >= tabs:
				p -= tabs
			ph[h] = p
	var out: Array = []
	for h in W:
		out.append(hit[h])
	return out
# ⚰️ 2026-11-02 墓碑（名字不许回收）：`_hf2_ratio()` 已删除（全工程零读者，`_audit_gd` ②）。
## 包络粗糙度：20ms 分帧 RMS 去掉 9 帧滑动平均后，残余的相对标准差。
## ★ 这是「活气」（`sine_life`）的**直接**观测量：LFO + 逐谐波 T60 散度都会让包络
##   出现慢速起伏，两者一关它就该掉下来。用它做阴性对照，比"看起来不一样"有牙齿。
##   ⚠ 但它**不能**用来量噪声底（理由见上面 `_hf_ratio` 的注释）。
##
## ★★ 必须**掐掉头尾**（`from_frac` / `to_frac`）：
##   · 头部是起音斜坡（hold 族 50~95ms 的线性上冲），尾部是**释放斜坡**（`release`
##     最长 0.30s，占 1.2s 缓冲的 25%）—— 这两段都是**设计出来的**形状，不是起伏。
##   不掐掉的实测后果：笙读 0.2532，而关掉 `sine_life` 后只降到 0.2374（−6%），
##   因为那 0.25 里绝大部分是斜坡，不是 LFO。（§110 参照物不许与被测物共用退化出口）
func _env_rough(pcm: PackedFloat32Array, from_frac: float = 0.20,
		to_frac: float = 0.72) -> float:
	var sr := maxi(sample_rate, 8000)
	var fl := maxi(int(0.020 * float(sr)), 1)
	var a := int(clampf(from_frac, 0.0, 1.0) * float(pcm.size())) / fl
	var b := int(clampf(to_frac, 0.0, 1.0) * float(pcm.size())) / fl
	var cnt := b - a
	if cnt < 24:
		return 0.0
	var e := PackedFloat32Array()
	e.resize(cnt)
	for f in cnt:
		var s := 0.0
		var o := (a + f) * fl
		for i in fl:
			var v := pcm[o + i]
			s += v * v
		e[f] = sqrt(s / float(fl))
	var k := 9
	var acc := 0.0
	for i in range(cnt - k):
		var m := 0.0
		for j in k:
			m += e[i + j]
		m /= float(k)
		if m > 1.0e-9:
			acc += pow(e[i + k - 1] / m - 1.0, 2)
	var cnt2 := cnt - k
	return sqrt(acc / float(maxi(cnt2, 1)))


## 段内 RMS，**先扣掉本段均值**（量"音"的包络，不让直流台阶混进来）。
func _rms_ac(pcm: PackedFloat32Array, from_frac: float, to_frac: float) -> float:
	var a := int(clampf(from_frac, 0.0, 1.0) * pcm.size())
	var b := int(clampf(to_frac, 0.0, 1.0) * pcm.size())
	if b <= a:
		return 0.0
	var m := 0.0
	for i in range(a, b):
		m += pcm[i]
	m /= float(b - a)
	var s := 0.0
	for i in range(a, b):
		var d := pcm[i] - m
		s += d * d
	return sqrt(s / float(b - a))


## 噪声底的**真实量级**：把加性噪声从信号里减出来，不用任何频谱掩码。
## 返回 10·log10(N/S)，N = 噪声能量、S = 无噪信号能量。
##
## ★★ 为什么频谱法在这件事上全都不通（三条路都是我自己走过的，全部实测排除）：
##   ① **固定 ±Hz 掩码**：`vib_cents` 是**等比例**的，42 音分在 3520Hz 上就是 ±86Hz
##      ⇒ 高阶谐波被揉弦扫出掩码、被记成噪声。实测把 dizi 的底占比记成 46%，
##      而把掩码放宽到 ±25Hz 后同一文件读 10.7dB —— 那 46% 全是假的。
##   ② **按比例掩码（±4.5%）**：440Hz 上能用，但（a）相邻谐波带宽开始重叠，
##      （b）`inharm` 让高次谐波天生偏出 2.9% ⇒ 又是假阳性。
##   ③ **按周期自相关**（对严格谐波信号理论上恒等于 1、混噪后正好是 S/(S+N)）：
##      理论上最优，实际**九件全读 13~14dB、对噪声零响应** —— `inharm` 打碎了周期性。
##      这是最坏的观测器：有读数、无分辨力。
##
## ★ 成立的依据：噪声是**加性、线性**的（`out[i] += (nz − nl) * na * envl`），
##   其后只有 `_apply_body()`（线性 EQ）和 `_norm_peak()`（标量）。所以
##   `x(air=1) − x(air=0)` 就是噪声本身。一次减法，精确，**与被测物的谐波结构无关**
##   ⇒ 换乐器、换音高、改 `tilt`/`H`/`inharm` 都不会让它误报（这类判据最容易被后续改动误杀）。
## ★ 唯一近似：`_norm_peak()` 的峰值可能被噪声抬高一点点 ⇒ 差分里混进一个共模缩放。
##   噪声在 −35dB 量级，这个误差在 0.01% 以下，不影响 dB 读数。
func _noise_rel_db(with_air: PackedFloat32Array, no_air: PackedFloat32Array) -> float:
	var n := mini(with_air.size(), no_air.size())
	if n <= 0:
		return -999.0
	var s := 0.0
	var d := 0.0
	for i in n:
		s += no_air[i] * no_air[i]
		var e := with_air[i] - no_air[i]
		d += e * e
	if s <= 1.0e-20:
		return -999.0
	return 4.3429448190325175 * log(maxf(d / s, 1.0e-30))


## 文件字节数（判据 ⑭ 用；读不到返回 -1）。
func _file_size(path: String) -> int:
	if not FileAccess.file_exists(path):
		return -1
	var fh := FileAccess.open(path, FileAccess.READ)
	if fh == null:
		return -1
	var n := int(fh.get_length())
	fh.close()
	return n


## 自检：`--musictest`（由 menu.gd 触发并统一打印，体在这里 —— 引擎的细节只有这里知道）。
## ★ 判据一律**纯数值**：headless 听不到声音，所以"能不能听"必须换成可断言的不变量。
func run_selftest() -> Array:
	var checks: Array = []
	var sr_keep := sample_rate

	# ① 音阶契约：`pent_at()` 生成的音必须落在**当前曲风的字面音阶**里。
	# ★★ 2026-10-16 曲风化之后这条判据的形式变了，但**纪律一字不变**（铁律 13）：
	#    判据**自带**一份「id → 字面音阶」表，与 `style_table()` 里的实际值**逐项对拍**。
	#    为什么不直接读 `style_table()`：那就成了"读这张表证明这张表"的恒真式
	#    （把 scale 改成 [0,3,5] 也照样绿）。自带一份 ⇒ 改一处不改另一处当场红。
	# ★ 顺带把"每套曲风的结构体检"也做成会红的：升序 / 落在 0..11 / 首元素为 0 / 至少 5 个音
	#   —— 这几条是 `pent_at()` 的**前提**（它按 scale.size() 取模、按 12 折八度）。
	var scale_lit := {"guzheng": [0, 2, 4, 7, 9]}
	var lit_miss: Array[String] = []
	var lit_bad: Array[String] = []
	for sid in STYLE_IDS:
		var sid_s := String(sid)
		if not scale_lit.has(sid_s):
			lit_miss.append(sid_s)
			continue
		var sc: Array = style_table()[sid_s]["scale"]
		var struct_ok: bool = sc.size() >= 5 and int(sc[0]) == 0
		for i in sc.size():
			if int(sc[i]) < 0 or int(sc[i]) > 11:
				struct_ok = false
			if i > 0 and int(sc[i]) <= int(sc[i - 1]):
				struct_ok = false
		if not struct_ok or str(sc) != str(scale_lit[sid_s]):
			lit_bad.append("%s：表%s 字面%s" % [sid_s, str(sc), str(scale_lit[sid_s])])
	var want_set := {}
	var act_scale: Array = scale_lit.get(style_id, scale_lit[String(STYLE_IDS[0])])
	for v in act_scale:
		want_set[int(v)] = true
	var bad_deg: Array[String] = []
	for n in range(0, 12):
		if not want_set.has(((int(pent_at(n)) % 12) + 12) % 12):
			bad_deg.append("%d→%d" % [n, int(pent_at(n))])
	var asc := true
	for n in range(1, 12):
		if pent_at(n) <= pent_at(n - 1):
			asc = false
	checks.append(["① 音阶契约｜每套曲风的音阶与**判据自带的字面值**逐项相等｜不是拿表证明表"
			+ " · 结构升序且落在 0..11 · pent_at 全落在当前曲风的音阶内",
		STYLE_IDS.size() >= 1 and lit_miss.is_empty() and lit_bad.is_empty()
			and bad_deg.is_empty() and asc,
		"曲风 %d 套 · 缺字面值 %s · 不符 %s · 阶外音 %s · 升序=%s · 当前音阶 %s" % [
			STYLE_IDS.size(), str(lit_miss), str(lit_bad), str(bad_deg), str(asc),
			str(act_scale)]])
	var offs: Array[int] = []
	for n in range(0, 12):
		offs.append(int(pent_at(n)) % 12)

	# ② 节拍计数：解析式对账（72 BPM / 4 拍 / subdiv 2 ⇒ 步长 0.41666…s）
	# ★ 量的是 `_step_idx` 的增量 —— 它就是"时钟跨过了几步"这个量本身（`_on_step()` 里自增），
	#   而不是"某个派生结果"。★ 不用 lambda 计数：**GDScript 的 lambda 按值捕获局部变量**，
	#   里面 `cnt += 1` 改的是捕获副本、外面看不见 ⇒ 那样写会得到一个恒 0 的假判据。
	var bpm_keep := bpm
	var spb_keep := beats_per_bar
	var sd_keep := subdiv
	bpm = 72.0
	beats_per_bar = 4
	subdiv = 2
	var probe_secs := 20.0
	# ★★ 期望值必须**由本判据自己设定的参数独立算出**，**绝不能**写成
	#    `int(probe_secs / step_seconds())`：`_advance()` 内部用的**也是** `step_seconds()`，
	#    两边同错 ⇒ 判据恒真（这正是"判据自己注入被测量"的接线盲区）。
	#    实测：把公式里的 `subdiv` 删掉、步长翻倍之后，原来那种写法**照样绿**
	#    （0 条红线）—— 是阴性对照 K8 当场没咬住才发现的。
	var want_sd := 60.0 / 72.0 / 2.0                      # 72BPM / subdiv 2 ⇒ 0.41666…s
	var want_steps := int(probe_secs / want_sd)
	_step_idx = 0
	_clock = 0.0
	var t := 0.0
	while t < probe_secs:
		_advance(0.05)
		t += 0.05
	var got_steps := _step_idx
	checks.append(["② 节拍计数｜20s 步数 = 由参数独立算出的解析式 · 并直接校步长",
		absi(got_steps - want_steps) <= 2 and absf(step_seconds() - want_sd) <= 1e-6,
		"20s 实测 %d 步 · 独立期望 %d 步 · 步长实测 %.4fs 期望 %.4fs" % [
			got_steps, want_steps, step_seconds(), want_sd]])
	bpm = bpm_keep
	beats_per_bar = spb_keep
	subdiv = sd_keep

	# ③ 合成器基频（**自相关**，不是零交叉）：A4 必须被认对，**且**仪器必须拒绝噪声。
	# ★★ 这条判据是**两面**的，缺一面就是恒真式：
	#    只断言"A4 被认出 440Hz" —— 一个永远返回 440 的假仪器也能过；
	#    只断言"噪声被拒" —— 一个永远返回 0 的仪器也能过。
	#    首版用零交叉，在同一批激励下跨 43.5~877.7Hz（30 个里只有 7 个落 ±2%）
	#    ⇒ 那次读到的 321.5Hz 只是分布里的一次抽样，判据本身没有牙齿。
	var pcm_a4 := pluck_pcm(440.0, 0.8, brightness)
	var pit := _pitch_hz(pcm_a4, 300.0, 600.0)
	var f_est := float(pit["hz"])
	var conf := float(pit["peak"])
	var rms_all := _rms(pcm_a4, 0.0, 1.0)
	var nz := PackedFloat32Array()
	var rng_n := RandomNumberGenerator.new()
	rng_n.seed = 20261005
	for i in int(0.8 * float(maxi(sample_rate, 8000))):
		nz.append(rng_n.randf_range(-1.0, 1.0) * 0.5)
	var conf_n := float(_pitch_hz(nz, 300.0, 600.0)["peak"])
	# ★ 容差为什么是 3.5% 而不是 3%：合成器**实际**基频 = sr/(nn+0.5) = 436.6Hz
	#   （比请求的 440 低 0.77%，因为延迟线的两点平均器还贡献半采样延迟），
	#   而自相关用**整数**滞后 ⇒ 在 nn=50 附近有 ±1 采样的歧义（±2.27%）。
	#   两者相加 ⇒ 上界约 +3.1%。3% 只剩 0.7% 余量 = 靠运气绿；实测 24 个种子恒为
	#   450.0Hz（零方差、+2.27%）。仍能抓住任何 ≥1 个半音（5.9%）的错 ——
	#   阳性对照实测：延迟线 50→45 读 501Hz（+13.9%）、50→55 读 401Hz（-8.9%）。
	checks.append(["③ 合成器基频｜A4 估频 440Hz±3.5% · 含半采样延迟与整数滞后歧义"
			+ " 且可信度≥0.5；白噪声必须被拒 · 峰<0.3",
		absf(f_est - 440.0) / 440.0 <= 0.035 and conf >= 0.5
			and conf_n < 0.3 and rms_all > 0.02,
		"估频 %.1f Hz（偏差 %.1f%%）· 峰高 %.3f · 噪声峰高 %.3f · 整体 RMS %.3f" % [
			f_est, 100.0 * absf(f_est - 440.0) / 440.0, conf, conf_n, rms_all]])

	# ④ 余音包络：四段 RMS 必须**严格递减**（不是"首段>末段"就完事），末段仍非零（不是断崖）。
	# ★ 为什么升级：修好之前尾段是一根**缓慢衰减的直流台阶**，四段里后三段几乎等高
	#   ⇒ "首段>末段"照样绿，这条判据当时是**假绿**的（它没测直流那条路）。
	var pcm_long := pluck_pcm(440.0, 1.2, brightness)
	var seg_v: Array[float] = []
	for k in 4:
		seg_v.append(_rms(pcm_long, float(k) * 0.25, float(k + 1) * 0.25))
	var seg_txt := ""
	for v in seg_v:
		seg_txt += ("%.4f " % v)
	var mono_decay: bool = seg_v[0] > seg_v[1] and seg_v[1] > seg_v[2] and seg_v[2] > seg_v[3]
	# ★ 末段的地板不能"随手拍一个数"：第一版拍成 0.0002，而实测末段是 0.0001 ⇒
	#   四段明明严格递减却被判红（"判据输出与数据自相矛盾"）。改成**有物理含义**的那条：
	#   音尾不许切出爆音 ⇒ |最后一个采样| 必须很小（峰值已归一化到 1.0）。
	var last_abs := absf(pcm_long[pcm_long.size() - 1])
	# ★ 这里只能用 `%.8f`，**不能用 `%.2e`**：GDScript 的 `%` 不支持 `%e`，
	#   后果是 `ERROR: String formatting error` + **结论行原样打出格式串**
	#   （实测打出 `四段 RMS %s·末采样 %.2e`）—— 判决还是绿的，日志却已经是垃圾。
	#   同类坑本工程早记过一次（见 game.gd:5105 关于 `%g` 的注释）。
	checks.append(["④ 余音包络｜四段 RMS 严格递减 · 末段>0 · 末尾不切爆音 · |末采样|≤2%峰值",
		mono_decay and seg_v[3] > 0.0 and last_abs <= 0.02,
		"四段 RMS %s·末采样 %.8f" % [seg_txt, last_abs]])

	# ⑤ 亮度接线：bright 参数必须真的改变高频含量（否则"调了没用"是静默的）
	var hf_hi := _hf_ratio(pluck_pcm(440.0, 0.6, 1.0))
	var hf_lo := _hf_ratio(pluck_pcm(440.0, 0.6, 0.15))
	checks.append(["⑤ 亮度接线｜bright 越大高频能量占比越大",
		hf_hi > hf_lo * 1.15,
		"亮档 %.4f · 暗档 %.4f（比值 %.2f）" % [hf_hi, hf_lo, hf_hi / maxf(hf_lo, 1e-9)]])

	# ⑥ 张力映射（"和弦随战况"的输入端）：单调性 + 收束
	var mk := func(bp: int, wp: int, bs: int, tt: int, ps: int, go: bool) -> Dictionary:
		return {"black_prisoners": bp, "white_prisoners": wp, "board_size": bs,
			"tiles_total": tt, "passes": ps, "game_over": go}
	var t_flat: float = battle_tension(mk.call(0, 0, 40, 160, 0, false))
	var t_small: float = battle_tension(mk.call(2, 1, 40, 160, 0, false))
	var t_big: float = battle_tension(mk.call(9, 1, 40, 160, 0, false))
	var t_full: float = battle_tension(mk.call(9, 1, 150, 160, 0, false))
	var t_over: float = battle_tension(mk.call(9, 1, 150, 160, 2, true))
	var mono: bool = t_flat <= t_small and t_small <= t_big and t_big <= t_full
	checks.append(["⑥ 张力映射｜提子差/密度↑ ⇒ 张力↑ · 停手终局 ⇒ 收束",
		mono and t_over < t_full * 0.5,
		"均势 %.3f → 差2子 %.3f → 差8子 %.3f → 满盘 %.3f → 终局 %.3f" % [
			t_flat, t_small, t_big, t_full, t_over]])

	# ⑦ 战况字段契约（静态读源码）：改名 ⇒ 音乐会静默失声 ⇒ 必须当场红
	# ★ 两张表都要查：`BATTLE_FIELDS`（基础）+ `SITUATION_FIELDS`（局势层，四轴里三轴的唯一输入）。
	#   只查基础表的话，"game.gd 把 an_crisis 改名了"会让音乐静默退回单标量档而判据全绿。
	var cpath := _contract_path()
	var src := ""
	if FileAccess.file_exists(cpath):
		src = FileAccess.get_file_as_string(cpath)
	var miss: Array[String] = []
	# ★ 棋钟快照（`clk`）是**可选**字段（不进 `BATTLE_FIELDS`：它缺席不是错，只是音乐
	#   不知道棋钟），但它的**名字**仍是一条契约 —— 改名 ⇒ 音乐静默退回固定 BPM
	#   （不报错、听感只是"节拍不跟手了"）。所以在这里一起查。
	var need: Array = []
	need.append_array(BATTLE_FIELDS)
	need.append_array(SITUATION_FIELDS)
	need.append("clk")
	for fld in need:
		if not src.contains("var %s" % str(fld)):
			miss.append(str(fld))
	checks.append(["⑦ 战况字段契约｜对局侧仍声明全部约定字段｜含局势层 %d 个 + 棋钟快照｜· 改名=静默失声"
			% SITUATION_FIELDS.size(),
		miss.is_empty() and src.length() > 1000,
		"%s 缺 %s（源码 %d 字符）" % [cpath, str(miss), src.length()]])

	# ⑧ 无对局时优雅降级（菜单/复盘/自检都走这一档）
	var st_now := _read_battle_state()
	var ax_now := current_axes()
	var ax_ok := true
	for kk in ["loud", "tempo", "hue"]:
		if float(ax_now.get(kk, -1.0)) < 0.0 or float(ax_now.get(kk, 2.0)) > 1.0:
			ax_ok = false
	checks.append(["⑧ 无对局降级｜读不到战况 ⇒ 四轴全为 0｜最平静｜且不报错",
		st_now.is_empty() and ax_ok and absf(float(ax_now["loud"])) <= 1e-9
			and absf(float(ax_now["hue"])) <= 1e-9 and int(ax_now["pitch_deg"]) == 0,
		"当前战况 %s · 四轴 %s" % [str(st_now), str(ax_now)]])

	# ⑨ 和弦必在音阶内（除最高张力档故意加的偏音）
	var bad_chord: Array[String] = []
	for band in [0.0, 0.45, 0.9]:
		for bar in range(0, 4):
			var hh: Dictionary = _harmony_for_bar(bar, float(band))
			var ch: Array = hh["chord"]
			var allow_extra: int = 1 if bool(hh["high"]) else 0
			var extra := 0
			for v in ch:
				# ★★ 必须**相对主音**判归属：音阶是"相对关系"，绝对音级一加进来就整体错位
				#    （主音 50 ⇒ 50%12=2，于是合法的 4 度（pc=11）会被读成"阶外音"）。
				#    这一条首版就是这么写错的 —— 铁律 17：**判据与自己喂的数据打架时，
				#    先怀疑判据**（4 个由 `pent_at()` 生成的音不可能真的越界）。
				var pc: int = (((int(v) - root_midi) % 12) + 12) % 12
				if not want_set.has(pc):
					extra += 1
			if extra > allow_extra:
				bad_chord.append("张力%.2f/小节%d 有 %d 个阶外音" % [band, bar, extra])
	checks.append(["⑨ 和弦取材｜偏音只许出现在最高张力档",
		bad_chord.is_empty(), str(bad_chord.slice(0, 3))])

	# ⑩ 调度可复现（判据能成立的前提）：同 (k, 四轴) 两次结果逐字相同
	# ★ 取 **k=8（小节头）**：那一拍必发和弦（3~4 个音）⇒ 样本非平凡；
	#   若取一个可能"休止"的步号，"两次都空"也能通过 —— 那是恒真式。
	var ax_rep := axes_from_tension(0.7)
	var s1 := _schedule_step(8, ax_rep)
	var s2 := _schedule_step(8, ax_rep)
	checks.append(["⑩ 调度可复现｜同一步同四轴两次调度逐字相同 · 且样本非平凡",
		str(s1) == str(s2) and s1.size() >= 3,
		"小节头（k=8）事件数 %d · 一致=%s" % [s1.size(), str(str(s1) == str(s2))]])

	# ⑪ 音色缓存：第二次取同一音必须命中缓存（缓存键唯一性）
	_wav_cache.clear()
	_cache_fp = ""
	var w1 := wav_for(60, "note")
	var n_after_first := _wav_cache.size()
	var w2 := wav_for(60, "note")
	checks.append(["⑪ 音色缓存｜同一音第二次取命中缓存且拿到同一个流",
		n_after_first == 1 and _wav_cache.size() == 1 and w1 == w2,
		"首次后缓存 %d 项 · 二次后 %d 项 · 同对象=%s" % [
			n_after_first, _wav_cache.size(), str(w1 == w2)]])

	# ⑫ 公开 API 契约（menu.gd / game.gd 直连它们）：play/stop 幂等、音效方法还在
	var ok_api := true
	var seq: Array[String] = []
	play_bgm()
	if not _running:
		ok_api = false
		seq.append("play 未起")
	play_bgm()
	if not _running:
		ok_api = false
		seq.append("重复 play 坏")
	stop_bgm()
	if _running:
		ok_api = false
		seq.append("stop 未停")
	stop_bgm()
	if _running:
		ok_api = false
		seq.append("重复 stop 坏")
	var has_sfx: bool = has_method("play_sfx_place") and has_method("set_muted") \
		and has_method("set_bgm_volume") and has_method("set_sfx_volume") \
		and has_method("toggle_mute") and has_method("play_bgm") and has_method("stop_bgm")
	play_sfx_place()          # headless 下应当是空操作、且绝不报错
	checks.append(["⑫ 公开 API 契约｜play/stop 幂等 + 音效方法齐备 · game.gd 靠 has_method 反射",
		ok_api and has_sfx, "异常 %s · has_method 齐备=%s" % [str(seq), str(has_sfx)]])

	# ⑬ 离线渲染（人耳验收件）：真有声音、且长度对
	## ★ 2026-11-05 第十轮（立项准备）：默认 6.0s 是**全部历史 md5 锚与 47 条判据**的口径，
	##   一个字都不许动。`--dumpsecs=` 只供宏观曲式那种「6 秒装不下」的长 A/B 用：
	##   6 秒 ≈ 14 步 / 2 小节，慢起→提速→急煞→散尾根本塞不进去。
	##   ★ 走 `render_offline()` 同一份调度与同一份合成 ⇒ 长件与 6 秒件同源，不是另写一条路。
	var dump_secs := 6.0
	var ds_arg := _arg_value("--dumpsecs=")
	if ds_arg != "":
		dump_secs = clampf(ds_arg.to_float(), 1.0, 300.0)
	var mix := render_offline(dump_secs, 0.9)
	var rms_mix := _rms(mix, 0.0, 1.0)
	var want_n := int(dump_secs * float(sample_rate))
	checks.append(["⑬ 离线渲染｜长度对得上且非静音 · 验收 wav 由它产出",
		mix.size() == want_n and rms_mix > 0.001,
		"%d 采样（期望 %d）· RMS %.4f" % [mix.size(), want_n, rms_mix]])

	# ⑭ 验收 wav 落盘（**只在显式请求时**才是一条判据）：`--musicdump=<绝对路径>`
	# ★ 为什么"写了没写成"必须是一条红：这条 wav 是我做**人耳验收**与工作区 Python
	#   独立频谱验证的唯一证据源 —— 它悄悄写失败，会让"没验"看起来像"验过了"。
	var dump_path := _arg_value("--musicdump=")
	if dump_path != "":
		# ★ 同时落一个**单音件**：混合渲染件（和弦+旋律叠在一起）没法用来独立验音高 ——
		#   工作区那边的 Python 需要一段**孤立**的 A4 才能"换个仪器把 ③ 再量一遍"。
		var note_path := dump_path.get_basename() + "_note.wav"
		# ★★ 先**删掉同名旧文件**再写。为什么这是判据的一部分而不是洁癖：
		#   若留着上一轮的产物，"这一轮的 save_wav 写失败了"就**看不出来** ——
		#   `_file_size` 会读到上一轮的旧文件、大小也合适 ⇒ 判据照样绿。
		#   而这条判据存在的全部意义就是"写了没写成必须红"
		#   （这份 wav 是人耳验收与工作区独立频谱验证的唯一证据源）。
		DirAccess.remove_absolute(dump_path)
		DirAccess.remove_absolute(note_path)
		var wrote := save_wav(dump_path, mix)
		var wrote_note := save_wav(note_path, pcm_a4)
		# ★ 可选：再落一个**高音单音件**（`--musicnote=<Hz>`，**不改 ③ 钉住的 440**）。
		#   为什么要单独一档：随机激励造成的"谐波随机零点"**随音高上升而变严重**
		#   （延迟线越短、抽签越稀疏）—— "判据要落在缺陷显形的那一档"同 ⑮。
		var note_hz := 0.0
		var ns_arg := _arg_value("--musicnote=")
		if ns_arg != "":
			note_hz = maxf(ns_arg.to_float(), 20.0)
		if note_hz > 0.0:
			var hi_path := dump_path.get_basename() + "_hi.wav"
			DirAccess.remove_absolute(hi_path)
			save_wav(hi_path, pluck_pcm(note_hz, 0.8, brightness))
			print("[Music] 高音单音件：%s（%.1f Hz）" % [hi_path, note_hz])
		var sz_mix := _file_size(dump_path)
		var sz_note := _file_size(note_path)
		# ★ 边界必须是 `>=` 而不是 `>`：WAV 头**恰好** 44 字节 ⇒ 文件大小正是
		#   `44 + 采样数*2`。写成开区间会让"引擎写了数学上精确的文件"被判红
		#   （实测 264644 = 44 + 132300*2、35324 = 44 + 17640*2，两处都正好相等）。
		checks.append(["⑭ 验收 wav 落盘｜混合件与单音件都写成且非空 · 人耳+频谱验证的证据源",
			wrote and wrote_note and sz_mix >= 44 + want_n
				and sz_note >= 44 + pcm_a4.size() * 2,
			"%s · %d 字节（期望 ≥ %d）｜%s · %d 字节（期望 ≥ %d）" % [
				dump_path, sz_mix, 44 + want_n,
				note_path, sz_note, 44 + pcm_a4.size() * 2]])
	else:
		print("[Music] 未请求 --musicdump=<路径>（跳过验收 wav 落盘）")

	# ㉟ 特殊时刻**验收件**落盘（只在显式请求时才是判据）：`--musiccuedump=<绝对路径>`。
	# ★ 为什么它必须是一条**会红的**判据（与 ⑭ 同一条理由）：这份 wav 是"吃子/做活/终局
	#   到底响什么"唯一的可听证据源。它悄悄写失败 ⇒「没验」看起来和「验过了」一模一样。
	# ★ 先删同名旧文件再写：留着上一轮的产物，这一轮的 `save_wav` 失败就看不出来
	#   （`_file_size` 会读到旧文件、大小也合适 ⇒ 照样绿）。
	var cue_dump := _arg_value("--musiccuedump=")
	if cue_dump != "":
		DirAccess.remove_absolute(cue_dump)
		var demo := render_cue_demo()
		var wrote_cue := save_wav(cue_dump, demo)
		var sz_cue := _file_size(cue_dump)
		checks.append(["㉟ 特殊时刻验收件｜%d 个乐句各一段接成一个 wav · 六段都能单独定位"
				% CUE_IDS.size(),
			wrote_cue and demo.size() > 0 and sz_cue >= 44 + demo.size() * 2,
			"%s · %d 字节（期望 ≥ %d）· %d 段" % [
				cue_dump, sz_cue, 44 + demo.size() * 2, CUE_IDS.size()]])
	else:
		print("[Music] 未请求 --musiccuedump=<路径>（跳过特殊时刻验收件）")

	# ㊹ 编钟音阶验收件 + **钟谱结构**（`--bellscale=<路径>` 落盘；结构那几面无条件跑）。
	# ★★★ 为什么钟单独要一条判据：2026-11-03 用户听完说"这个钟怎么听着不对味"。
	#   查下来是旧谱拿的是**圆钟/管钟**的模态（八度分音 2.02× 给了 0.55），而中国编钟是
	#   合瓦形（两片瓦对合、椭圆截面）—— 八度模式被压制、第一强分音在 2.9×、而且
	#   **一钟双音**（侧鼓音差小三度）是它的定义性特征。这三件事在频谱上都能一眼看出，
	#   但**耳朵先说不对**才发现 ⇒ 现在把耳朵的判断固化成数：
	#     ① 侧鼓音（1.189×）必须在，且幅度**高于**八度分音（2.02×）；
	#     ② 金属拍频必须真的在响：基音主导的窗口里，log 包络对线性趋势的残差 ≥ 0.5dB
	#        （纯指数衰减 = 完美直线 ⇒ 残差 ≈ 0；关掉 `bell_beating` 必须变红）；
	#     ③ 验收件落盘非空（与 ⑭/㉟ 同一条理由：写失败会让「没验」看起来像「验过了」）。
	var bad44: Array[String] = []
	var spec44: Dictionary = INSTRUMENTS.get("bianzhong", {})
	var parts44: Array = spec44.get("partials", [])
	var side44 := 0.0
	var oct44 := 0.0
	for p in parts44:
		var pa: Array = p
		if pa.size() < 2:
			continue
		var ratio := float(pa[0])
		if absf(ratio - 1.189) < 0.02:
			side44 = float(pa[1])
		if absf(ratio - 2.02) < 0.05:
			oct44 = float(pa[1])
	if side44 <= 0.0:
		bad44.append("钟谱里没有侧鼓音（1.189×）⇒ 不是一钟双音，听感退化成金属块")
	if oct44 >= side44:
		bad44.append("八度分音 %.2f 不弱于侧鼓音 %.2f ⇒ 合瓦形的压制没做（会听成管钟/风铃）"
			% [oct44, side44])
	# 拍频：同一口钟，开/关两版必须**不同**，且开的版本包络要有涨落。
	var sr44 := maxi(sample_rate, 8000)
	var keep_beat44 := bell_beating
	var midi44 := 62                    # D4：cue 里最常用的钟音区
	bell_beating = 0.0
	var pcm_flat44 := instr_pcm(midi44, "pad", "bianzhong")
	bell_beating = 1.0
	var pcm_beat44 := instr_pcm(midi44, "pad", "bianzhong")
	bell_beating = keep_beat44
	# 窗口落在**基音主导**的段（1.2~2.6s）：这时只剩基音的两条谐振器，
	# 纯指数衰减的 log 包络是完美直线 ⇒ 残差几乎为零；有拍频则明显起伏。
	var wob44 := _env_wobble_db(pcm_beat44, sr44, 1.2, 2.6, 0.040)
	var wob_flat44 := _env_wobble_db(pcm_flat44, sr44, 1.2, 2.6, 0.040)
	if wob44 < 0.5:
		bad44.append("拍频没响：包络残差 %.2fdB < 0.5dB（钟退化成干正弦叠加）" % wob44)
	if absf(wob44 - wob_flat44) < 0.3:
		bad44.append("开/关拍频的包络涨落几乎相同（%.2f vs %.2fdB）⇒ 这个旋钮没接上"
			% [wob44, wob_flat44])
	var bs_path := _arg_value("--bellscale=")
	var bs_sz := 0
	if bs_path != "":
		DirAccess.remove_absolute(bs_path)
		var bs_pcm := render_bell_scale()
		var bs_ok := save_wav(bs_path, bs_pcm)
		bs_sz = _file_size(bs_path)
		if not bs_ok or bs_sz < 44 + bs_pcm.size() * 2:
			bad44.append("音阶验收件写失败（%d 字节）" % bs_sz)
		print("[Music] 编钟音阶验收件：%s（%d 字节）" % [bs_path, bs_sz])
	else:
		print("[Music] 未请求 --bellscale=<路径>（跳过音阶验收件落盘）")
	checks.append(["㊹ 编钟谱与拍频｜合瓦形双音钟的三个结构性特征必须都在：侧鼓音(1.189×)存在且**强于**八度分音(2.02×) · 基音主导段 log 包络残差 ≥0.5dB(拍频真在响)· 关掉 `bell_beating` 必须变红 · 音阶验收件非空",
		bad44.is_empty(),
		"侧鼓 %.2f vs 八度 %.2f · 拍频涨落 %.2fdB（关闸 %.2fdB）· 音阶件 %d 字节 · %s" % [
			side44, oct44, wob44, wob_flat44, bs_sz,
			"全部通过" if bad44.is_empty() else str(bad44)]])

	# ㊺ 钟的**小旋律**与**拍速**（2026-11-03 用户："编成几个音的小旋律，把它的拍速设成
	#   基准古筝的二倍"）。为什么这条必须存在：`stagger_scale = 0`（生产默认）时，
#   `_cue_events()` 对**每个 seg 只发落点音** —— 那是给古筝的摇指/刮奏定的闸门，
#   而角色段是一串独立的"点"，多音结构被压成一个音 ⇒ 每个时刻只响一声。
	#   于是"特殊时刻只剩一声"这件事**没有任何数在盯**，只能靠耳朵发现。
	#   现在钉三面：① 每个时刻 ≥2 个钟音；② 这些音的 `at` 必须**互不相同且递增**
	#   （相等 = 音簇，听感上仍是一声）；③ 拍速/音量两个旋钮必须真的接上
	#   （拧了没反应是最典型的静默缺陷，同 `_timbre_fp()` 那几句）。
	var bad45: Array[String] = []
	var ins_keep45 := instrument_id
	var ss_keep45 := stagger_scale
	var be_keep45 := cue_bell_enabled
	var bi_keep45 := cue_bell_instrument
	var br_keep45 := cue_bell_rate
	var bg_keep45 := cue_bell_gain
	instrument_id = ""
	stagger_scale = 0.0                # ★ 生产默认：闸门关着，钟仍必须是多音
	cue_bell_enabled = true
	cue_bell_instrument = "yangqin"
	cue_bell_rate = 2.0
	cue_bell_gain = 1.0
	var cnt45: Array[int] = []
	var neg45 := 0
	for cq45 in CUE_IDS:
		var l45: Array[float] = []
		for e45 in _cue_events(str(cq45)):
			if str(e45.get("instr", "")) == "yangqin":
				l45.append(float(e45.get("at", 0.0)))
		cnt45.append(l45.size())
		if l45.size() < 2:
			bad45.append("「%s」只有 %d 个钟音（要求 ≥2 = 小旋律；被闸门压成一声正是不突出的根源）"
				% [str(cq45), l45.size()])
		for i45 in range(1, l45.size()):
			if l45[i45] <= l45[i45 - 1] + 0.001:
				bad45.append("「%s」的钟音没拉开间距（at 未递增 ⇒ 听成音簇，仍是一声）" % str(cq45))
				break
	# ★★ 11-05 第十二轮：角色段从「4.8s 长音叠成一团」改回**短点状旋律**后，
	#   光验"有几个音、at 递增"不够 —— 那三面在旧表（pad + 等距 steps + 撞同度）下也全绿。
	#   补三面，各自对着一种具体的坏法（§127 正负成对）：
	#     ① kind 必须是 `orn`（0.72s）：退回 `pad` ⇒ 3~4 个 4.8s 长音叠着响 = 糊 + 盖过主旋律；
	#     ② steps 不许等距平铺：等距 = 没有句法，像一串节拍器，不是"小旋律"；
	#     ③ 角色段**末音**不许与同段主旋律落点音同度：同度叠加既糊又凭空抬 3dB。
	#   ★ 全部读 `_cue_events()` 的**真实事件**（不自己解析曲风表、不重算落点，§70）。
	var mel_bad45: Array[String] = []
	var mel_gaps45: Array[String] = []
	for cq45m in CUE_IDS:
		var b_ats45: Array[float] = []
		var b_midis45: Array[int] = []
		var m_midis45: Array[int] = []
		var b_kinds45: Array[String] = []
		for e45m in _cue_events(str(cq45m)):
			if str(e45m.get("instr", "")) != "":
				b_ats45.append(float(e45m.get("at", 0.0)))
				b_midis45.append(int(e45m["midi"]))
				b_kinds45.append(str(e45m["kind"]))
			else:
				m_midis45.append(int(e45m["midi"]))
		for kd45 in b_kinds45:
			if kd45 != "orn":
				mel_bad45.append("「%s」角色段退回 %s 长音（应恒为 orn）" % [str(cq45m), kd45])
				break
		if b_ats45.size() >= 3:
			var g0_45 := b_ats45[1] - b_ats45[0]
			var varied45 := false
			for j45 in range(2, b_ats45.size()):
				if absf((b_ats45[j45] - b_ats45[j45 - 1]) - g0_45) > 0.001:
					varied45 = true
					break
			if not varied45:
				mel_bad45.append("「%s」steps 等距平铺（没有句法）" % str(cq45m))
			mel_gaps45.append("%s:%.2f" % [str(cq45m), g0_45])
		if not b_midis45.is_empty() and m_midis45.has(b_midis45.back()):
			mel_bad45.append("「%s」角色段末音 %d 与同段主旋律落点音同度"
				% [str(cq45m), b_midis45.back()])
	bad45.append_array(mel_bad45)
	# 拍速：rate 2.0 的时间跨度必须正好是 rate 1.0 的一半（同一份 `steps`）。
	cue_bell_rate = 1.0
	var span1_45 := 0.0
	for e45b in _cue_events("end"):
		if str(e45b.get("instr", "")) == "yangqin":
			span1_45 = maxf(span1_45, float(e45b.get("at", 0.0)))
	cue_bell_rate = 2.0
	var span2_45 := 0.0
	for e45c in _cue_events("end"):
		if str(e45c.get("instr", "")) == "yangqin":
			span2_45 = maxf(span2_45, float(e45c.get("at", 0.0)))
	if span1_45 <= 0.0 or absf(span2_45 * 2.0 - span1_45) > span1_45 * 0.02:
		bad45.append("拍速没接上：倍速 1.0 跨度 %.3fs、2.0 跨度 %.3fs（应约一半）"
			% [span1_45, span2_45])
	# 音量：同一时刻的钟音 gain 比必须等于旋钮比。
	cue_bell_gain = 1.0
	var g1_45 := 0.0
	for e45d in _cue_events("end"):
		if str(e45d.get("instr", "")) == "yangqin":
			g1_45 = float(e45d.get("gain", 0.0))
			break
	cue_bell_gain = 1.7
	var g2_45 := 0.0
	for e45e in _cue_events("end"):
		if str(e45e.get("instr", "")) == "yangqin":
			g2_45 = float(e45e.get("gain", 0.0))
			break
	if g1_45 <= 0.0 or absf(g2_45 / g1_45 - 1.7) > 0.02:
		bad45.append("音量旋钮没接上：1.0 → %.3f、1.7 → %.3f（比值 %.2f）"
			% [g1_45, g2_45, g2_45 / maxf(g1_45, 1e-9)])
	# ★ 最后一面（11-05 第十二轮**反转**）：角色段最终增益必须**低于**同段主旋律。
	#   ★★ 为什么不能量 `instr_pcm()` 的峰值：那是**乐器本身**的 gain，跟"这一声在曲子里
	#     多响"无关 —— 真正的响度是 `段 gain × cue_bell_gain × cue_gain`（§110）。
	## ★ 自带口径 `cue_bell_gain = 1.0`（出厂默认），不读进来时的值：
	##   `--cuebellgain=1.7` 是合法 A/B 档，不该把自检弄红（§136）。
	## ★ 双面：低于主旋律 **且** ≥ 30% ⇒ 只写"不许盖过"的话，把 cue 静音也能混过判据
	##   （§127 正负成对 / §106 有效分母 0 要报红）。
	cue_bell_gain = 1.0
	var bell_g45 := 0.0
	for e45f in _cue_events("end"):
		if str(e45f.get("instr", "")) != "":
			bell_g45 = maxf(bell_g45, float(e45f.get("gain", 0.0)))
	var main_g45 := 0.0
	for e45g in _cue_events("end"):
		if str(e45g.get("instr", "")) == "":
			main_g45 = maxf(main_g45, float(e45g.get("gain", 0.0)))
	var ratio45 := bell_g45 / maxf(main_g45, 1e-9)
	if ratio45 >= 1.0:
		bad45.append("角色段盖过主旋律（%.3f ≥ %.3f，比值 %.2f）"
			% [bell_g45, main_g45, ratio45])
	if ratio45 < 0.30:
		bad45.append("角色段轻到听不见（比值 %.2f < 0.30，静音不许混过）" % ratio45)
	instrument_id = ins_keep45
	stagger_scale = ss_keep45
	cue_bell_enabled = be_keep45
	cue_bell_instrument = bi_keep45
	cue_bell_rate = br_keep45
	cue_bell_gain = bg_keep45
	checks.append(["㊺ 特殊时刻小旋律｜%d 个时刻每个必须 ≥2 个角色音(`stagger_scale=0` 时也不许压成一声)· at 必须递增 · `cue_bell_rate` 2.0 的跨度正好是 1.0 的一半 · `cue_bell_gain` 必须真的接上 · **角色段恒为 orn 短点(不许退回 pad 长音)· steps 不等距有句法 · 末音不与主段落点音同度** · **最终增益比值落在 0.30~1.00(不许盖过、也不许静音混过)**"
			% CUE_IDS.size(),
