	var oct_target44 := -1 if bo_keep44 != -1 else -2
	var oct_delta44 := 12 * (oct_target44 - bo_keep44)
	bass_octave = oct_target44
	var m44_new := -999
	for e44q in _schedule_step(k44p, ax44):
		if str(e44q["kind"]) == "bass":
			m44_new = int(e44q["midi"])
	bass_octave = bo_keep44
	if m44_new != m44_def + oct_delta44:
		bad46.append("bass_octave 没接上（%d→%d，期望 %+d）" % [m44_def, m44_new, oct_delta44])
	# step：挪一格后，旧位必须空、新位必须恰好一个。
	var n_old44 := -1
	var n_new44 := -1
	var new_pos44 := old_pos44 + 1
	if new_pos44 > spb44 - 1:
		bad46.append("小节只有 %d 步，bass_step 挪不动（分母 0）" % spb44)
	else:
		bass_step = new_pos44
		n_old44 = 0
		n_new44 = 0
		for e44r in _schedule_step(spb44 + old_pos44, ax44):
			if str(e44r["kind"]) == "bass":
				n_old44 += 1
		for e44t in _schedule_step(spb44 + new_pos44, ax44):
			if str(e44t["kind"]) == "bass":
				n_new44 += 1
		bass_step = bst_keep44
		if n_old44 != 0 or n_new44 != 1:
			bad46.append("bass_step 没接上（旧位 %d / 新位 %d）" % [n_old44, n_new44])
