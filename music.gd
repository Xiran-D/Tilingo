	instrument_id = ins_keep43
	cue_bell_enabled = be_keep43
	cue_bell_instrument = bi_keep43
	cue_bell_gain = bg_keep43
	stagger_scale = ss_keep43
	_wav_cache.clear()
	_cache_fp = ""
	checks.append(["㊸ 特殊时刻音效层｜只作特殊时刻音效、不进常规织体：全部 %d 个时刻各一声 · 常规 4 小节×两档**零**角色事件 · 关闸后角色段归零而主乐器乐句逐字不变 · 异色乐器与古筝取到的流必须不同(缓存键含乐器)· 起播预热必须真的把角色段放进缓存 · 空/非法 id 不许退回主乐器 · **出货默认同宗音色，不引入第二件乐器**"
