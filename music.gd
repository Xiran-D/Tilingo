	#     ⑤ cue 乐句取代后低音床仍在（与 ㉚「把伴奏床排除」互补，两头才夹得住）
	#     ⑥ `bass` 与 `note` 分族：低音不吃「韵」，也不与旋律撞缓存键。
	#   ★★ ⑥ 自带**阳性对照**：`note` 那一档必须真的被韵改过波形，否则「bass 没被改」
	#     是一条恒真式（§138「无输出」型判据的对照组）。为让对照与 CLI 无关，六个韵参数
	#     在这里逐项临时钉住、量完还原（§119：配对参照物须对被测参数不动）。
	var be_keep44 := bass_enabled
	var bo_keep44 := bass_octave
	var bst_keep44 := bass_step
	var bg_keep44 := bass_gain
	var y_keep44 := yun_enabled
	var yr_keep44 := yun_ratio
	var ys_keep44 := yun_slide
	var yv_keep44 := yun_vibrato
	var spb44 := _steps_per_bar()
	var ax44 := axes_from_tension(0.5)
	var gs44 := maxf(_fnum(ax44.get("gain_scale", 1.0), 1.0), 0.0)
	var bad46: Array[String] = []
	var old_pos44 := clampi(bst_keep44, 0, spb44 - 1)
	# ① 开档 / 关档：逐字比较"非 bass 事件"。★ 不用"关档结果"当唯一参照物（§110），
	#   而是拿开档滤掉 bass 后的事件集与它逐字对拍 ⇒ 关闸顺手动了别的事件也会红。
	bass_enabled = true
	var on_other44: Array[String] = []
	var on_n44 := 0
	for k44a in range(0, 4 * spb44):
		for e44a in _schedule_step(k44a, ax44):
			if str(e44a["kind"]) == "bass":
				on_n44 += 1
			else:
				on_other44.append(str(e44a))
	bass_enabled = false
	var off_other44: Array[String] = []
	var off_n44 := 0
	for k44b in range(0, 4 * spb44):
		for e44b in _schedule_step(k44b, ax44):
