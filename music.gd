				roots44.append(root44)
				if absf(float(e44s["gain"]) - bg_keep44 * gs44) > 1e-6:
					bad46.append("gain 没接上 gain_scale")
				if absf(float(e44s.get("at", 0.0))) > 1e-9:
					bad46.append("低音带 at 错开（会变琶音）")
			if n_b44 != 1:
				bad46.append("hue%.1f 第%d小节低音 %d 个（应 1）" % [float(hue44), b44x, n_b44])
	var uniq44 := {}
	for r44 in roots44:
		uniq44[r44] = true
	if n_pair44 < 8:
		bad46.append("低音配对样本只有 %d 个（分母 0）" % n_pair44)
	if uniq44.size() < 2:
		bad46.append("8 个样本里根音只有 %d 种 ⇒ 判不出「跟着和声走」" % uniq44.size())
	# ④ 三个旋钮各自有牙：同一步号、只动一个旋钮。
	var k44p := spb44 + old_pos44
	var m44_def := -999
	var g44_old := -1.0
	for e44p in _schedule_step(k44p, ax44):
		if str(e44p["kind"]) == "bass":
			m44_def = int(e44p["midi"])
			g44_old = float(e44p["gain"])
	if m44_def < -100 or g44_old <= 0.0:
		bad46.append("探针步 %d 没有低音（分母 0）" % k44p)
