	#   交叉相乘避免 `bass_gain = 0` 时除零，并要求两档真的不同。
	var gain_target44 := 0.4 if bg_keep44 < 0.3 else 0.1
	bass_gain = gain_target44
	var g44_new := -1.0
	for e44u in _schedule_step(k44p, ax44):
		if str(e44u["kind"]) == "bass":
			g44_new = float(e44u["gain"])
	bass_gain = bg_keep44
	if g44_new <= 0.0 or absf(g44_new * bg_keep44 - g44_old * gain_target44) > 1e-6 \
			or absf(g44_new - g44_old) < 1e-6:
