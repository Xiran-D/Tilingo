		if str(e43b.get("instr", "")) != "":
			n_bell_on43 += 1
		else:
			main_on43.append(str(e43b))
	cue_bell_enabled = false
	var main_off43: Array[String] = []
	for e43c in _cue_events("end"):
		if str(e43c.get("instr", "")) != "":
