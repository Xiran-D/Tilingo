{
  "version": 2,
  "note": "统一台词库（2026-11-02 v2）。所有对战 AI 共用这一份，不按 ai_engine / liushui / yema 分开。两类用途：① pool 里的 brilliant_* = AI **主动**开口（只在出现妙手时）；② chat_* = 玩家说话后的**回话**（由 chat_rules 关键词命中）。槽位：{diff}=目数差整数，{n}=提子数。改文案只改这里，不动代码。",
  "cooldown_moves": 3,
  "life_sec": 4.0,
  "brilliant_delta": 8.0,
  "reply_gap_ms": 400,
  "typing": {
    "note": "打字停顿（2026-11-03）：回话不是立刻蹦出来，而是按字数模拟真人敲键盘。三段相加 = pad_ms（看到消息的反应时间，与字数无关）+ per_char_ms × 字数 + punct_ms × 标点数，再夹到 max_ms 以内。改这里就能整体调快/调慢，不用动代码。",
    "pad_ms": 700,
    "per_char_ms": 105,
    "punct_ms": 180,
    "max_ms": 4200
  },
  "reply_rate": {
    "default": 0.75,
    "chat_question": 0.9,
    "chat_other": 0.45
  },
  "chat_rules": [
    { "intent": "chat_resign", "words": ["认输", "投了", "不下了", "放弃", "认负", "我输了"] },
    { "intent": "chat_again", "words": ["再来", "再下", "继续", "下一局", "重来", "重开"] },
    { "intent": "chat_thanks", "words": ["谢谢", "承让", "受教", "多谢", "感谢"] },
    { "intent": "chat_praise", "words": ["厉害", "好棋", "妙", "强", "牛", "666", "漂亮", "了不起", "高手"] },
    { "intent": "chat_greet", "words": ["你好", "您好", "在吗", "开始", "指教"] },
    { "intent": "chat_self_deprecate", "words": ["我菜", "太烂", "没救", "不行了", "下不过"] },
    { "intent": "chat_question", "words": ["怎么", "为什么", "为何", "是不是", "吗", "呢", "？", "?"] }
  ],
  "pool": {
    "brilliant_opp": [
      "这一手好。",
      "妙，我没算到。",
      "这手棋很硬。",
      "不错，我得重新想想。",
      "好手，这地方我漏了。",
      "这一手值 {delta} 目。",
      "这一下真漂亮。"
    ],
    "brilliant_self": [
      "这手我算清了。",
      "这一步，我等了很久。",
      "关键点在我手里了。",
      "这一下挣了 {delta} 目。",
      "成了。",
      "正好落在我想要的地方。"
    ],
    "chat_greet": [
      "你好，手谈一局。",
      "随时开始。",
      "指教不敢当，尽力下。",
      "在的，请。"
    ],
    "chat_praise": [
      "过奖了。",
      "这手确实关键。",
      "你也下得不错。",
      "运气好而已。",
      "客气，还早。"
    ],
    "chat_self_deprecate": [
      "别急，还早。",
      "我这盘也不轻松。",
      "下棋总有失手。",
      "不到最后说不准。"
    ],
    "chat_resign": [
      "那我就不客气了。",
      "这一局承让。",
      "棋是下不完的，下次再来。",
      "好，我记下了。"
    ],
    "chat_again": [
      "随时可以再来一局。",
      "行，重开吧。",
      "再来，这次我会更谨慎。",
      "好，看看这次如何。"
    ],
    "chat_thanks": [
      "客气。",
      "互相学习。",
      "你的手筋也不少。",
      "谢了。"
    ],
    "chat_question": [
      "我算的是实地。",
      "这手我看重的是外势。",
      "不好说，还得看后面。",
      "我也在想这地方。",
      "这要看你怎么应。",
      "按我的算法，这里还早。"
    ],
    "chat_other": [
      "嗯。",
      "看看再说。",
      "继续吧。",
      "我在算。",
      "……"
    ]
  }
}
